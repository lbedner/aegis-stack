"""{% if include_auth %}The signed-in person's{% else %}The operator's{% endif %} MCP tokens: list them, make one (its value shown
in this one answer), revoke one. The rules are ``app.components.mcp.tokens``'s;
these routes only say whose tokens they are{% if not include_auth %}: with no one to sign in, an
operator's, made and revoked only where ``operator_refusal`` allows a change{% endif %}."""

from fastapi import APIRouter, Depends, HTTPException, Response, status
from sqlmodel.ext.asyncio.session import AsyncSession

from app.components.mcp import tokens
from app.components.mcp.models.tokens import (
    McpTokenCreate,
    McpTokenCreated,
    McpTokenResponse,
)
from app.core.db import get_async_db
from app.services.shared.deps import {% if include_auth %}get_owner_user_id{% else %}Actor, get_admin_actor, get_owner_user_id{% endif %}

router = APIRouter(prefix="/mcp/tokens", tags=["mcp"])
{%- if include_auth %}
holder = get_owner_user_id
{%- else %}


async def holder(actor: Actor = Depends(get_admin_actor)) -> int | None:
    """Whose tokens: the operator's (None), where they may be changed."""
    return actor.id
{%- endif %}


@router.get("", response_model=list[McpTokenResponse])
async def list_tokens(
    user_id: int | None = Depends(get_owner_user_id),
    db: AsyncSession = Depends(get_async_db),
) -> list[McpTokenResponse]:
    """The live tokens, newest first; never their values."""
    rows = await tokens.live(db, user_id)
    return [McpTokenResponse.model_validate(row, from_attributes=True) for row in rows]


@router.post("", response_model=McpTokenCreated, status_code=status.HTTP_201_CREATED)
async def create_token(
    body: McpTokenCreate,
    user_id: int | None = Depends(holder),
    db: AsyncSession = Depends(get_async_db),
) -> McpTokenCreated:
    """Make a token. Its value is in this answer and nowhere else."""
    row, value = await tokens.create(db, user_id, body.name, body.scope)
    shown = McpTokenResponse.model_validate(row, from_attributes=True)
    return McpTokenCreated(**shown.model_dump(), token=value)


@router.delete("/{token_id}", status_code=status.HTTP_204_NO_CONTENT)
async def revoke_token(
    token_id: int,
    user_id: int | None = Depends(holder),
    db: AsyncSession = Depends(get_async_db),
) -> Response:
    """Revoke a token: it fails on its next use."""
    if not await tokens.revoke(db, token_id, user_id):
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return Response(status_code=status.HTTP_204_NO_CONTENT)
