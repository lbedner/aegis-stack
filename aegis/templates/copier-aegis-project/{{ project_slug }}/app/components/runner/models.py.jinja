"""The runs asked of a coding agent, and the tokens runners claim them
with (``runs``, ``tokens``)."""

from datetime import datetime

from sqlalchemy import Index, Text
from sqlmodel import Field, SQLModel

from app.core.time import utcnow

# Where a run stands: asked, claimed by what runs it, then done or failed.
ASKED, CLAIMED, DONE, FAILED = "asked", "claimed", "done", "failed"
# A run not back yet: asked, or claimed by what runs it.
GOING = (ASKED, CLAIMED)

# An owner column references ``user.id`` only when the stack has auth (a
# deleted user takes their runs and tokens with them); without it the owner
# is a plain nullable integer, NULL on every row.
_OWNER_FK: str | None = {% if include_auth %}"user.id"{% else %}None{% endif %}


class RunnerRun(SQLModel, table=True):
    """One action asked about a subject (a kind and an id, its asker's:
    a meeting's moment): asked, claimed by what runs it (a runner on
    another machine, or its asker in the app), then done or failed with
    what it came back with."""

    __tablename__ = "runner_run"
    __table_args__ = (Index("ix_runner_run_subject", "subject_kind", "subject_id"),)

    id: int | None = Field(default=None, primary_key=True)
    owner_user_id: int | None = Field(
        default=None, foreign_key=_OWNER_FK, ondelete="CASCADE", index=True
    )
    subject_kind: str = Field(max_length=32)
    subject_id: str = Field(max_length=255)
    action: str = Field(max_length=64)
    prompt: str = Field(sa_type=Text)
    status: str = Field(default=ASKED, max_length=16, index=True)
    result: str | None = Field(default=None, sa_type=Text)
    runner: str | None = Field(default=None, max_length=255)
    asked_at: datetime = Field(default_factory=utcnow)
    claimed_at: datetime | None = None
    finished_at: datetime | None = None


class RunnerToken(SQLModel, table=True):
    """What a runner on another machine shows to claim an owner's runs and
    post their results. Only its digest is kept; the value is shown once."""

    __tablename__ = "runner_token"

    id: int | None = Field(default=None, primary_key=True)
    owner_user_id: int | None = Field(
        default=None, foreign_key=_OWNER_FK, ondelete="CASCADE", index=True
    )
    name: str = Field(max_length=255)
    digest: str = Field(max_length=64, unique=True)
    hint: str = Field(max_length=16)
    created_at: datetime = Field(default_factory=utcnow)
    last_used_at: datetime | None = None
    revoked_at: datetime | None = None
