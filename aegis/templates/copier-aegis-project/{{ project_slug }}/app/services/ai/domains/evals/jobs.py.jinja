"""A dataset run and kept, as one call: the CLI's, and a job's on the worker
(or in this process, without one). Each opens the session the run is kept
in once the scoring, minutes of model calls, is over. A dataset written by
the model (``generate_evals``) is run here too, so nothing it keeps fails."""

from typing import Any

from app.core.config import settings
from app.core.db import get_async_session
from app.core.time import utcnow
from app.services.ai.domains.llm import active_model
from app.services.ai.domains.llm.llm_service import check_model
from app.services.ai.models.evals import EvalRun
from app.services.system import job_store
from app.services.system.jobs import Report

from .datasets import add, names, summaries, text, texts, unknown
from .generator import (
    CASES,
    Dropped,
    Generated,
    check_new,
    held,
    keep,
    write_cases,
    written,
)
from .recorder import record_run
from .runner import run_dataset
from .script import Step

# A run's job is named this and its dataset's name.
JOB_PREFIX = "ai-evals:"
# A dataset being written is a job named this and the dataset's name.
WRITING_PREFIX = f"{JOB_PREFIX}new:"
# What a written dataset's runs say of themselves.
WRITTEN = "written by generate"


async def _provider_for(model: str | None) -> str | None:
    """The provider ``model`` answers on (``check_model``); a model that
    cannot answer chat here is refused with why."""
    if model is None:
        return None
    async with get_async_session() as session:
        checked = await check_model(session, model)
    if not checked.success:
        raise ValueError(checked.message)
    return checked.provider


async def _text(name: str) -> str:
    """Dataset ``name``'s YAML (``UnknownDatasetError`` for none), in a
    session of its own."""
    async with get_async_session() as session:
        return await text(session, name)


async def run_evals(
    name: str,
    *,
    scripted: bool = False,
    model: str | None = None,
    note: str | None = None,
    trigger: str = "cli",
    report: Report | None = None,
    written: str | None = None,
) -> EvalRun:
    """Score dataset ``name`` (``run_dataset``; as kept, or as ``written``)
    on the model picked in the Overseer, or ``model``, then keep the run;
    its conversations go with the keeping."""
    if written is None:
        written = await _text(name)
    # Headless: the selection is a row only the webserver re-reads per request.
    await active_model.sync_from_db(settings)
    provider = await _provider_for(model)
    started_at = utcnow()
    scored = await run_dataset(
        name, written, scripted=scripted, model=model, provider=provider, report=report
    )
    async with get_async_session() as session:
        return await record_run(
            session, scored, started_at=started_at, keep=False, trigger=trigger, note=note
        )


async def _job_result(
    name: str, model: str | None, note: str | None, report: Report
) -> dict[str, Any]:
    """A run started as a job, and what its result says of it."""
    run = await run_evals(name, model=model, note=note, trigger="api", report=report)
    return {"run_id": run.id, "dataset": run.dataset, "cases": run.cases, "passed": run.passed}


async def start_evals(name: str, *, model: str | None, note: str | None) -> str:
    """Start the run as a job; no such dataset (``UnknownDatasetError``) or
    a model that cannot answer is refused here, not on the worker."""
    async with get_async_session() as session:
        if name not in await names(session):
            raise unknown(name)
    await _provider_for(model)
    return await job_store.start_job(
        f"{JOB_PREFIX}{name}",
        "run_evals_task",
        (name, model, note),
        lambda report: _job_result(name, model, note, report),
    )


async def _held(run_id: int) -> tuple[dict[str, list[Step]], list[Dropped]]:
    """``held`` of a kept run, in a session of its own."""
    async with get_async_session() as session:
        return await held(session, run_id)


async def generate_evals(
    name: str,
    *,
    about: str,
    cases: int = CASES,
    like: str | None = None,
    report: Report | None = None,
) -> Generated:
    """Write dataset ``name``: the model in force writes the cases
    (``write_cases``), each runs once on it, those that held are kept with
    the scripts their turns took, and the scripts are played as CI plays
    them (``make evals-ci``), keeping those that pass. All of it on a draft:
    the dataset is kept only once nothing in it fails, and only if its name
    is still free. ValueError (``check_new``) before any model is called,
    and when no case holds."""
    async with get_async_session() as session:
        kept = await texts(session)
    check_new(kept, name, about, cases, like)
    say = report or (lambda _label: None)
    say("Writing cases...")
    like_text = None if like is None else kept[like]
    dataset, dropped = await write_cases(about, cases, like_text, summaries(kept))
    real = await run_evals(
        name,
        trigger="generate",
        note=WRITTEN,
        report=report,
        written=written(dataset, about),
    )
    scripts, failed = await _held(real.id)
    dropped += failed
    keep(dataset, scripts, dropped)
    say("Playing the scripts...")
    final = written(dataset, about)
    played = await run_evals(name, scripted=True, trigger="ci", note=WRITTEN, written=final)
    if played.failed:
        playable, unplayable = await _held(played.id)
        dropped += unplayable
        keep(dataset, {n: scripts[n] for n in playable}, dropped)
        final = written(dataset, about)
    async with get_async_session() as session:
        await add(session, name, final)
    return Generated(kept=len(dataset.cases), dropped=dropped, run_id=real.id)


async def _generated_result(
    name: str, about: str, cases: int, like: str | None, report: Report
) -> dict[str, Any]:
    """A dataset written as a job, and what its result says of it: the
    cases kept of those written, and the run that decided."""
    made = await generate_evals(name, about=about, cases=cases, like=like, report=report)
    return {"run_id": made.run_id, "dataset": name, "kept": made.kept, "written": made.written}


async def start_generate_evals(
    name: str, *, about: str, cases: int = CASES, like: str | None = None
) -> str:
    """Write the dataset as a job (``generate_evals``); what ``check_new``
    refuses is refused here, not on the worker."""
    async with get_async_session() as session:
        check_new(await names(session), name, about, cases, like)
    return await job_store.start_job(
        f"{WRITING_PREFIX}{name}",
        "generate_evals_task",
        (name, about, cases, like),
        lambda report: _generated_result(name, about, cases, like, report),
    )
{%- if include_worker %}


async def run_evals_job(
    job_id: str, name: str, model: str | None, note: str | None
) -> dict[str, Any]:
    """The worker's entry."""
    return await job_store.narrate(
        job_id, lambda report: _job_result(name, model, note, report)
    )


async def generate_evals_job(
    job_id: str, name: str, about: str, cases: int, like: str | None
) -> dict[str, Any]:
    """The worker's entry for a dataset written by the model."""
    return await job_store.narrate(
        job_id, lambda report: _generated_result(name, about, cases, like, report)
    )
