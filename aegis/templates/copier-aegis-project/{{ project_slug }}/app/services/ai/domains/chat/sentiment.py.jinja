"""Conversation sentiment scoring.

Scores persisted conversations with the configured LLM and writes one
``sentiment_analysis`` row per conversation. Score-once is structural
(unique ``conversation_id``): only conversations without a verdict are
picked, so re-runs never re-score. A conversation that fails to score is
logged and simply picked up by a later run.

The hourly job hands every unscored conversation to the worker, a task
each (``queue_unscored``), so they score as fast as the system queue runs
them; no batch, no backlog.

Present but OFF by default: the scheduled job checks
``settings.AI_SENTIMENT_ENABLED`` and returns early when disabled,
because every scored conversation costs model tokens.
"""

from datetime import datetime
import json
from typing import Any

from pydantic import BaseModel
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core.config import settings
from app.core.db import release_lock
from app.core.discovery import present
from app.core.figures import FIGURES
from app.core.log import logger
from app.models.conversation import Conversation
from app.services.ai.domains.chat import queries
from app.services.ai.domains.llm.config import AIServiceConfig
from app.services.ai.models.sentiment import (
    PERFORMANCE_VALUES,
    SENTIMENT_VALUES,
    SentimentAnalysis,
)

SENTIMENT_SYSTEM_PROMPT = (
    "You are a conversation quality analyst. Given a transcript between "
    "a user and an AI assistant, return ONLY a JSON object with exactly "
    "these keys:\n"
    '- "overall_sentiment": one of "positive", "neutral", "negative", '
    '"frustrated" (the USER\'s sentiment)\n'
    '- "overall_score": a number from -1.0 (very negative) to 1.0 (very '
    "positive)\n"
    '- "assistant_performance": one of "good", "acceptable", "poor"\n'
    '- "issues": a list of short strings naming problems, empty if none\n'
    '- "summary": one sentence describing the conversation\n'
    "No prose, no code fences, JSON only."
)

TRANSCRIPT_MESSAGE_LIMIT = 40
# The agent the scorer runs as: its model, sampling and prompt are picked
# in Agents (seeded with the prompt above, on the active model).
SENTIMENT_AGENT_SLUG = "sentiment"
# A verdict is a short JSON object, read the same way each time.
SENTIMENT_TEMPERATURE = 0.0
SENTIMENT_MAX_TOKENS = 600
# Scoring runs on the worker, a task a conversation; a stack without one
# scores them in the job itself.
QUEUED = present("app.components.worker")
# A conversation stays claimed for under the job's hour: one still waiting
# in the queue is not queued twice, one whose task failed is queued again.
_CLAIM_SECONDS = 50 * 60


def _build_transcript(conversation: Conversation) -> str | None:
    messages = getattr(conversation, "messages", None) or []
    lines = [
        f"{message.role}: {message.content}"
        for message in messages[:TRANSCRIPT_MESSAGE_LIMIT]
        if message.content
    ]
    if not lines:
        return None
    return "\n".join(lines)


def _extract_json(text: str) -> dict[str, Any]:
    """Parse the model reply, tolerating prose or fences around the JSON."""
    start = text.find("{")
    end = text.rfind("}")
    if start == -1 or end <= start:
        raise ValueError("no JSON object in model reply")
    payload = json.loads(text[start : end + 1])
    if not isinstance(payload, dict):
        raise ValueError("model reply is not a JSON object")
    return payload


def _validate_verdict(payload: dict[str, Any]) -> dict[str, Any]:
    sentiment = payload.get("overall_sentiment")
    if sentiment not in SENTIMENT_VALUES:
        raise ValueError(f"invalid overall_sentiment: {sentiment!r}")
    performance = payload.get("assistant_performance")
    if performance not in PERFORMANCE_VALUES:
        raise ValueError(f"invalid assistant_performance: {performance!r}")
    score = float(payload.get("overall_score", 0.0))
    score = max(-1.0, min(1.0, score))
    issues = payload.get("issues") or []
    if not isinstance(issues, list):
        issues = [str(issues)]
    return {
        "overall_sentiment": sentiment,
        "overall_score": score,
        "assistant_performance": performance,
        "issues": [str(issue) for issue in issues],
        "summary": str(payload.get("summary") or "") or None,
    }


# What a run scores with: the model's config, and the prompt.
Scorer = tuple[AIServiceConfig, str]


async def _scorer() -> Scorer:
    """The ``sentiment`` agent's model, sampling and prompt, or, while no
    such agent is active, the built-in prompt on the model in force.
    Resolved once a sweep, or once a task."""
    from app.services.ai.domains.llm import active_model

    return await active_model.agent_in_force(
        settings, SENTIMENT_AGENT_SLUG, SENTIMENT_SYSTEM_PROMPT
    )


async def _llm_score(transcript: str, config: AIServiceConfig, prompt: str) -> dict[str, Any]:
    """Ask ``config``'s model for a verdict; returns the raw parsed dict."""
{% if ai_framework == "pydantic-ai" %}
    from app.services.ai.domains.llm.providers import get_agent

    agent = await get_agent(config, settings, prompt)
    result = await agent.run(transcript)
    reply = result.output
{% else %}
    from app.services.ai.domains.llm.providers import get_llm

    llm = await get_llm(config, settings)
    result = await llm.ainvoke(
        [("system", prompt), ("human", transcript)]
    )
    reply = result.content if hasattr(result, "content") else str(result)
{% endif %}
    return _extract_json(str(reply))


async def _score_conversation(
    session: AsyncSession, conversation_id: str, transcript: str, scorer: Scorer
) -> None:
    """Score one conversation transcript and write its verdict row, with
    the model that scored it."""
    config, prompt = scorer
    verdict = _validate_verdict(await _llm_score(transcript, config, prompt))
    session.add(
        SentimentAnalysis(
            conversation_id=conversation_id,
            model_id=config.model,
            **verdict,
        )
    )
    await session.commit()


async def _scored(
    session: AsyncSession, conversation_id: str, transcript: str | None, scorer: Scorer
) -> str:
    """One conversation's verdict written: "scored"; "skipped" with nothing
    to read; "failed" (logged, rolled back) when the model or its answer
    would not do, left unscored for a later run."""
    if transcript is None:
        return "skipped"
    try:
        await _score_conversation(session, conversation_id, transcript, scorer)
    except Exception as exc:
        logger.error(
            "Sentiment scoring failed for conversation",
            conversation_id=conversation_id,
            error=str(exc),
        )
        await session.rollback()
        return "failed"
    return "scored"


async def score_unscored_conversations(*, session: AsyncSession) -> dict[str, int]:
    """Every unscored conversation scored here, one after another: the
    sweep where there is no worker to hand them to (``queue_unscored``).

    Read and transcribed BEFORE the first commit expires the loaded ORM
    instances (async sessions cannot lazy-load), and the transaction
    ended before any model call.
    """
    batch = [
        (conversation.id, _build_transcript(conversation))
        for conversation in await queries.unscored_conversations(session)
    ]
    await release_lock(session)  # each verdict then writes on its own
    counts = {"scored": 0, "skipped": 0, "failed": 0}
    if batch:
        scorer = await _scorer()
        for conversation_id, transcript in batch:
            counts[await _scored(session, conversation_id, transcript, scorer)] += 1
    logger.info("Sentiment: conversations scored", **counts)
    return counts


async def score_conversation(conversation_id: str, *, session: AsyncSession) -> str:
    """One queued conversation scored (``score_conversation_task``), as
    ``_scored`` says; "skipped" too once it has a verdict or is gone. The
    transaction ends before the model call."""
    conversation = await queries.unscored_conversation(session, conversation_id)
    transcript = _build_transcript(conversation) if conversation else None
    await release_lock(session)
    if transcript is None:
        return "skipped"
    return await _scored(session, conversation_id, transcript, await _scorer())


async def queue_unscored(*, session: AsyncSession) -> int:
    """Every unscored conversation handed to the worker, a task each
    (``score_conversation_task``): as many score at once as the system
    queue runs. Each is queued once while its task may still be waiting
    (``_CLAIM_SECONDS``); one that failed is queued again by a later run.
    Without a worker they are scored here (``score_unscored_conversations``).
    How many were queued, or scored."""
    if not QUEUED:
        return (await score_unscored_conversations(session=session))["scored"]
    from app.components.worker.queue_once import enqueue_once
    from app.core.constants import QueueName

    ids = await queries.unscored_conversation_ids(session)
    await release_lock(session)
    queued = 0
    for conversation_id in ids:
        queued += await enqueue_once(
            f"ai:sentiment:{conversation_id}",
            _CLAIM_SECONDS,
            "score_conversation_task",
            QueueName.SYSTEM,
            conversation_id,
        )
    logger.info("Sentiment: conversations queued", queued=queued)
    return queued


RECENT_NEGATIVE_LIMIT = 5


class SentimentMix(BaseModel):
    """Verdicts by the user's sentiment and the assistant's performance
    (every value, zero-filled), and their average score."""

    model_config = FIGURES

    by_sentiment: dict[str, int]
    by_performance: dict[str, int]
    average_score: float


class RecentNegative(BaseModel):
    """A conversation scored negative or frustrated, newest first."""

    model_config = FIGURES

    conversation_id: str
    overall_sentiment: str
    summary: str | None
    created_at: datetime


class SentimentStats(BaseModel):
    """Every verdict, zero-filled, for the CLI, the API and Overseer: the
    mix, whether the job scores, and the latest negatives."""

    model_config = FIGURES

    enabled: bool
    total: int
    distribution: dict[str, int]
    performance: dict[str, int]
    average_score: float
    recent_negatives: list[RecentNegative]


async def sentiment_mix(
    session: AsyncSession, since: datetime | None = None
) -> SentimentMix:
    """The verdicts scored since ``since`` (all of them when None), as
    figures: zero-filled, so a reader gets the same shape before any is
    scored."""
    by_sentiment = dict.fromkeys(SENTIMENT_VALUES, 0)
    by_sentiment.update(await queries.sentiment_counts(session, since))
    by_performance = dict.fromkeys(PERFORMANCE_VALUES, 0)
    by_performance.update(await queries.performance_counts(session, since))
    average = await queries.average_sentiment_score(session, since)
    return SentimentMix(
        by_sentiment=by_sentiment,
        by_performance=by_performance,
        average_score=round(float(average or 0.0), 3),
    )


async def sentiment_stats(*, session: AsyncSession) -> SentimentStats:
    """Aggregate sentiment results for CLI and dashboard surfaces.

    Returns zero-filled distributions so consumers can render a stable
    shape whether or not anything has been scored yet.
    """
    mix = await sentiment_mix(session)
    recent_negatives = [
        RecentNegative.model_validate(row, from_attributes=True)
        for row in await queries.recent_negative_sentiments(
            session, RECENT_NEGATIVE_LIMIT
        )
    ]
    return SentimentStats(
        enabled=settings.AI_SENTIMENT_ENABLED,
        total=sum(mix.by_sentiment.values()),
        distribution=mix.by_sentiment,
        performance=mix.by_performance,
        average_score=mix.average_score,
        recent_negatives=recent_negatives,
    )
