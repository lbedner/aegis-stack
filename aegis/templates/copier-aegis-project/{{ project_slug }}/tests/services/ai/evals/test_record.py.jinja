"""Eval runs kept: a scored run, its cases and their scores in the
project's tables, its conversations gone unless kept, and two runs compared."""

import hashlib
from pathlib import Path

import pytest
from sqlmodel import select
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core.time import utcnow
from app.models.conversation import Conversation
from app.services.ai.domains.evals import queries, runner
from app.services.ai.domains.evals.recorder import record_run
from app.services.ai.models.evals import EvalRun
from tests.services.ai.evals._mini import DATASET, answering

TALKS = ["c-what does the letter say?", "c-tidy up"]


@pytest.fixture
def mini(tmp_path: Path, async_db_session: AsyncSession) -> Path:
    """The ``mini`` dataset, and the conversations its turns would leave."""
    (tmp_path / "mini.yaml").write_text(DATASET)
    async_db_session.add_all(Conversation(id=talk, user_id="evals") for talk in TALKS)
    return tmp_path


async def _kept(
    session: AsyncSession, directory: Path, *, keep: bool = False, note: str | None = None
) -> EvalRun:
    started = utcnow()
    report = await runner.run_dataset("mini", directory=directory)
    return await record_run(
        session, report, started_at=started, keep=keep, trigger="cli", note=note
    )


async def _talks(session: AsyncSession) -> list[str]:
    return sorted(await session.exec(select(Conversation.id)))


async def test_a_run_is_kept_with_its_cases_and_scores(
    mini: Path, monkeypatch: pytest.MonkeyPatch, async_db_session: AsyncSession
) -> None:
    answering(monkeypatch)

    await _kept(async_db_session, mini, note="baseline")

    [run] = await queries.runs(async_db_session)
    assert (run.dataset, run.cases, run.passed, run.failed) == ("mini", 2, 2, 0)
    assert (run.total_cost, run.model_id, run.note) == (0.5, "gpt-test", "baseline")
    file = (mini / "mini.yaml").read_bytes()
    assert run.dataset_sha256 == hashlib.sha256(file).hexdigest()
    cases = {c.name: c for c in await queries.cases(async_db_session, run.id)}
    assert set(cases) == {"reads the paper", "never deletes"}
    paper = cases["reads the paper"]
    assert paper.passed and paper.tool_calls[0]["tool"] == "paper"
    assert paper.cost == 0.25
    scores = await queries.scores(async_db_session, paper.id)
    assert {s.evaluator: (s.passed, s.rule) for s in scores} == {
        "ToolCalls": (True, "calls paper once"),
        "Contains": (True, 'says "letter"'),
    }
    assert await _talks(async_db_session) == []
    assert paper.conversation_id is None


async def test_kept_conversations_are_named_on_their_cases(
    mini: Path, monkeypatch: pytest.MonkeyPatch, async_db_session: AsyncSession
) -> None:
    answering(monkeypatch)

    run = await _kept(async_db_session, mini, keep=True)

    cases = await queries.cases(async_db_session, run.id)
    assert {c.conversation_id for c in cases} == set(TALKS)
    assert await _talks(async_db_session) == sorted(TALKS)


@pytest.mark.queryspy(allow_n_plus_one=True)  # two runs, each written the same way
async def test_compare_names_only_the_cases_that_changed(
    mini: Path, monkeypatch: pytest.MonkeyPatch, async_db_session: AsyncSession
) -> None:
    answering(monkeypatch)
    before = await _kept(async_db_session, mini, keep=True)
    answering(monkeypatch, reads=False)
    after = await _kept(async_db_session, mini, keep=True)

    compared = await queries.compare(async_db_session, before.id, after.id)

    assert compared.dataset_changed is False
    [flip] = compared.cases
    assert compared.flipped == [flip]
    assert (flip.name, flip.change) == ("reads the paper", "flipped")
    assert flip.before and flip.after
    assert (flip.before.passed, flip.after.passed) == (True, False)
    assert flip.after.output == "The letter says hello." and flip.after.cost == 0.25
    tool_calls = next(s for s in flip.scores if s.evaluator == "ToolCalls")
    assert (tool_calls.rule, tool_calls.before, tool_calls.after) == (
        "calls paper once",
        1.0,
        0.0,
    )


@pytest.mark.queryspy(allow_n_plus_one=True)  # two runs, each written the same way
async def test_compare_marks_cases_added_removed_or_whose_rule_changed(
    mini: Path, monkeypatch: pytest.MonkeyPatch, async_db_session: AsyncSession
) -> None:
    """Over a dataset edited between the runs, flagged as such."""
    answering(monkeypatch)
    before = await _kept(async_db_session, mini, keep=True)
    edited = DATASET.replace("Contains: letter", "Contains: hello")
    (mini / "mini.yaml").write_text(edited.replace("never deletes", "never removes"))
    after = await _kept(async_db_session, mini, keep=True)

    compared = await queries.compare(async_db_session, before.id, after.id)

    assert compared.dataset_changed is True
    assert [(c.name, c.change) for c in compared.cases] == [
        ("reads the paper", "rule changed"),
        ("never removes", "added"),
        ("never deletes", "removed"),
    ]
    added, removed = compared.cases[1:]
    assert added.before is None and removed.after is None


@pytest.mark.queryspy(allow_n_plus_one=True)  # two runs, each written the same way
async def test_two_runs_alike_have_no_differences(
    mini: Path, monkeypatch: pytest.MonkeyPatch, async_db_session: AsyncSession
) -> None:
    answering(monkeypatch)
    before = await _kept(async_db_session, mini, keep=True)
    after = await _kept(async_db_session, mini, keep=True)

    compared = await queries.compare(async_db_session, before.id, after.id)

    assert compared.cases == [] and compared.dataset_changed is False


async def test_a_case_that_errors_is_kept_as_a_failure(
    mini: Path, async_db_session: AsyncSession
) -> None:
    started = utcnow()
    report = await runner.run_dataset("mini", directory=mini, scripted=True)
    run = await record_run(
        async_db_session, report, started_at=started, keep=False, trigger="ci", note=None
    )

    assert (run.cases, run.passed, run.failed, run.trigger) == (2, 0, 2, "ci")
    cases = await queries.cases(async_db_session, run.id)
    assert all(not c.passed and "no script" in (c.error or "") for c in cases)


async def test_a_run_and_one_of_its_cases_are_read_by_id_and_name(
    mini: Path, monkeypatch: pytest.MonkeyPatch, async_db_session: AsyncSession
) -> None:
    answering(monkeypatch)
    kept = await _kept(async_db_session, mini)
    assert kept.id

    run = await queries.run(async_db_session, kept.id)
    case = await queries.case(async_db_session, kept.id, "never deletes")

    assert run is not None and run.dataset == "mini"
    assert case is not None and case.passed
    assert await queries.run(async_db_session, kept.id + 1) is None


async def test_every_score_of_a_run_is_read_at_once(
    mini: Path, monkeypatch: pytest.MonkeyPatch, async_db_session: AsyncSession
) -> None:
    answering(monkeypatch)
    kept = await _kept(async_db_session, mini)
    assert kept.id

    found = await queries.run_scores(async_db_session, kept.id)

    cases = {c.id: c.name for c in await queries.cases(async_db_session, kept.id)}
    assert {(cases[s.case_id], s.evaluator) for s in found} == {
        ("reads the paper", "ToolCalls"),
        ("reads the paper", "Contains"),
        ("never deletes", "ToolCalls"),
    }

@pytest.mark.queryspy(allow_n_plus_one=True)  # the same read, of two runs
async def test_the_run_before_is_the_last_of_its_dataset(
    async_db_session: AsyncSession,
) -> None:
    """However many runs came after it, or of other datasets in between."""
    first, other, last = (
        EvalRun(dataset=name, model_id="m", build="b", cases=1, passed=1)
        for name in ("mini", "other", "mini")
    )
    async_db_session.add_all([first, other, last])
    await async_db_session.flush()

    assert await queries.previous(async_db_session, last) == first.id
    assert await queries.previous(async_db_session, first) is None


async def test_runs_are_read_by_model(async_db_session: AsyncSession) -> None:
    async_db_session.add_all(
        EvalRun(dataset="mini", model_id=model, cases=1, passed=1)
        for model in ("gpt-a", "gpt-b", "gpt-a")
    )
    await async_db_session.flush()

    assert [r.model_id for r in await queries.runs(async_db_session, model="gpt-a")] == [
        "gpt-a",
        "gpt-a",
    ]
    assert await queries.models(async_db_session) == ["gpt-a", "gpt-b"]
