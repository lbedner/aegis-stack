class ThreadSection(BaseModel):
    """One kind of thread, with what its other lines are (``other``)."""

    key: str
    title: str
    other: str | None = None
    empty: str = "Nothing yet."
    items: list[ThreadItem]


class GuideRow(BaseModel):
