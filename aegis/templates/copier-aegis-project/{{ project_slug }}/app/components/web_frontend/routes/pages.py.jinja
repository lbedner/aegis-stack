    group: str,
    name: str,
    user: User | None = Depends(get_optional_user),
    db: AsyncSession = Depends(get_async_db),
) -> Response:
    """A navigable status page for an installed component or service."""
    return await _overseer_detail(request, group, name, user, db)


@router.get(
    "/overseer/{group}/{name}/{section}",
    response_class=HTMLResponse,
    include_in_schema=False,
)
async def overseer_section(
    request: Request,
    group: str,
    name: str,
    section: str,
    user: User | None = Depends(get_optional_user),
    db: AsyncSession = Depends(get_async_db),
) -> Response:
    """One section of a page with a sub-menu; the first lives at the page's URL."""
    page = SECTIONED_PAGES.get((group, name))
    if page is None or section not in list(page.labels)[1:]:
        raise HTTPException(status_code=404)
    return await _overseer_detail(request, group, name, user, db, section)


async def _overseer_detail(
    request: Request,
    group: str,
    name: str,
    user: User | None,
    db: AsyncSession,
    section: str = "overview",
) -> Response:
    """Render a page. ``db`` is the request's session, the one the user
    lookup already opened: a second session would wait on SQLite's write
    lock and fail with "database is locked"."""
    if user is None:
        return RedirectResponse(url="/overseer/login", status_code=303)
    status = last_system_status()
    navigation = build_navigation(status)
    item = overseer_patterns.ITEM if group == "patterns" else find_item(navigation, group, name)
    if item is None:
        raise HTTPException(status_code=404)
    context = {"user": user, "navigation": navigation, "status": status, "item": item}
    if page := SECTIONED_PAGES.get((group, name)):
        context |= {"page": page, "current": section}
        context |= await page.context(
            section, item.component, SectionRequest(user, db, request.query_params, request.url.path, request.app.routes)
        )
    return render(
        request,
        name="pages/overseer/detail.html",
        context=context,
        page_layout="layouts/overseer.html",
    )


@router.post("/login", include_in_schema=False)
@router.post("/overseer/login", include_in_schema=False)
async def login_submit(
    request: Request,
    email: Annotated[str, Form()],
    password: Annotated[str, Form()],
    next: Annotated[str, Form()] = "",
    user_service: UserService = Depends(get_user_service),
    refresh_service: RefreshService = Depends(get_refresh_service),
    audit: AuditEmitter = Depends(get_audit),
    _rate_limit: None = Depends(login_rate_limit),
) -> RedirectResponse:
    """Sign in from the page form.

    Delegates to the API's own login handler rather than reimplementing it:
    account lockout, failed-attempt tracking, audit events, token minting and
    cookie scoping all live there, and a second copy here would drift out of
    step with them. The rate limiter is re-declared above so this path is
    limited by the same bucket as the API.

    The redirect is handed in as the ``response``, so the session and refresh
    cookies the API handler sets land on the 303 the browser follows.
    """
    overseer = request.url.path == "/overseer/login"
    redirect = RedirectResponse(
        url="/overseer" if overseer else _safe_next(next), status_code=303
    )
    try:
        await api_login(
            request=request,
            response=redirect,
            form_data=OAuth2PasswordRequestForm(username=email, password=password),
            user_service=user_service,
            refresh_service=refresh_service,
            audit=audit,
            _rate_limit=None,
        )
    except HTTPException as exc:
        # The API answers wrong-password and locked-account with the same 401
        # so neither reveals whether the email exists; keep that as one
        # message. Its 403 comes only after a correct password, for a
        # disabled account, so saying so reveals nothing new.
        reason = "disabled" if exc.status_code == 403 else "invalid"
        error_path = "/overseer/login" if overseer else "/login"
        return RedirectResponse(url=f"{error_path}?error={reason}", status_code=303)
    return redirect


