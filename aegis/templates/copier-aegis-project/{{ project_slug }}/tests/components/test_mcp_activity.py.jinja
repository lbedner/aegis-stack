{% if include_mcp and include_database %}"""What did an outside assistant look at, and what did it propose? Every MCP
call is kept, by client, apart from the chat agents' own tool calls."""

from contextlib import asynccontextmanager
from datetime import datetime, timedelta
import json
from typing import Any

from fastmcp import Client, FastMCP
from mcp.types import Implementation
import pytest
from sqlmodel import select
from sqlmodel.ext.asyncio.session import AsyncSession

from app.components.mcp import activity
from app.components.mcp.server import McpCall, McpStep, build_server
from app.core.tools import register_tool
from app.services.system import ui_mcp

CLAUDE = Implementation(name="claude-code", version="1")
DESKTOP = Implementation(name="claude-desktop", version="1")


async def lookup(order_id: str) -> dict[str, Any]:
    """Look up an order by id."""
    return {"order_id": order_id}


async def file_it(note: str) -> dict[str, Any]:
    """File a note for approval."""
    return {"status": "pending", "note": note}


@pytest.fixture
def server(
    clean_registry: None,
    async_db_session: AsyncSession,
    monkeypatch: pytest.MonkeyPatch,
) -> FastMCP:
    """A server whose calls are kept through the test session."""

    @asynccontextmanager
    async def test_session():  # type: ignore[no-untyped-def]
        yield async_db_session

    monkeypatch.setattr(activity, "get_async_session", test_session)
    # No prune is due: one would run beside the next call, on its session.
    monkeypatch.setattr(activity, "_pruned_at", float("inf"))
    register_tool("lookup", lookup, effect="read")
    register_tool("file_it", file_it, effect="proposes")
    return build_server(["lookup", "file_it"], record=activity.record)


async def _call(
    server: FastMCP, client: Implementation, tool: str, arguments: dict[str, Any]
) -> None:
    async with Client(server, client_info=client) as session:
        await session.call_tool(tool, arguments)


async def test_every_call_is_kept_with_its_client_and_effect(
    server: FastMCP,
) -> None:
    await _call(server, CLAUDE, "lookup", {"order_id": "A1"})
    await _call(server, CLAUDE, "file_it", {"note": "hi"})

    rows = await activity.recent(limit=10)

    assert [(r.client, r.tool, r.effect, r.ok) for r in rows] == [
        ("claude-code", "file_it", "proposes", True),
        ("claude-code", "lookup", "read", True),
    ]


async def test_activity_reads_by_client(server: FastMCP) -> None:
    await _call(server, CLAUDE, "lookup", {"order_id": "A1"})
    await _call(server, CLAUDE, "file_it", {"note": "hi"})
    await _call(server, DESKTOP, "lookup", {"order_id": "B2"})

    clients = {c.client: c for c in await activity.by_client()}

    assert (clients["claude-code"].reads, clients["claude-code"].proposals) == (1, 1)
    assert (clients["claude-desktop"].reads, clients["claude-desktop"].proposals) == (
        1,
        0,
    )


# A run_code call and the two reads its script made inside the sandbox.
RUN = McpCall(
    tool="run_code",
    client="claude-code",
    effect="read",
    duration_ms=40,
    result_bytes=9,
    ok=True,
    steps=(
        McpStep(
            tool="lookup",
            args='{"order_id": "A1"}',
            ok=True,
            result_bytes=20,
            response='{"order_id": "A1"}',
        ),
        McpStep(tool="lookup", args='{"order_id": "B2"}', ok=False, result_bytes=0),
    ),
)


async def test_a_runs_reads_are_kept_under_it(server: FastMCP) -> None:
    """Each read a script made is its own row under the run, untimed (the
    sandbox does not time them); the client made one call."""
    await activity.record(RUN)

    [run] = await activity.recent(limit=10)

    assert run.tool == "run_code"
    assert [(s.tool, s.args, s.ok, s.duration_ms) for s in run.steps] == [
        ("lookup", '{"order_id": "A1"}', True, None),
        ("lookup", '{"order_id": "B2"}', False, None),
    ]
    # A read's response is kept with it (read when its row is opened).
    first = await activity.one(run.steps[0].id or 0)
    assert first is not None and first.response == '{"order_id": "A1"}'
    [claude] = await activity.by_client()
    assert (claude.calls, claude.reads) == (1, 1)


async def test_overseer_lists_a_runs_reads_under_it(server: FastMCP) -> None:
    await activity.record(RUN)

    calls = (await ui_mcp.recorded())["calls"]

    assert [(c["tool"], bool(c.get("child"))) for c in calls] == [
        ("run_code", False),
        ('lookup {"order_id": "A1"}', True),
        ('lookup {"order_id": "B2"}', True),
    ]
    assert calls[2]["result"] == ui_mcp.FAILED


FAILED_CALL = McpCall(
    tool="lookup",
    client="claude-code",
    effect="read",
    duration_ms=5,
    result_bytes=0,
    ok=False,
    transport="http",
    client_version="2.1.0",
    session="abc123",
    user_id=7,
    token="laptop",
    args='{"order_id": "A1"}',
    error="ValueError: no such order",
)
ANSWERED = FAILED_CALL.model_copy(
    update={"ok": True, "error": None, "response": '{"order_id": "A1"}'}
)


async def test_a_call_keeps_what_debugging_needs(server: FastMCP) -> None:
    await activity.record(FAILED_CALL)

    [listed] = await activity.recent(limit=10)
    row = await activity.one(listed.id or 0)

    assert row is not None
    assert (row.transport, row.client_version, row.session) == ("http", "2.1.0", "abc123")
    assert (row.user_id, row.token, row.args) == (7, "laptop", '{"order_id": "A1"}')
    assert row.error == "ValueError: no such order"


def test_a_prune_finds_old_calls_by_an_index() -> None:
    """Pruning reads calls by age: indexed, not a scan of every call."""
    table = activity.McpToolCall.__table__  # type: ignore[attr-defined]

    assert any(
        [column.name for column in index.columns] == ["called_at"]
        for index in table.indexes
    )


def _old_run(at: datetime) -> Any:
    """A run_code call from ``at``, with the read its script made."""
    run = activity.McpToolCall(
        called_at=at,
        client="claude-code",
        tool="run_code",
        effect="read",
        ok=True,
        duration_ms=1,
        result_bytes=1,
    )
    run.steps = [
        activity.McpToolCall(
            called_at=at,
            client="claude-code",
            tool="lookup",
            effect="read",
            ok=True,
            duration_ms=None,
            result_bytes=1,
        )
    ]
    return run


@pytest.mark.queryspy(threshold=4)  # a select and two deletes per batch, by design
async def test_a_call_past_the_keep_is_deleted_with_its_reads(
    server: FastMCP,
    async_db_session: AsyncSession,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """The record is not forever: after a write, calls older than ``KEEP``
    go, the reads a script made with them, a batch at a time, off the
    client's call (``background``)."""
    from app.core.time import utcnow

    old = utcnow() - activity.KEEP - timedelta(days=1)
    async_db_session.add_all([_old_run(old), _old_run(old)])
    await async_db_session.commit()
    pruning: list[Any] = []
    monkeypatch.setattr(activity, "background", pruning.append)
    monkeypatch.setattr(activity, "_pruned_at", float("-inf"))
    # Two full batches, then the empty one that ends the prune.
    monkeypatch.setattr(activity, "BATCH", 1)

    await activity.record(ANSWERED)
    [prune] = pruning
    await prune

    kept = (await async_db_session.exec(select(activity.McpToolCall))).all()
    assert [row.tool for row in kept] == ["lookup"] and kept[0].parent_id is None


async def _detail(call: McpCall) -> dict[str, Any]:
    """What Overseer shows when the call's row is opened."""
    await activity.record(call)
    [row] = await activity.recent(limit=10)
    found = await ui_mcp.call_detail(row.id or 0)
    assert found is not None
    return found


async def test_overseer_lists_the_transport_and_opens_to_the_rest(
    server: FastMCP,
) -> None:
    """The list carries what its columns show; what a call sent and got
    back is read when its row is opened (``call_detail``)."""
    await activity.record(FAILED_CALL)

    [call] = (await ui_mcp.recorded())["calls"]
    detail = await ui_mcp.call_detail(call["id"])

    assert call["via"] == "http"
    assert not {"args", "response", "error"} & set(call)
    assert detail is not None
    facts = dict(detail["facts"])
    assert (facts["Client version"], facts["Token"]) == ("2.1.0", "laptop")
    assert json.loads(detail["args"]) == {"order_id": "A1"}
    assert detail["error"] == "ValueError: no such order"


async def test_an_unknown_call_has_no_detail(server: FastMCP) -> None:
    assert await ui_mcp.call_detail(404) is None


async def test_a_call_keeps_and_shows_its_response(server: FastMCP) -> None:
    detail = await _detail(ANSWERED)

    assert json.loads(detail["response"]) == {"order_id": "A1"}
    assert (detail["args_lang"], detail["response_lang"]) == ("json", "json")


async def test_a_script_shows_as_python(server: FastMCP) -> None:
    script = json.dumps({"code": "h = await health()\nh"})
    detail = await _detail(ANSWERED.model_copy(update={"args": script}))

    assert (detail["args"], detail["args_lang"]) == ("h = await health()\nh", "python")


async def test_a_call_without_arguments_shows_them_empty(server: FastMCP) -> None:
    """So every call opens to the same sections, arguments or none."""
    detail = await _detail(ANSWERED.model_copy(update={"args": "{}"}))

    assert detail["args"] == "{}"
