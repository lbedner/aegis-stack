"""What a case asserts about a turn: the tools it called, with what, in
what order, and what its answer leaves out.

Scored on the turn's ``tool_trace`` (``app/services/ai/service/trace.py``),
the steps the saved message keeps and Overseer shows, so a case checks
what a person reads. Pydantic Evals' own ``Contains`` and ``LLMJudge``
cover what the answer says.
"""

from collections import Counter
from collections.abc import Callable
from dataclasses import dataclass, field
from datetime import timedelta
import json
from typing import Any, cast

from pydantic_evals.evaluators import (
    EvaluationReason,
    Evaluator,
    EvaluatorContext,
    EvaluatorSpec,
    LLMJudge,
)
from pydantic_evals.evaluators.common import DEFAULT_EVALUATORS
{%- if ai_backend != "memory" %}
from pydantic_evals.evaluators.llm_as_a_judge import GradingOutput

from app.core.tools import RUN_CODE
from app.services.ai.domains.llm.writer import write

from .agents import JUDGE, JUDGING
from .script import args_of
{%- endif %}

# Where the runner puts the turn's trace on each case (``set_eval_attribute``).
TRACE = "tool_trace"
# And beside it, what the reply's metadata says of its turn.
CONVERSATION = "conversation_id"
COST = "cost"
MODEL = "model"
# On the run's report: the dataset it ran (``datasets.fingerprint``).
FINGERPRINT = "dataset_sha256"
# Whose an eval run's turns and judging are, so they never mix with a person's.
EVALS_USER = "evals"


@dataclass(frozen=True)
class ToolCall:
    """One call a turn made, its arguments parsed."""

    name: str
    args: dict[str, Any]


def calls_of(trace: list[dict[str, Any]]) -> list[ToolCall]:
    """Every call in a trace, in order: a script's dispatches follow it."""
    calls: list[ToolCall] = []
    for entry in trace:
        calls.append(ToolCall(entry["tool"], args_of(entry)))
        calls.extend(ToolCall(n["tool"], args_of(n)) for n in entry.get("nested", ()))
    return calls


def _calls(ctx: EvaluatorContext[Any, Any, Any]) -> list[ToolCall]:
    return calls_of(ctx.attributes.get(TRACE) or [])


def _times(n: int) -> str:
    return "once" if n == 1 else f"{n} times"


def called(trace: list[dict[str, Any]]) -> str:
    """A turn's calls summed up, ``called errors 4 times, health once``: a
    script (``run_code``) by the calls it made."""
    counts = Counter(c.name for c in calls_of(trace) if c.name != RUN_CODE)
    if not counts:
        return "called no tools"
    return "called " + ", ".join(f"{name} {_times(n)}" for name, n in counts.items())


@dataclass(repr=False)
class ToolCalls(Evaluator[Any, Any, Any]):
    """``tool`` was called, holding every one of ``args``: ``times`` times,
    or at least once when unset; ``times: 0`` says it never was."""

    tool: str
    times: int | None = None
    args: dict[str, Any] = field(default_factory=dict)

    def evaluate(self, ctx: EvaluatorContext[Any, Any, Any]) -> EvaluationReason:
        tried = [c.args for c in _calls(ctx) if c.name == self.tool]
        n = sum(self.args.items() <= held.items() for held in tried)
        passed = n > 0 if self.times is None else n == self.times
        wanted = "at least once" if self.times is None else f"{self.times}"
        return EvaluationReason(
            passed, f"{self.tool}: {n} matching of {tried or 'no calls'}, wanted {wanted}"
        )

    def explain(self) -> str:
        held = f" with {json.dumps(self.args)}" if self.args else ""
        if self.times == 0:
            return f"never calls {self.tool}{held}"
        times = "at least once" if self.times is None else _times(self.times)
        return f"calls {self.tool}{held} {times}"


@dataclass(repr=False)
class ToolOrder(Evaluator[Any, Any, Any]):
    """``tools`` were called in this order, others allowed between."""

    tools: list[str]

    def evaluate(self, ctx: EvaluatorContext[Any, Any, Any]) -> EvaluationReason:
        made = [call.name for call in _calls(ctx)]
        rest = iter(made)
        passed = all(tool in rest for tool in self.tools)
        return EvaluationReason(passed, f"called {made}")

    def explain(self) -> str:
        return f"calls {', then '.join(self.tools)}"


@dataclass(repr=False)
class AnswerAvoids(Evaluator[Any, Any, Any]):
    """The answer says none of ``terms`` (any case)."""

    terms: list[str]

    def evaluate(self, ctx: EvaluatorContext[Any, Any, Any]) -> EvaluationReason:
        answer = str(ctx.output).lower()
        said = [term for term in self.terms if term.lower() in answer]
        return EvaluationReason(not said, f"said {said}" if said else "said none")

    def explain(self) -> str:
        return "never says " + " or ".join(f'"{term}"' for term in self.terms)


{%- if ai_backend != "memory" %}


# What AI spend calls the judge's calls.
JUDGE_ACTION = "eval_judge"


@dataclass(repr=False)
class Judged(Evaluator[Any, Any, Any]):
    """The model in force says the answer holds ``rubric``, given the
    message and what the turn read first (its trace: each tool call and its
    result), the evidence a fact in the answer rests on. A judge that fails
    is the case's evaluator failure, not the run's."""

    rubric: str

    async def evaluate(self, ctx: EvaluatorContext[Any, Any, Any]) -> EvaluationReason:
        message = ctx.inputs.message
        read = json.dumps(ctx.attributes.get(TRACE) or [], default=str)
        text = (
            f"<Input>{message}</Input>\n<Read>{read}</Read>\n"
            f"<Output>{ctx.output}</Output>\n<Rubric>{self.rubric}</Rubric>"
        )
        verdict, _model = await write(
            JUDGE, JUDGING, GradingOutput, text, action=JUDGE_ACTION, owner_user_id=EVALS_USER
        )
        return EvaluationReason(verdict.pass_, verdict.reason)

    def explain(self) -> str:
        return f"a judge agrees: {self.rubric}"
{%- endif %}


EVALUATORS = (ToolCalls, ToolOrder, AnswerAvoids{% if ai_backend != "memory" %}, Judged{% endif %})
# The checks a model grades: a scripted run, with no model, leaves them out.
GRADED = (LLMJudge{% if ai_backend != "memory" %}, Judged{% endif %})


def _quoted(value: Any) -> str:
    """A value a check looks for: text in quotes, anything else as JSON."""
    return f'"{value}"' if isinstance(value, str) else json.dumps(value, default=str)


def _seconds(limit: float | timedelta) -> str:
    seconds = limit.total_seconds() if isinstance(limit, timedelta) else limit
    return f"{seconds:g}s"


def _contains(e: Any) -> str:
    said = f"says {_quoted(e.value)}" if isinstance(e.value, str) else f"contains {_quoted(e.value)}"
    return said if e.case_sensitive else f"{said} (any case)"


def _tools(e: Any) -> str:
    named = ", ".join(e.expected_tools)
    return f"calls {named}, others allowed" if e.allow_extra else f"calls exactly {named}"


def _trajectory(e: Any) -> str:
    if e.order == "any_order":
        return f"calls {', '.join(e.expected_trajectory)}, in any order"
    calls = f"calls {', then '.join(e.expected_trajectory)}"
    return f"{calls}, nothing else" if e.order == "exact" else calls


# Pydantic Evals' own checks in words, by the name a dataset gives
# each: every one a dataset can name (a name this version lacks never comes).
BUILT_IN: dict[str, Callable[[Any], str]] = {
    "Contains": _contains,
    "Equals": lambda e: f"answers exactly {_quoted(e.value)}",
    "EqualsExpected": lambda e: "answers exactly what is expected",
    "IsInstance": lambda e: f"answers a {e.type_name}",
    "MaxDuration": lambda e: f"answers within {_seconds(e.seconds)}",
    "LLMJudge": lambda e: f"a judge agrees: {e.rubric}",
    "GEval": lambda e: f"a judge scores {e.criteria} from {e.score_range[0]} to {e.score_range[1]}",
    "HasMatchingSpan": lambda e: f"a span matches {json.dumps(e.query)}",
    "ToolCorrectness": _tools,
    "TrajectoryMatch": _trajectory,
    "ArgumentCorrectness": lambda e: f"calls {e.tool_name} with {json.dumps(e.expected_arguments)}",
    "MaxToolCalls": lambda e: f"calls at most {e.max_calls} tools",
    "MaxModelRequests": lambda e: f"makes at most {e.max_requests} model requests",
}
# Each check by the name a dataset and a result's spec give it.
KNOWN: dict[str, type[Evaluator[Any, Any, Any]]] = {
    kind.get_serialization_name(): kind for kind in (*DEFAULT_EVALUATORS, *EVALUATORS)
}
# Pydantic Evals' checks that read the run's spans: a run without
# instrumentation (CI, the tests) has none, so each fails there. ``ToolCalls``
# and ``ToolOrder`` read the same calls from the trace every run keeps.
SPANS = tuple(
    KNOWN[name]
    for name in (
        "HasMatchingSpan",
        "ToolCorrectness",
        "TrajectoryMatch",
        "ArgumentCorrectness",
        "MaxToolCalls",
        "MaxModelRequests",
    )
    if name in KNOWN
)


def _named(name: str, args: dict[str, Any] | tuple[Any, ...] | None) -> str:
    """A check this app has no words for: its name and arguments."""
    held = args.items() if isinstance(args, dict) else enumerate(args or ())
    return f"{name}({', '.join(f'{key}={value!r}' for key, value in held)})"


def explain(evaluator: Evaluator[Any, Any, Any]) -> str:
    """What a check wants, in words; one this app does not know (a project's
    own) by its name and arguments."""
    if isinstance(evaluator, EVALUATORS):
        return evaluator.explain()
    words = BUILT_IN.get(evaluator.get_serialization_name())
    if words is not None:
        return words(evaluator)
    return _named(
        evaluator.get_serialization_name(), evaluator.build_serialization_arguments()
    )


def rule_of(spec: EvaluatorSpec) -> str:
    """The rule a kept result was scored on (``explain``), from the spec
    its result carries: the check rebuilt from its name and arguments."""
    kind = KNOWN.get(spec.name)
    if kind is None:
        return _named(spec.name, spec.arguments)
    args = spec.arguments
    if isinstance(args, dict):
        return explain(kind(**args))
    # A one-argument check's spec holds the argument alone (``Contains: x``).
    return explain(cast(Any, kind)(*(args or ())))
