@router.get("/users/{user_id}", response_model=UserResponse)
async def get_user(
    user_id: int,
    token: str | None = Depends(get_session_token),
    user_service: UserService = Depends(get_user_service),
) -> UserResponse:
    """Get a specific user by ID. Caller must be the user or an admin."""
    current_user = await get_current_user_from_token(token, user_service)
    is_self = current_user.id == user_id
{% if include_auth_rbac %}
    is_admin = current_user.role == "admin"
{% else %}
    is_admin = False
{% endif %}
    if not is_self and not is_admin:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Not authorized to view this user",
        )

    user = await user_service.get_user_by_id(user_id)
    if not user:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="User not found",
        )
    return UserResponse.model_validate(user)


@router.patch("/users/{user_id}", response_model=UserResponse)
async def update_user(
    user_id: int,
    full_name: str | None = None,
    token: str | None = Depends(get_session_token),
    user_service: UserService = Depends(get_user_service),
) -> UserResponse:
    """Update a user's profile. Caller must be the user or an admin."""
    current_user = await get_current_user_from_token(token, user_service)
    is_self = current_user.id == user_id
{% if include_auth_rbac %}
    is_admin = current_user.role == "admin"
{% else %}
    is_admin = False
{% endif %}
    if not is_self and not is_admin:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Not authorized to update this user",
        )

    updates: dict[str, str] = {}
    if full_name is not None:
        updates["full_name"] = full_name

    if not updates:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="No fields to update",
        )

    user = await user_service.update_user(user_id, **updates)
    if not user:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="User not found",
        )
    return UserResponse.model_validate(user)


