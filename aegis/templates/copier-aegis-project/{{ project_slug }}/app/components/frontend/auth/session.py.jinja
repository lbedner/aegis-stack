"""
Cookie-backed session helpers for the Flet frontend.

Auth model
----------
The backend issues an HttpOnly ``aegis_session`` cookie on
``/auth/token``, ``/auth/register``, and the OAuth callback. That
cookie lives in the per-session ``APIClient``'s underlying httpx
cookie jar. The Flet Python server holds the jar; the browser never
sees the cookie in Flet mode (it would in an htmx front-end, but the
backend behavior is identical).

The jar is process memory, so a webserver restart - a deploy, and far
more often a dev hot-reload - emptied it and forced a fresh login with
no way back: ``/auth/me`` 401s, the silent refresh posts to
``/auth/refresh`` with no cookie to send, and the user lands on /login.

So one value outlives the process: the ROTATING REFRESH TOKEN, in
``page.client_storage``. Never the access token, and never a token that
has been superseded - the backend's reuse detection treats a replayed
one as an attack, which is why ``APIClient`` reports every rotation and
this module stores the successor each time.

This module exposes two operations:

- ``is_authenticated(page)`` — round-trip ``/auth/me`` and report whether
  the cookie is currently honored. Cheap (single GET), authoritative
  (server is the source of truth), and naturally surfaces token
  expiry / blacklist hits as "not signed in".
- ``try_resume_session(page)`` — seed a persisted refresh token into a
  cold jar and exchange it for a live session.
- ``sign_out(page)`` — call ``/auth/logout`` to revoke server-side, drop
  the cookie jar locally, forget the persisted token, clear
  ``SessionState``, and route to /login.

Everything here is async-only.
"""

from __future__ import annotations

import flet as ft

from app.components.frontend.core.routes import LOGIN_ROUTE
from app.components.frontend.state.session_state import get_session_state
from app.core.client import REFRESH_COOKIE
from app.core.log import logger
from app.core.security import REFRESH_COOKIE_PATH

# Where the surviving refresh token lives between processes.
RESUME_TOKEN_KEY = "aegis.refresh_token"


async def persist_refresh_token(page: ft.Page, token: str) -> None:
    """Remember the CURRENT refresh token. Wired to APIClient rotation."""
    try:
        await page.client_storage.set_async(RESUME_TOKEN_KEY, token)
    except Exception as exc:
        logger.debug(f"auth.resume.persist_failed error={exc}")


async def forget_refresh_token(page: ft.Page) -> None:
    """Drop the persisted token so a signed-out session cannot resume."""
    try:
        await page.client_storage.remove_async(RESUME_TOKEN_KEY)
    except Exception as exc:
        logger.debug(f"auth.resume.forget_failed error={exc}")


async def try_resume_session(page: ft.Page) -> bool:
    """Rebuild a live session in a cold jar from the persisted token.

    Only runs when the jar has nothing of its own, so a working session
    is never disturbed. A token the backend rejects is forgotten rather
    than retried: it is either expired or already superseded, and
    replaying it again trips reuse detection.
    """
    state = get_session_state(page)
    api = state.api_client
    if api.has_session_cookies():
        return False
    try:
        token = await page.client_storage.get_async(RESUME_TOKEN_KEY)
    except Exception as exc:
        logger.debug(f"auth.resume.unavailable error={exc}")
        return False
    if not token:
        return False

    api.set_cookie(REFRESH_COOKIE, token, path=REFRESH_COOKIE_PATH)
    if await api.refresh_session():
        # The rotation callback has already stored the successor.
        logger.info("auth.resume.ok", session_id=page.session_id)
        return True

    logger.info("auth.resume.rejected", session_id=page.session_id)
    api.clear_cookies()
    await forget_refresh_token(page)
    return False


async def is_authenticated(page: ft.Page) -> bool:
    """
    Return True if the current session cookie is honored by the backend.

    Hits ``/auth/me``: a 200 means the cookie is valid and the session
    is live; anything else (401, network error, missing cookie) is
    treated as not signed in. The router calls this on initial nav and
    on every protected route change.
    """
    state = get_session_state(page)
    payload = await state.api_client.get("/api/v1/auth/me")
    if not (isinstance(payload, dict) and payload) and await try_resume_session(page):
        # A cold jar after a restart: the token outlived the process, so
        # ask once more rather than sending a signed-in user to /login.
        payload = await state.api_client.get("/api/v1/auth/me")
    if isinstance(payload, dict) and payload:
        # Cache the user on the session so views don't re-fetch.
        state.current_user = payload
        return True
    return False


async def sign_out(page: ft.Page) -> None:
    """
    Sign the user out: revoke server-side, drop local cookies, clear
    the user payload, and route to /login.

    Keeps ``SessionState`` and ``APIClient`` alive — the Flet session
    itself is still connected, only the auth state is reset. Tolerant
    of partial failures: even if the call to ``/auth/logout`` fails,
    the local jar is still cleared so the user lands in a clean
    unauthenticated state.
    """
    state = get_session_state(page)
    api = state.api_client

    try:
        await api.post("/api/v1/auth/logout")
    except Exception as exc:
        logger.warning(
            "auth.sign_out.server_call_failed",
            session_id=page.session_id,
            error=str(exc),
        )

    # Defang any stale cookie copy still in the jar locally — even if
    # the server-side delete-cookie response was honored, this is
    # belt-and-braces against a partial-failure replay.
    api.clear_cookies()
    await forget_refresh_token(page)
    state.current_user = None

    logger.info("auth.sign_out.complete", session_id=page.session_id)
    page.go(LOGIN_ROUTE)
{%- endif %}
