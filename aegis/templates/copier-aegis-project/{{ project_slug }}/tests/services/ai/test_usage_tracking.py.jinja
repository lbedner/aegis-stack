            user_id="user-2",
            input_tokens=200,
            output_tokens=100,
            total_cost=0.002,
            success=True,
            action="chat",
        )
        async_db_session.add(usage1)
        async_db_session.add(usage2)
        await async_db_session.commit()

        service = AIService(mock_ai_settings)
        with _store_session(async_db_session):
            stats = await service.get_usage_stats(user_id="user-1")

        assert stats["total_requests"] == 1
        assert stats["total_tokens"] == 150

    async def test_get_usage_stats_success_rate(
        self,
        async_db_session: AsyncSession,
        llm: LargeLanguageModel,
        mock_ai_settings: Any,
    ) -> None:
        """Test success rate calculation with failures."""
        usage1 = LLMUsage(
            model_id=llm.model_id,
            user_id="user-1",
            input_tokens=100,
            output_tokens=50,
            total_cost=0.001,
            success=True,
            action="chat",
        )
        usage2 = LLMUsage(
            model_id=llm.model_id,
            user_id="user-1",
            input_tokens=100,
            output_tokens=0,
            total_cost=0.0,
            success=False,
            action="chat",
            error_message="Provider error",
        )
        async_db_session.add(usage1)
        async_db_session.add(usage2)
        await async_db_session.commit()

        service = AIService(mock_ai_settings)
        with _store_session(async_db_session):
            stats = await service.get_usage_stats()

        assert stats["total_requests"] == 2
        assert stats["success_rate"] == 50.0
