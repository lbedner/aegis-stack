"""
Collector service — orchestrates data collection across all enabled sources.
{% if insights_per_user %}

Multi-tenant: each ``CollectorService`` instance is bound to a single
``Project`` (passed in on construction). The scheduler iterates over
projects and runs one ``CollectorService`` per project. Collectors and
record-detection both stamp ``project_id`` so cross-project rows stay
isolated.
{% endif %}
"""

import logging
from typing import Any

from sqlmodel.ext.asyncio.session import AsyncSession

from app.services.insights import queries
from app.services.insights.adapters.collectors.base import (
    BaseCollector,
    CollectionResult,
)
{% if insights_per_user -%}
from app.services.insights.models import Project
{%- endif %}
{% if insights_github %}
from app.services.insights.adapters.collectors.github_events import GitHubEventsCollector
from app.services.insights.adapters.collectors.github_stars import GitHubStarsCollector
from app.services.insights.adapters.collectors.github_traffic import GitHubTrafficCollector
{% endif %}
{% if insights_plausible %}
from app.services.insights.adapters.collectors.plausible import PlausibleCollector
{% endif %}
{% if insights_pypi %}
from app.services.insights.adapters.collectors.pypi import PyPICollector
{% endif %}
{% if insights_reddit %}
from app.services.insights.adapters.collectors.reddit import RedditCollector
{% endif %}
from app.services.insights.constants import MetricKeys, SourceKeys
from app.services.insights.utils import today

logger = logging.getLogger(__name__)

# Registry of source_key → collector class
COLLECTOR_REGISTRY: dict[str, type[BaseCollector]] = {
{% if insights_github %}
    SourceKeys.GITHUB_TRAFFIC: GitHubTrafficCollector,
    SourceKeys.GITHUB_STARS: GitHubStarsCollector,
    SourceKeys.GITHUB_EVENTS: GitHubEventsCollector,
{% endif %}
{% if insights_pypi %}
    SourceKeys.PYPI: PyPICollector,
{% endif %}
{% if insights_plausible %}
    SourceKeys.PLAUSIBLE: PlausibleCollector,
{% endif %}
{% if insights_reddit %}
    SourceKeys.REDDIT: RedditCollector,
{% endif %}
}


class CollectorService:
    """Orchestrates data collection across all enabled sources.
    {% if insights_per_user %}

    Bind to a project on construction; collectors then stamp every
    metric/event row with that project's id. ``project=None`` is the
    single-tenant fallback (env-var-driven), preserved for tooling
    and the auth=off mode.
    {% endif %}
    """

    def __init__(
        self,
        db: AsyncSession,
        {% if insights_per_user -%}
        project: Project | None = None,
        {%- endif %}
    ) -> None:
        self.db = db
        {% if insights_per_user -%}
        self.project = project
        {%- endif %}

    @property
    def project_id(self) -> int | None:
        """Convenience accessor mirroring ``BaseCollector.project_id``."""
        {% if insights_per_user -%}
        return self.project.id if self.project is not None else None
        {%- else %}
        return None
        {%- endif %}

    async def collect_all(self) -> dict[str, CollectionResult]:
        """Run all enabled collectors. Returns results keyed by source key."""
        results: dict[str, CollectionResult] = {}

        # Get enabled sources that have a registered collector
        enabled_sources = await queries.sources(self.db, enabled_only=True)

        for source in enabled_sources:
            if source.key in COLLECTOR_REGISTRY:
                results[source.key] = await self._run_collector(source.key)
            else:
                logger.debug("No collector registered for source '%s'", source.key)

        return results

    async def collect_source(self, source_key: str, **kwargs: Any) -> CollectionResult:
        """Run a specific collector by source key."""
        if source_key not in COLLECTOR_REGISTRY:
            return CollectionResult(
                source_key=source_key,
                success=False,
                error=f"No collector registered for source '{source_key}'",
            )

        # Check if source is enabled
        source = await queries.source_by_key(self.db, source_key)

        if source is None:
            return CollectionResult(
                source_key=source_key,
                success=False,
                error=f"Source '{source_key}' not found in database",
            )

        if not source.enabled:
            return CollectionResult(
                source_key=source_key,
                success=False,
                error=f"Source '{source_key}' is disabled",
            )

        return await self._run_collector(source_key, **kwargs)

    async def _run_collector(self, source_key: str, **kwargs: Any) -> CollectionResult:
        """Instantiate and run a collector."""
        collector_cls = COLLECTOR_REGISTRY[source_key]
        collector = collector_cls(
            self.db,
            {% if insights_per_user -%}
            project=self.project,
            {%- endif %}
        )

        logger.info("Running collector for '%s'", source_key)

        try:
            result = await collector.collect(**kwargs)
            if result.success and not result.skipped:
                # Gated on ``not skipped`` because an unconfigured optional
                # source returns ``success=True, skipped=True`` to render
                # as a yellow notice instead of a red error — nothing was
                # actually collected, so we must not bump the timestamp,
                # invalidate caches, or run record checks.
                from datetime import datetime
                source = await queries.source_by_key(self.db, source_key)
                if source:
                    source.last_collected_at = datetime.now()
                    self.db.add(source)
                    await self.db.commit()

                # Invalidate the dashboard / API bulk cache so consumers see
                # fresh data without waiting for the TTL to expire. Mirrors
                # the keys used by app/components/backend/api/insights.py.
                from app.core.cache import cache
                await cache.invalidate("insights:all")
                {% if insights_per_user -%}
                if self.project_id is not None:
                    await cache.invalidate(f"insights:project:{self.project_id}:all")
                {%- endif %}

                # Check for new records
                new_records = await self._check_records(source_key)
                result.records_broken = new_records

                logger.info(
                    "Collector '%s' completed: %d written, %d skipped",
                    source_key,
                    result.rows_written,
                    result.rows_skipped,
                )
            elif result.skipped:
                logger.info(
                    "Collector '%s' skipped: %s",
                    source_key,
                    result.error or "not configured",
                )
            else:
                logger.warning(
                    "Collector '%s' failed: %s",
                    source_key,
                    result.error,
                )
            return result
        except Exception as e:
            error_msg = f"Collector '{source_key}' raised exception: {e}"
            logger.error(error_msg, exc_info=True)
            return CollectionResult(
                source_key=source_key,
                success=False,
                error=error_msg,
            )

    async def _check_records(self, source_key: str) -> list[str]:
        """Check if any metrics set new all-time records after collection."""
        from datetime import datetime, timedelta
        import re

        from app.services.insights.models import InsightEvent

        broken: list[str] = []

        record_checks: dict[str, list[dict[str, str]]] = {
{% if insights_github %}
            SourceKeys.GITHUB_TRAFFIC: [
                {"key": "clones", "category": "daily_clones", "label": "GitHub 1-Day Clones", "event_type": "milestone_github"},
                {"key": "unique_cloners", "category": "daily_unique", "label": "GitHub 1-Day Unique", "event_type": "milestone_github"},
                {"key": "views", "category": "daily_views", "label": "GitHub 1-Day Views", "event_type": "milestone_github"},
                {"key": "unique_visitors", "category": "daily_visitors", "label": "GitHub 1-Day Visitors", "event_type": "milestone_github"},
            ],
{% endif %}
{% if insights_pypi %}
            SourceKeys.PYPI: [
                {"key": "downloads_daily", "category": "pypi_daily", "label": "PyPI Best Single Day", "event_type": "milestone_pypi"},
            ],
{% endif %}
{% if insights_plausible %}
            SourceKeys.PLAUSIBLE: [
                {"key": "visitors", "category": "plausible_daily_visitors", "label": "Docs 1-Day Visitors", "event_type": "milestone_pypi"},
                {"key": "pageviews", "category": "plausible_daily_pageviews", "label": "Docs 1-Day Pageviews", "event_type": "milestone_pypi"},
            ],
{% endif %}
        }

        checks = record_checks.get(source_key, [])
        if not checks:
            return broken

        now = today()

        for check in checks:
            mt = await queries.metric_type_by_key(self.db, check["key"])
            if not mt:
                continue

            top_rows = await queries.metrics_where(
                self.db,
                [mt.id],
                period="daily",
                order="value_desc",
                limit=1,
                project_id=self.project_id,
            )
            if not top_rows:
                continue

            record_date = str(top_rows[0].date)[:10]
            record_value = int(top_rows[0].value)

            if record_value == 0:
                continue

            existing = await queries.events_where(
                self.db,
                event_types=[check["event_type"]],
                order=None,
                project_id=self.project_id,
            )

            current_record = 0
            for ev in existing:
                meta = ev.metadata_ if isinstance(ev.metadata_, dict) else {}
                if meta.get("category") == check["category"]:
                    numbers = re.findall(r"\d[\d,]*", ev.description)
                    for n in numbers:
                        val = int(n.replace(",", ""))
                        current_record = max(current_record, val)

            if record_value > current_record:
                desc = f"⬢ {record_value:,} ({check['label']})"
                event = InsightEvent(
                    date=datetime.strptime(record_date, "%Y-%m-%d"),
                    event_type=check["event_type"],
                    description=desc,
                    metadata_={"category": check["category"]},
                    {% if insights_per_user -%}
                    project_id=self.project_id,
                    {%- endif %}
                )
                self.db.add(event)
                await self.db.commit()
                broken.append(f"{check['label']}: {record_value:,} (was {current_record:,})")
                logger.info(
                    "New record: %s = %s on %s (prev: %s)",
                    check["label"], record_value, record_date, current_record,
                )

{% if insights_github %}
        # 14-day rolling records for GitHub traffic — reads the latest
        # row of GitHub's server-computed rolling metrics (written daily
        # by the github_traffic collector), not a sum of per-day values.
        # This makes the "unique" variants correct — GitHub dedupes across
        # the 14-day window on their side, which a per-day sum can't.
        if source_key == SourceKeys.GITHUB_TRAFFIC:
            rolling_checks = [
                {"key": MetricKeys.CLONES_14D, "category": "14d_clones", "label": "GitHub 14-Day Clones", "event_type": "milestone_github"},
                {"key": MetricKeys.CLONES_14D_UNIQUE, "category": "14d_unique", "label": "GitHub 14-Day Unique Cloners", "event_type": "milestone_github"},
                {"key": MetricKeys.VIEWS_14D, "category": "14d_views", "label": "GitHub 14-Day Views", "event_type": "milestone_github"},
                {"key": MetricKeys.VIEWS_14D_UNIQUE, "category": "14d_visitors", "label": "GitHub 14-Day Unique Visitors", "event_type": "milestone_github"},
            ]
            for check in rolling_checks:
                mt = await queries.metric_type_by_key(self.db, check["key"])
                if not mt:
                    continue

                latest_rows = await queries.metrics_where(
                    self.db,
                    [mt.id],
                    period="daily",
                    order="date_desc",
                    limit=1,
                    project_id=self.project_id,
                )
                if not latest_rows:
                    continue

                rolling_value = int(latest_rows[0].value)
                if rolling_value == 0:
                    continue

                existing = await queries.events_where(
                    self.db,
                    event_types=[check["event_type"]],
                    order=None,
                    project_id=self.project_id,
                )

                current_record = 0
                for ev in existing:
                    meta = ev.metadata_ if isinstance(ev.metadata_, dict) else {}
                    if meta.get("category") == check["category"]:
                        numbers = re.findall(r"\d[\d,]*", ev.description)
                        for n in numbers:
                            val = int(n.replace(",", ""))
                            current_record = max(current_record, val)

                if rolling_value > current_record:
                    desc = f"⬢ {rolling_value:,} ({check['label']})"
                    event = InsightEvent(
                        date=now,
                        event_type=check["event_type"],
                        description=desc,
                        metadata_={"category": check["category"]},
                        {% if insights_per_user -%}
                        project_id=self.project_id,
                        {%- endif %}
                    )
                    self.db.add(event)
                    await self.db.commit()
                    broken.append(f"{check['label']}: {rolling_value:,} (was {current_record:,})")
                    logger.info(
                        "New 14-day record: %s = %s (prev: %s)",
                        check["label"], rolling_value, current_record,
                    )
{% endif %}

        return broken

    def get_registered_sources(self) -> list[str]:
        """Get list of source keys that have registered collectors."""
        return list(COLLECTOR_REGISTRY.keys())
