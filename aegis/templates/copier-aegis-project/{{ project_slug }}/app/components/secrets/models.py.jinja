"""The secrets component's one table: a credential per row, encrypted.

``ciphertext`` is bound to ``name`` (the encryption context), so a row
copied onto another name will not decrypt. ``hint`` (the last four of a
secret, or all of plain provider config) is kept readable so listing and
status never decrypt.
{%- if database_engine == "postgres" %}

Lives in its own ``secrets`` Postgres schema, apart from service tables.
{%- endif %}
"""

from datetime import datetime

from sqlalchemy import Column, DateTime, String, Text
from sqlmodel import Field, SQLModel

from app.core.time import utcnow


class SecretRecord(SQLModel, table=True):
    """One stored credential: never the value, only its ciphertext."""

    __tablename__ = "secret"
{%- if database_engine == "postgres" %}
    __table_args__ = {"schema": "secrets"}
{%- endif %}

    name: str = Field(sa_column=Column(String(128), primary_key=True))
    ciphertext: str = Field(sa_column=Column(Text, nullable=False))
    hint: str | None = Field(default=None, sa_column=Column(String(320), nullable=True))
    set_by: str | None = Field(default=None, sa_column=Column(String(320), nullable=True))
    set_at: datetime = Field(
        default_factory=utcnow, sa_column=Column(DateTime, nullable=False)
    )
