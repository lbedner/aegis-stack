{% if include_ai and ai_backend != "memory" and ai_framework == "pydantic-ai" %}
"""Ask AI: the stack's own model answers a moment from the meeting so far,
as the ``meeting-answers`` agent (``domains.agents``), so its prompt and
model are edited in Agents. Runs in the app; metered as ``meetings:ask``."""

from app.services.meetings.domains.actions.prompt import (
    Excerpt,
    said_before,
    the_question,
)
from app.services.meetings.domains.actions.registry import Action, register_action

METER = "meetings:ask"


def for_the_model(heard: Excerpt) -> str:
    """The excerpt as the model reads it: the meeting so far, then the
    moment."""
    return f"The meeting so far:\n{said_before(heard)}\n\n{the_question(heard)}"


async def answer(prompt: str, owner_user_id: int | None) -> str:
    # Here, not at the top: the AI service loads every tool, the meetings'
    # among them, which reach back into the meetings service this registers
    # from; and the agents load only when an answer is asked for.
    from app.services.ai.service import write
    from app.services.meetings.domains.agents import ANSWER_AGENT, ANSWER_PROMPT

    answer, _ = await write(
        ANSWER_AGENT,
        ANSWER_PROMPT,
        str,
        prompt,
        action=METER,
        owner_user_id=owner_user_id,
    )
    return answer


register_action(
    Action(
        "ai", "Ask AI", frozenset({"question"}), "app", run=answer, frame=for_the_model
    )
)
{% endif %}
