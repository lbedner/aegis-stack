def test_a_dataset_opens_on_its_cases_their_last_result_and_a_run(
    client: TestClient, two_runs: tuple[int, int]
) -> None:
    html = page_html(client, f"{PAGE}?dataset=mini")

    shown = one(html, "#ai-evals-dataset")
    assert "Reads what it is given." in text(shown)
    (case,) = table_rows(html, "#ai-evals-dataset table")
    # Why the case is there, under its name.
    assert text(case["Case"]) == "reads the papera letter is read, not guessed"
    assert text(case["Asks"]) == "what does the letter say?"
    assert text(case["Passes if"]) == 'calls paper once; says "letter"'
    assert text(case["Last run"]) == "Failed"
    # Its last result, opened from the row: the answer, each check.
    last = text(one(html, "#ai-evals-dataset [data-detail]"))
    assert "I could not find it." in last and "calls paper once" in last
    # The Run: the model (the active one unless picked), every case.
    form = one(html, "#ai-evals-start")
    assert one(form, "input[name=dataset]").get("value") == "mini"
    assert text(select(form, "select[name=model] option")[0]) == "qwen3:4b (active)"
    assert text(one(form, "button[type=submit]")) == "Run 1 case"


