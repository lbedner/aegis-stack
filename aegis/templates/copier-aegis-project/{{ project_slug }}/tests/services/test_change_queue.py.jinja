@pytest.mark.asyncio
async def test_the_chat_tool_proposes_a_registered_type(
    async_db_session: AsyncSession, monkeypatch: pytest.MonkeyPatch
) -> None:
    """The model's one write door files a card for any registered type,
    attributed to the agent and conversation of the turn."""
    from contextlib import asynccontextmanager

    from app.services.ai.domains.chat import change_tools
    from app.services.ai.domains.chat.tools import native_write_tool_names
    from app.services.ai.domains.chat.user_memory import memory_user

    @asynccontextmanager
    async def test_session():  # type: ignore[no-untyped-def]
        yield async_db_session

    monkeypatch.setattr(change_tools, "get_async_session", test_session)

    with memory_user("1", agent_slug="helper", conversation_id="conv-1"):
        result = await change_tools.propose(NOTE, {"text": "from chat"})

    assert result["status"] == "pending"
    assert result["title"] == "Write a note"
    assert result["display"] == [{"label": "Note", "value": "from chat"}]
    row = await change_queue.get_change(async_db_session, result["pending_change_id"])
    assert row is not None
    assert (row.proposed_by_agent, row.conversation_id) == ("helper", "conv-1")
    assert executed == []
    assert {
        "propose",
        "propose_many",
        "pending",
        "withdraw",
    } <= native_write_tool_names()
