{% if include_ai and ai_backend != "memory" and ai_framework == "pydantic-ai" %}
"""A meeting's notes: one pass of the active model over the finished
transcript, for its summary, decisions, action items and open questions,
each citing the transcript lines it came from. Metered like every other
model call (``meetings:notes`` in AI spend).

The bot writes them once it is out of the call (``bot.run_meeting``);
the Meetings page writes them again on request, over the old ones, so a
better model or a corrected "me" never needs the call again.
"""

from pydantic_ai import Agent

from app.core.config import settings
from app.core.db import get_async_session
from app.core.log import logger
from app.services.ai.domains.llm import active_model
from app.services.ai.usage_recording import extract_usage, record_usage
from app.services.meetings.models import (
    Meeting,
    MeetingNotes,
    Notes,
    TranscriptLine,
)
from app.services.meetings.service import WRITING, MeetingsService, save_notes

ACTION = "meetings:notes"
INSTRUCTIONS = """You write the notes of a meeting from its transcript.
Each transcript line reads "[id] Speaker: what they said".

Write a short summary, the decisions made, the action items (who has to do
what, and by when if it was said), and the questions left open. Leave a
list empty rather than invent an item. Give each item the ids of the lines
it came from. An action item's owner is the speaker who has to do it,
named exactly as in the transcript, or none when nobody took it."""


async def write_notes(meeting_id: int) -> None:
    """Write the meeting's notes, or why they could not be written; a
    meeting where nothing was said gets none."""
    WRITING.add(meeting_id)
    try:
        kept = await _write(meeting_id)
        if kept is not None:
            async with get_async_session() as session:
                await save_notes(session, kept)
    finally:
        WRITING.discard(meeting_id)


async def _write(meeting_id: int) -> MeetingNotes | None:
    async with get_async_session() as session:
        svc = MeetingsService(session, None)
        meeting = await svc.get(meeting_id)
        lines = await svc.transcript(meeting)
    if not lines:
        return None
    try:
        return await _ask(meeting, lines)
    except Exception as exc:
        logger.exception("Meeting notes failed", meeting_id=meeting_id)
        return MeetingNotes(meeting_id=meeting_id, error=str(exc)[:500])


async def _ask(
    meeting: Meeting, lines: list[tuple[str, TranscriptLine]]
) -> MeetingNotes:
    model, model_name = await active_model.model_for_active(settings)
    agent = Agent(model, instructions=INSTRUCTIONS, output_type=Notes)
    result = await agent.run(
        "\n".join(f"[{line.id}] {speaker}: {line.text}" for speaker, line in lines)
    )
    await record_usage(
        action=ACTION,
        model_name=model_name,
        usage=extract_usage(result),
        user_id=None if meeting.owner_user_id is None else str(meeting.owner_user_id),
    )
    notes = _cited(result.output, {line.id for _, line in lines})
    return MeetingNotes(
        meeting_id=meeting.id, content=notes.model_dump(), model_name=model_name
    )


def _cited(notes: Notes, said: set[int | None]) -> Notes:
    """``notes`` citing only lines the transcript has: a model can make
    one up."""
    for item in [*notes.decisions, *notes.action_items, *notes.open_questions]:
        item.lines = [line for line in item.lines if line in said]
    return notes
{% endif %}
