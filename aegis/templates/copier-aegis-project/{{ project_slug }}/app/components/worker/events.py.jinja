"""
Worker event publishing via Redis Streams.

Publishes lightweight lifecycle events (job enqueued, started, completed, failed,
worker started/stopped) to a Redis Stream. These events are consumed by the SSE
endpoint to provide real-time dashboard updates.
"""
{% if worker_backend == "arq" %}
import re
{%- endif %}
from datetime import UTC, datetime
from typing import Any

{% if worker_backend == "arq" -%}
from arq.constants import in_progress_key_prefix
{% endif -%}
import redis.asyncio as aioredis

from app.core.config import settings
from app.core.log import logger
from app.core.key_family import KeyFamily

# Redis Stream name for worker events
WORKER_EVENT_STREAM = "aegis:events:worker"
# Entries kept, roughly (trimmed with MAXLEN ~, which Redis does cheaply
# in whole blocks). The dashboard's feed tails new entries only.
WORKER_EVENT_STREAM_MAXLEN = 10_000

# What the worker keeps in Redis, for the keyspace map (``redis_keys``).
REDIS_KEYS = (
    KeyFamily(
        WORKER_EVENT_STREAM,
        "stream",
        "Worker events",
        "Job and worker lifecycle events, fanned out to the browser over SSE",
        "Worker events",
        columns=("Entry", "Event"),
        holds="event",
    ),
)


_events_redis: "aioredis.Redis | None" = None


async def events_redis() -> "aioredis.Redis":
    """The Redis client this process publishes worker events through.

    One per process, created on first use: every enqueue publishes, and
    opening a connection per publish is a connection per enqueue.
    """
    global _events_redis
    if _events_redis is None:
        redis_url = settings.redis_url_effective
        _events_redis = aioredis.from_url(redis_url)
    return _events_redis


async def close_events_redis() -> None:
    """Close the shared events client, if one was ever opened."""
    global _events_redis
    if _events_redis is not None:
        await _events_redis.aclose()
        _events_redis = None


async def publish_event(
    redis_client: Any,
    event_type: str,
    queue_name: str,
    metadata: dict[str, Any] | None = None,
) -> None:
    """
    Publish a worker event to the Redis Stream.

    Args:
        redis_client: Any Redis client that supports xadd
            (redis.asyncio.Redis or ArqRedis).
        event_type: Event type (job.enqueued, job.started, job.ended,
                    job.completed, job.failed, worker.started, worker.stopped).
        queue_name: Name of the worker queue (e.g., "system", "load_test").
        metadata: Optional extra fields to include in the event.
    """
    fields: dict[str, str] = {
        "type": event_type,
        "queue": queue_name,
        "timestamp": datetime.now(UTC).isoformat(),
    }
    if metadata:
        for k, v in metadata.items():
            fields[str(k)] = str(v)

    try:
        await redis_client.xadd(
            WORKER_EVENT_STREAM,
            fields,
            maxlen=WORKER_EVENT_STREAM_MAXLEN,
            approximate=True,
        )
    except Exception as e:
        # Never let event publishing failures break worker functionality
        logger.debug(f"Failed to publish worker event: {e}")


{% if worker_backend == "arq" -%}
async def arq_queue_depth(redis_client: Any, queue_name: str) -> tuple[int, int]:
    """``(waiting, running)`` on an arq queue, across every process.

    arq keeps a job in its queue's sorted set until it finishes and marks
    the running ones with an in-progress key, so those are taken off.
    """
    # ponytail: reads every id in the set; a worker claims from the front,
    # so ZCARD plus EXISTS over the first max_jobs x workers ids if a
    # backlog makes this heavy.
    job_ids = await redis_client.zrange(queue_name, 0, -1)
    if not job_ids:
        return 0, 0
    running = await redis_client.exists(
        *(
            f"{in_progress_key_prefix}{i if isinstance(i, str) else i.decode()}"
            for i in job_ids
        )
    )
    return len(job_ids) - running, running


def arq_health_counts(raw: str | bytes) -> dict[str, int]:
    """The ``j_*`` counters in an arq ``{queue}:health-check`` value
    (``Mar-01 17:41:22 j_complete=0 j_failed=0 ...``)."""
    text = raw if isinstance(raw, str) else raw.decode()
    return {name: int(n) for name, n in re.findall(r"(j_\w+)=(\d+)", text)}


{% endif -%}
async def read_queue_totals(redis_client: Any) -> dict[str, dict[str, int]]:
    """Read absolute job totals per queue as a baseline for SSE.

    Called ONCE on SSE connect to establish a baseline. The SSE endpoint
    then applies stream event deltas on top of this baseline.

    Args:
        redis_client: Redis connection (decode_responses=True).

    Returns:
        Per-queue dict with keys: queued, ongoing, completed, failed.
        E.g. {"load_test": {"queued": 5, "ongoing": 2, "completed": 100, "failed": 1}}
    """
    from app.components.worker.registry import get_all_queue_metadata
{% if worker_backend == "taskiq" %}
    # TaskIQ doesn't maintain persistent counters in Redis —
    # real-time counts come from stream events (deltas).
    return {
        qt: {"queued": 0, "ongoing": 0, "completed": 0, "failed": 0}
        for qt in get_all_queue_metadata()
    }
{%- elif worker_backend == "dramatiq" %}
    # Dramatiq uses Redis lists for queues. LLEN gives queue depth.
    # Completed/failed counts come from stream events (deltas).
    totals: dict[str, dict[str, int]] = {}
    for queue_type, meta in get_all_queue_metadata().items():
        queued = 0
        try:
            redis_queue_name = meta.get("redis_queue_name", f"dramatiq:{queue_type}")
            queued = await redis_client.llen(redis_queue_name) or 0
        except Exception:
            pass
        totals[queue_type] = {
            "queued": queued,
            "ongoing": 0,
            "completed": 0,
            "failed": 0,
        }
    return totals
{%- else %}
    queue_names = {
        qt: meta["queue_name"] for qt, meta in get_all_queue_metadata().items()
    }

    totals: dict[str, dict[str, int]] = {}
    for queue_type, queue_name in queue_names.items():
        queued = ongoing = completed = failed = 0
        try:
            queued, ongoing = await arq_queue_depth(redis_client, queue_name)
            health_data = await redis_client.get(f"{queue_name}:health-check")
            counts = arq_health_counts(health_data) if health_data else {}
            completed = counts.get("j_complete", 0)
            failed = counts.get("j_failed", 0)
        except Exception:
            pass  # best-effort; counters stay 0
        totals[queue_type] = {
            "queued": queued,
            "ongoing": ongoing,
            "completed": completed,
            "failed": failed,
        }
    return totals
{%- endif %}
