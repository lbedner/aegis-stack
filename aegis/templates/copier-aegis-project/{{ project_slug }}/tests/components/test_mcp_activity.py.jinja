async def test_mcp_calls_stay_out_of_the_agents_ledger(
    server: FastMCP, async_db_session: AsyncSession
) -> None:
    """The agents' tool-call ledger answers for chat agents only; an MCP
    client's calls are on their own record."""
    from sqlmodel import func, select

    from app.services.ai.models.agents import AgentToolCall

    await _call(server, CLAUDE, "lookup", {"order_id": "A1"})

    agent_calls = (
        await async_db_session.exec(select(func.count()).select_from(AgentToolCall))
    ).one()
    assert agent_calls == 0
