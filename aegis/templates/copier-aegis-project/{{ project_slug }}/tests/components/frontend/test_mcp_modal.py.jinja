{% if include_mcp %}"""The MCP card and modal in Flet: the same served tools, connect commands
and client activity as the htmx page (``ui_mcp``)."""

from typing import Any
from unittest.mock import MagicMock

import pytest

from app.components.frontend.dashboard.cards.mcp_card import McpCard
from app.components.frontend.dashboard.modals.mcp_modal import (
    McpDetailDialog,
    McpSection,
)
from app.core.config import settings
from app.core.tools import load_tools, register_tool
from app.services.system.models import ComponentStatus, ComponentStatusType
from tests.components.frontend._tree import rendered, walk

MCP = ComponentStatus(
    name="mcp",
    status=ComponentStatusType.HEALTHY,
    message="1 tool served",
    metadata={"served": 1, "dropped": 1},
)


async def lookup(order_id: str) -> dict[str, Any]:
    """Look up an order by id."""
    return {"order_id": order_id}


async def save(note: str) -> str:
    """Save a note."""
    return note


@pytest.fixture
def loaded() -> None:
    load_tools()


@pytest.fixture(autouse=True)
def granted(
    loaded: None, clean_registry: None, monkeypatch: pytest.MonkeyPatch
) -> None:
    register_tool("lookup", lookup, effect="read")
    register_tool("save", save, effect="writes")
    monkeypatch.setattr(settings, "MCP_TOOLS", ["lookup", "save"])


def test_the_card_counts_what_is_served() -> None:
    shown = rendered(McpCard(MCP).build())

    assert "MCP" in shown
    assert "Served" in shown and "1" in shown


async def test_the_modal_shows_the_grant_and_how_to_connect() -> None:
    section = McpSection()
    await section.load()
    shown = rendered(section)

    assert "lookup" in shown
    assert "Writes are never served" in shown
    assert f"{settings.PROJECT_NAME} mcp" in shown


def test_the_dialog_holds_the_section() -> None:
    dialog = McpDetailDialog(MCP, MagicMock())

    assert any(isinstance(node, McpSection) for node in walk(dialog))
{% endif %}
