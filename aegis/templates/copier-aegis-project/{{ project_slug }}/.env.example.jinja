# Aegis Stack Environment Variables Example
# Copy this file to .env and customize for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment: dev, qa, stg, prod
APP_ENV=dev

# HTTP Basic auth for /docs /redoc /openapi.json. Leave unset in dev for open
# access. REQUIRED in any non-dev APP_ENV (otherwise those endpoints 404).
# DOCS_USERNAME=admin
# DOCS_PASSWORD=change-me

# Public signup gate. False = /register and OAuth new-user creation refuse.
# Existing users still sign in normally.
# REGISTRATION_ENABLED=true

# Port to run the webserver on
PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Auto-reload server on code changes (development only)
AUTO_RELOAD=true

# =============================================================================
# DOCKER SETTINGS
# =============================================================================

# Docker image tag (used by docker-compose)
AEGIS_STACK_TAG=aegis-stack:latest

# Version tag for builds
AEGIS_STACK_VERSION=dev

# Environment file to use (defaults to .env)
# AEGIS_STACK_ENV_FILE=.env

# =============================================================================
# COMPONENT SETTINGS
# =============================================================================

{%- if include_database %}
# Database settings
{% if database_engine == "postgres" %}
# PostgreSQL database
{% if postgres_provider == "neon" %}
# Development runs against the local postgres container below (same as a plain
# postgres stack). Production uses Neon serverless Postgres in the cloud, with
# no DB container - see .env.deploy.example for the pooled + unpooled URLs.
{% endif %}
# For Docker: postgresql://postgres:postgres@postgres:5432/{{ project_slug }}
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/{{ project_slug }}

# Host-side CLI commands auto-resolve to localhost on the port `make serve`
# published (see .env.ports). Only uncomment to pin a different local
# database; it overrides that auto-resolution when not running in Docker.
# DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/{{ project_slug }}
{% else %}
# SQLite database
DATABASE_URL=sqlite:///./data/app.db
{% endif %}
# DATABASE_ENGINE_ECHO=false  # Set to true to log all SQL queries (debugging)
{% endif %}

{% if include_storage %}
# Object storage: any S3-compatible endpoint. Empty S3_ENDPOINT_URL means AWS.
# The compose stack's SeaweedFS accepts any credentials; production wants real ones.
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_BUCKET={{ project_slug }}
S3_ACCESS_KEY=aegis
S3_SECRET_KEY=aegis-secret
S3_REGION=us-east-1
S3_PATH_STYLE=true

{% endif %}
{% if include_redis or include_cache %}
# Redis settings
# For Docker: redis://redis:6379 (default)
REDIS_URL=redis://redis:6379

# Host-side CLI commands auto-resolve to localhost on the port `make serve`
# published (see .env.ports). Only uncomment to pin a different local
# Redis; it overrides that auto-resolution when not running in Docker.
# REDIS_URL_LOCAL=redis://localhost:6379
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Redis connection settings (for high-load scenarios)
# REDIS_CONN_TIMEOUT=5  # Connection timeout in seconds
# REDIS_CONN_RETRIES=5  # Number of connection retry attempts
# REDIS_CONN_RETRY_DELAY=1  # Delay between retries in seconds
{% endif %}

{%- if include_scheduler %}
# Scheduler settings
# SCHEDULER_TIMEZONE=UTC  # IANA tz name (e.g., UTC, US/Eastern, Europe/Berlin); cron triggers inherit this
{% endif %}

{%- if include_ingress %}
# Traefik Ingress settings
# For Docker: http://traefik:8080 (default)
TRAEFIK_API_URL=http://traefik:8080
# Host-side CLI commands auto-resolve to localhost on the port `make serve`
# published (see .env.ports). Only uncomment to pin a different local
# dashboard; it overrides that auto-resolution when not running in Docker.
# TRAEFIK_API_URL_LOCAL=http://localhost:8080
{%- if ingress_tls %}

# Production TLS Settings (Let's Encrypt)
# Domain for your application
DOMAIN={{ ingress_domain if ingress_domain else 'example.com' }}
# Email for Let's Encrypt certificate notifications
ACME_EMAIL={{ author_email if author_email else 'admin@example.com' }}
{%- endif %}
{% endif %}

{%- if include_observability %}

# Observability (Logfire)
# Sign up at https://logfire.pydantic.dev, create a project, generate a write token
# When LOGFIRE_TOKEN is empty the entire observability stack is skipped
# (avoids loading the OpenTelemetry SDK, which costs ~150-300 MiB of RAM
# even with send_to_logfire=False).
LOGFIRE_TOKEN=

# Read token for Logfire Query API (enables trace analytics in the Overseer dashboard)
# Get from: Project Settings > Read Tokens in Logfire
# LOGFIRE_READ_TOKEN=

# Logfire project URL for linking to the dashboard
# LOGFIRE_PROJECT_URL=https://logfire.pydantic.dev/myorg/myproject

# OTEL span buffer limits. Defaults are tuned to keep a 512 MiB
# webserver stable even when Logfire is slow or unreachable. Bump
# only if you have sized the container higher and want bigger batches.
# OTEL_BSP_MAX_QUEUE_SIZE=1024
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE=256
# OTEL_BSP_EXPORT_TIMEOUT=10000
# OTEL_BSP_SCHEDULE_DELAY=5000
{%- endif %}

# Authentication
{%- if include_auth %}
# Auth service is included. Set to false to bypass login locally
# (you'll be signed in as a synthetic admin dev user).
AUTH_ENABLED=true
{%- else %}
# Auth service not included. A synthetic admin dev user is used so
# handlers reading current_user don't crash. Leave as false.
AUTH_ENABLED=false
{%- endif %}

# API Keys and Secrets (add as needed)
# SECRET_KEY=your-super-secret-key-here
# API_KEY=your-api-key-here

{%- if include_ai %}
# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================

# AI Service Settings
AI_ENABLED=true
{%- set _first_provider = (ai_providers.split(",")[0] | trim) or "public" %}
AI_PROVIDER={{ _first_provider }}  # Primary provider: openai, anthropic, google, groq, mistral, cohere, ollama (local), public (LLM7.io), pollinations
{%- if _first_provider == "ollama" %}
# Ollama runs whatever you have pulled, so this must be a real local tag.
# List them with `ollama list`, then either edit this value or switch at
# runtime with `{{ project_slug }} llm sync --source=ollama` followed by
# `{{ project_slug }} llm use <tag>`.
AI_MODEL=llama3.2:3b  # Model to use (ollama: the full pulled tag, including the size suffix)
{%- else %}
AI_MODEL=auto  # Model to use (public/LLM7.io provider uses available free models)
{%- endif %}
AI_TEMPERATURE=0.7  # Response creativity (0.0-2.0)
AI_MAX_TOKENS=4906  # Maximum response length
AI_TIMEOUT_SECONDS=120.0  # Request timeout

# Conversation Management
AI_MAX_CONVERSATION_LENGTH=50  # Max messages per conversation
AI_CONVERSATION_TIMEOUT_HOURS=24  # Auto-cleanup old conversations

# Provider API Keys (optional - many offer free tiers)
# The public provider (LLM7.io) works keyless on its free anonymous tier
# (open-weight models, strict rate limits). An optional free account key
# from https://dash.llm7.io unlocks premium models and higher limits.
LLM7_API_KEY=
# The pollinations provider also works keyless on its free anonymous tier
# (open-weight models, per-IP rate limits, no streaming). An optional key
# selects a Pollinations account tier.
POLLINATIONS_API_KEY=
# Get your API keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Google: https://aistudio.google.com/app/apikey
# - Groq: https://console.groq.com/keys (FREE - Recommended for getting started)
# - Mistral: https://console.mistral.ai/api-keys/
# - Cohere: https://dashboard.cohere.com/api-keys

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AI...
# GROQ_API_KEY=gsk_...  # FREE tier available!
# MISTRAL_API_KEY=...
# COHERE_API_KEY=...

{% if ollama_mode != "none" %}
# Ollama Configuration (Local LLM Inference)
{% if ollama_mode == "host" %}
# Connecting to Ollama on host machine (Mac/Windows Docker Desktop)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Host-side CLI commands auto-resolve to localhost on the port `make serve`
# published (see .env.ports). Only uncomment to pin a different local URL.
# OLLAMA_BASE_URL_LOCAL=http://localhost:11434
{% elif ollama_mode == "docker" %}
# Connecting to Ollama Docker container
OLLAMA_BASE_URL=http://ollama:11434
# Host-side CLI commands auto-resolve to localhost on the port `make serve`
# published (see .env.ports). Only uncomment to pin a different local URL.
# OLLAMA_BASE_URL_LOCAL=http://localhost:11434
{% endif %}
{% endif %}

# Provider-Specific Notes:
# - Public (LLM7.io): Works immediately without API keys (free endpoint, actual model varies)
# - Pollinations: Works immediately without API keys (open-weight models, no streaming)
# - Groq: Free tier with fast inference
# - Google: Free tier covers Gemini Flash models only
# - OpenAI: Requires paid account but excellent quality
# - Anthropic: Requires paid account, very good for reasoning
# - Mistral: Good open source models, some free options
# - Cohere: Enterprise focused, limited free tier
# - Ollama: Free local inference, requires Ollama installed (https://ollama.com)
{% endif %}

{% if ai_rag %}
# =============================================================================
# RAG SERVICE CONFIGURATION
# =============================================================================

# RAG Service Settings
RAG_ENABLED=true
RAG_PERSIST_DIRECTORY=./data/chromadb
RAG_EMBEDDING_PROVIDER=sentence-transformers  # or "openai"
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5  # Free, local embedding model

# Optional Hugging Face read token. Authenticates the embedding-model download
# so RAG drops the "unauthenticated requests" warning and gets higher rate
# limits. Public models download fine without it. Create one (Read scope) at
# https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxx

# Model cache directory for local development
# Uncomment to use a local cache (Docker uses system default)
# RAG_MODEL_CACHE_DIR=./data/models

# Chunking settings
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=400
RAG_DEFAULT_TOP_K=15
RAG_CHAT_TOP_K=15
{% endif %}

{% if include_comms %}
# =============================================================================
# COMMUNICATIONS SERVICE CONFIGURATION
# =============================================================================

# Email Service (Resend)
# Sign up at https://resend.com (free tier: 100 emails/day)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@yourdomain.com  # Must be a verified domain in Resend

# SMS/Voice Service (Twilio)
# Sign up at https://twilio.com/try-twilio ($15 free trial credit)
# Buy a toll-free number to stay on trial (avoids A2P 10DLC registration)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+18001234567  # Your toll-free Twilio number (E.164 format)
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Required for SMS
{% endif %}

{% if include_insights %}
# =============================================================================
# INSIGHTS SERVICE CONFIGURATION
# =============================================================================

{% if insights_github %}
# GitHub API (required for traffic + stargazer collection)
# Create a PAT at https://github.com/settings/tokens with 'repo' scope
# INSIGHT_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSIGHT_GITHUB_OWNER=your-username
INSIGHT_GITHUB_REPO=your-repo
INSIGHT_COLLECTION_GITHUB_HOURS=6
{% endif %}

{% if insights_pypi %}
# PyPI package tracking
INSIGHT_PYPI_PACKAGE=your-package-name
INSIGHT_COLLECTION_PYPI_HOURS=24
{% endif %}

{% if insights_plausible %}
# Plausible Analytics (requires API key from your Plausible dashboard)
# INSIGHT_PLAUSIBLE_API_KEY=your-api-key
INSIGHT_PLAUSIBLE_SITES=your-site.example.com
INSIGHT_COLLECTION_PLAUSIBLE_HOURS=24
{% endif %}
{% endif %}

{% if include_payment %}
# =============================================================================
# PAYMENT SERVICE CONFIGURATION
# =============================================================================

# --- Stripe: Secret key (from dashboard signup) ---
# New Stripe accounts default to TEST mode — leave the dashboard's
# "Test mode" toggle on until you're ready to take real payments.
# Test keys are prefixed sk_test_ / pk_test_; live keys use sk_live_ / pk_live_.
# The dashboard gives you two keys; you only need the SECRET key.
# The "Publishable key" (pk_test_...) is NOT used by this service.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Stripe: Webhook signing secret (obtained separately) ---
# Local dev: run `stripe listen --forward-to localhost:8000/api/v1/payment/webhook`
#            and copy the whsec_... it prints.
# Prod: configure a webhook endpoint in the Stripe dashboard and copy its signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Payment: default redirect URLs ---
# Used when POST /api/v1/payment/checkout does not provide success_url / cancel_url.
# The defaults point at the bundled HTML pages at /payment/success and /payment/cancel.
# Override for production (e.g., https://mysite.com/thanks).
# PAYMENT_SUCCESS_URL=http://localhost:8000/payment/success?session_id={CHECKOUT_SESSION_ID}
# PAYMENT_CANCEL_URL=http://localhost:8000/payment/cancel
{% endif %}
{% if include_finance %}
# =============================================================================
# FINANCE SERVICE CONFIGURATION
# =============================================================================

# Reporting currency for net-worth rollups (ISO-4217, lowercase).
FINANCE_DEFAULT_CURRENCY=usd

# Days of history the reconciliation alerts consider: transfer suggestions,
# fee alerts, and missed-bill checks. 0 = full history.
# FINANCE_RULES_LOOKBACK_DAYS=31
{%- if finance_plaid %}

# --- Plaid: bank / credit / investment account linking ---
# Sign up at https://dashboard.plaid.com. Sandbox keys need no approval.
# PLAID_ENV=production requires real credentials (startup validator enforces).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Webhooks (optional): Plaid pushes real-time sync nudges + item-health events
# to a public URL. In local dev this is AUTOMATED: the dev compose overlay runs
# a cloudflared quick-tunnel sidecar (`plaid-tunnel`), and at startup the
# backend discovers its public hostname, routes new link tokens through it, and
# repoints existing items - no configuration needed. Set PLAID_WEBHOOK_URL only
# for a static public URL (production, or your own tunnel). Deliveries are
# signed (ES256) and verified. Without any webhook path the nightly sync and
# manual `finance sync` still cover everything, just without the real-time
# nudge. Test delivery end to end: `finance fire-webhook` (sandbox only).
# PLAID_WEBHOOK_URL=https://mysite.com/api/v1/finance/webhook/plaid
# PLAID_REDIRECT_URI=https://mysite.com/finance/oauth-return
{%- endif %}
{%- if finance_snaptrade %}

# --- SnapTrade: brokerage linking (the Fidelity path) ---
# Application-gated; request access at https://snaptrade.com.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
{%- endif %}
{% endif %}

{%- if include_worker %}
# =============================================================================
# WORKER SETTINGS
# =============================================================================
{%- if worker_backend == "taskiq" %}

# Worker processes - controls parallelism for CPU-bound tasks (TaskIQ only)
# Each process has its own Python GIL, enabling true parallelism
# LOAD_TEST_WORKER_PROCESSES=4  # Load test worker (default: 4)
# SYSTEM_WORKER_PROCESSES=2     # System worker (default: 2)
{%- elif worker_backend == "dramatiq" %}

# Worker processes and threads (Dramatiq)
# Each process has its own Python GIL; threads handle async I/O within a process
# LOAD_TEST_WORKER_PROCESSES=4  # Load test worker processes (default: 4)
# LOAD_TEST_WORKER_THREADS=8    # Load test worker threads per process (default: 8)
# SYSTEM_WORKER_PROCESSES=2     # System worker processes (default: 2)
# SYSTEM_WORKER_THREADS=4       # System worker threads per process (default: 4)
{%- endif %}

# Worker timeouts and retries
# LOAD_TEST_WORKER_TIMEOUT=60   # Load test timeout in seconds
# SYSTEM_WORKER_TIMEOUT=1800    # System worker timeout (30 min for long tasks)
# LOAD_TEST_WORKER_MAX_TRIES=1  # Load test retries (1 = no retry)
# SYSTEM_WORKER_MAX_TRIES=5     # System worker retries

# Worker health check settings
# WORKER_HEALTH_CHECK_INTERVAL=15  # Health check interval in seconds (default: 15)
{%- endif %}

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================

# Worker auto-reload settings
# WORKER_WATCH=false  # Disable worker auto-reload (useful for debugging)

# Override for local development
# Use this to point to local services instead of Docker services
# DATABASE_HOST=host.docker.internal  # For connecting to host DB from container