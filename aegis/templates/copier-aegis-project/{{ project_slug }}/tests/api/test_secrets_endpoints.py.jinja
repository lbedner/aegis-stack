{%- if include_auth %}
"""The secrets API: admins set, delete and list declared credentials. No
response ever contains a stored value: status carries the source, the last
four characters, and who set it when."""

from collections.abc import AsyncIterator

from fastapi.testclient import TestClient
import pytest
from sqlmodel import select

from app.components.secrets import store as store_module
from app.components.secrets.models import SecretRecord
from app.core import encryption, secrets
from app.core.cache import get_cache
from app.core.config import settings
from app.core.db import get_async_session
from app.core.secrets import Secret
from app.models.user import User
from app.services.auth.deps import require_admin

# One row written then read back per test: the scenario, not an N+1.
pytestmark = pytest.mark.queryspy(allow_n_plus_one=True)

KEY = "sk-live-0123456789abcdWXYZ"
DECLARED = (
    Secret("TEST_API_KEY", owner="Test"),
    Secret("TEST_FROM_EMAIL", owner="Test", secret=False),
)
ADMIN = User(id=7, email="ops@example.com", hashed_password="x", is_active=True)


@pytest.fixture
async def store(monkeypatch: pytest.MonkeyPatch) -> AsyncIterator[None]:
    monkeypatch.setitem(settings.__dict__, "ENCRYPTION_KEY", "test-encryption-key-0123456789")
    encryption._reset_cache()
    monkeypatch.setattr(secrets, "declared", lambda: DECLARED)
    secrets.set_store(None)
    assert store_module.install() is None
    yield
    secrets.set_store(None)
    async with get_async_session() as db:
        for row in (await db.exec(select(SecretRecord))).all():
            await db.delete(row)
        await db.commit()
    await get_cache().invalidate_prefix(store_module.CACHE_PREFIX)
    encryption._reset_cache()


@pytest.fixture
def admin(client: TestClient, store: None) -> TestClient:
    client.app.dependency_overrides[require_admin] = lambda: ADMIN
    return client


def test_setting_a_secret_returns_its_status_never_the_value(admin: TestClient) -> None:
    response = admin.put("/api/v1/secrets/TEST_API_KEY", json={"value": KEY})
    assert response.status_code == 200, response.text
    body = response.json()
    assert (body["source"], body["hint"], body["set_by"]) == (
        "database",
        "WXYZ",
        "ops@example.com",
    )
    assert KEY not in response.text


def test_the_list_never_contains_a_value(admin: TestClient) -> None:
    admin.put("/api/v1/secrets/TEST_API_KEY", json={"value": KEY})
    response = admin.get("/api/v1/secrets")
    assert response.status_code == 200
    names = {row["name"]: row for row in response.json()}
    assert names["TEST_API_KEY"]["source"] == "database"
    assert names["TEST_FROM_EMAIL"]["source"] is None
    assert KEY not in response.text


def test_delete_removes_it(admin: TestClient) -> None:
    admin.put("/api/v1/secrets/TEST_API_KEY", json={"value": KEY})
    assert admin.delete("/api/v1/secrets/TEST_API_KEY").status_code == 204
    names = {row["name"]: row for row in admin.get("/api/v1/secrets").json()}
    assert names["TEST_API_KEY"]["source"] is None


def test_an_undeclared_name_is_404(admin: TestClient) -> None:
    assert admin.put("/api/v1/secrets/PATH", json={"value": "x"}).status_code == 404


def test_a_name_set_in_env_refuses_with_the_reason(
    admin: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setitem(settings.__dict__, "TEST_API_KEY", "from-env-0000000000")
    response = admin.put("/api/v1/secrets/TEST_API_KEY", json={"value": KEY})
    assert response.status_code == 409
    assert ".env" in response.json()["detail"]


def test_an_empty_value_is_refused(admin: TestClient) -> None:
    assert admin.put("/api/v1/secrets/TEST_API_KEY", json={"value": ""}).status_code == 422


async def _refuses(value: str) -> None:
    raise secrets.SecretRejectedError("api.example.com refused it (401).")


async def _accepts(value: str) -> None:
    return None


def _checked(monkeypatch: pytest.MonkeyPatch, verify: object) -> None:
    monkeypatch.setattr(
        secrets,
        "declared",
        lambda: (Secret("TEST_API_KEY", owner="Test", needed=True, verify=verify),),
    )


def test_a_refused_key_is_422_and_not_stored(
    admin: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    _checked(monkeypatch, _refuses)
    response = admin.put("/api/v1/secrets/TEST_API_KEY", json={"value": KEY})
    assert response.status_code == 422
    assert "refused" in response.json()["detail"]
    (row,) = admin.get("/api/v1/secrets").json()
    assert row["source"] is None and row["needed"] and row["verifiable"]


def test_a_saved_key_carries_its_check(
    admin: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    _checked(monkeypatch, _accepts)
    response = admin.put("/api/v1/secrets/TEST_API_KEY", json={"value": KEY})
    assert response.status_code == 200, response.text
    assert response.json()["check"]["result"] == secrets.VERIFIED


def test_test_checks_the_key_in_effect(
    admin: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    _checked(monkeypatch, _accepts)
    admin.put("/api/v1/secrets/TEST_API_KEY", json={"value": KEY})
    response = admin.post("/api/v1/secrets/TEST_API_KEY/test")
    assert response.status_code == 200
    assert response.json()["result"] == secrets.VERIFIED
    assert admin.post("/api/v1/secrets/PATH/test").status_code == 404


def test_a_non_admin_is_refused(
    authenticated_client: TestClient, store: None, monkeypatch: pytest.MonkeyPatch
) -> None:
    if "role" in User.model_fields:
        pytest.skip("under RBAC the seeded client signs in as an admin")
    monkeypatch.setitem(settings.__dict__, "AUTH_ENABLED", True)
    monkeypatch.setitem(settings.__dict__, "ADMIN_USER_EMAILS", [])
    assert authenticated_client.get("/api/v1/secrets").status_code == 403
    response = authenticated_client.put("/api/v1/secrets/TEST_API_KEY", json={"value": KEY})
    assert response.status_code == 403
