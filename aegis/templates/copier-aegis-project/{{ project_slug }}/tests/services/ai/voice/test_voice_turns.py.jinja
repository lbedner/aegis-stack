@pytest.mark.asyncio
async def test_the_turn_carries_its_context_and_the_hint(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    service = AIService(settings)
    stt, _ = _voiced(service)
    seen: dict[str, Any] = {}

    async def _chat(**kwargs: Any) -> Any:
        from app.services.ai.models import ConversationMessage, MessageRole

        seen.update(kwargs)
        return ConversationMessage(
            id="m-1",
            role=MessageRole.ASSISTANT,
            content="ok",
            metadata={"conversation_id": "c-1"},
        )

    monkeypatch.setattr(service, "chat", _chat)
    await service.voice_chat(
        audio=AudioInput(content=b"wav", format=AudioFormat.WAV),
        conversation_id="c-1",
        user_id=OWNER,
        agent_slug=AGENT,
        surface=SURFACE,
        transcription_hint="Aegis, Illiana",
    )

    expected = {
        "message": QUESTION,
        "conversation_id": "c-1",
        "user_id": OWNER,
        "agent_slug": AGENT,
        "surface": SURFACE,
    }
    assert {key: seen[key] for key in expected} == expected
    assert stt.calls[0][0].prompt == "Aegis, Illiana"


@pytest.mark.asyncio
async def test_speaking_an_answer_asks_no_model(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """Answers were rewritten for speech by a second chat turn, persisted
    as its own conversation outside the agent. Markdown is stripped here,
    and the agent's own words are what gets said."""
    service = AIService(settings)

    async def _no_chat(**kwargs: Any) -> Any:
        raise AssertionError("prepare_for_voice must not start a conversation")

    monkeypatch.setattr(service, "chat", _no_chat)
    spoken = await service.prepare_for_voice(
        "## Travel\n\n- **$212** left, see [the fund](/funds).\n"
        "```python\nx = 1\n```\n1. Next: `groceries`"
    )

    assert spoken == "Travel. $212 left, see the fund. Next: groceries"


@pytest.mark.parametrize(
    "hostile",
    [
        "[" * 40_000,
        "[\\" * 20_000,
        "](" * 20_000,
        " " * 40_000 + "x",
        "|" + " " * 40_000,
    ],
    ids=["brackets", "escaped-brackets", "link-shells", "spaces", "table-spaces"],
)
def test_stripping_is_linear_on_hostile_text(hostile: str) -> None:
    """Text a model wrote is spoken through these patterns, so they must
    not go quadratic on a long run of brackets or spaces."""
    import time

    start = time.perf_counter()
    to_spoken(hostile)
    assert time.perf_counter() - start < 0.5


def test_links_and_tables_still_read_as_words() -> None:
    said = to_spoken(
        "See [the fund](/funds/1) and ![a chart](x.png).\n| a | b |\n|---|:--|\n| 1 | 2 |"
    )
    assert said == "See the fund and a chart. a b. 1 2"


def test_a_long_answer_ends_at_a_sentence() -> None:
    said = to_spoken("One sentence here. " * 40, max_chars=100)
    assert len(said) <= 100 and said.endswith(".")
