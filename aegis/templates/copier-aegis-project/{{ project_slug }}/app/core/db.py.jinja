{% if postgres_provider == "neon" %}
def _is_neon(database_url: str) -> bool:
    """True when the URL targets Neon's cloud (vs a local dev container).

    Lets one generated codebase apply Neon's pooler/TLS connect args in
    production while running unchanged against the local postgres container in
    development.
    """
    return ".neon.tech" in database_url


def _strip_libpq_ssl_params(database_url: str) -> str:
    """Drop sslmode/channel_binding query params (asyncpg cannot accept them)."""
    from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit

    parts = urlsplit(database_url)
    kept = [
        (key, value)
        for key, value in parse_qsl(parts.query, keep_blank_values=True)
        if key not in {"sslmode", "channel_binding"}
    ]
    return urlunsplit(parts._replace(query=urlencode(kept)))


def _neon_async_connect_args(database_url: str) -> dict[str, Any]:
    """asyncpg connect args for Neon's pooled (PgBouncer transaction-mode) endpoint.

    Disables the driver-side prepared-statement cache and gives each prepared
    statement a unique name so pooled backends cannot collide, and configures TLS
    (asyncpg ignores sslmode in the URL). Empty for a local container so the same
    code path works in development.
    """
    if not _is_neon(database_url):
        return {}
    return {
        "ssl": ssl.create_default_context(),
        "statement_cache_size": 0,
        "prepared_statement_cache_size": 0,
        "prepared_statement_name_func": lambda: f"__asyncpg_{uuid.uuid4()}__",
    }


def _neon_sync_connect_args(database_url: str) -> dict[str, Any]:
    """psycopg2 connect args for Neon (TLS required); empty for a local container."""
    if not _is_neon(database_url):
        return {}
    return {"sslmode": "require"}


