"""The sign-in page's "Continue as guest" (``auth[guest]``): the button,
Cloudflare's widget only with its keys, and a refusal that says why."""

from typing import Any

from fastapi import HTTPException
from fastapi.testclient import TestClient
import pytest

from app.components.backend.api.auth import guest as api_guest
from app.components.backend.security import turnstile
from app.components.web_frontend.routes import guest
from app.core.config import settings


def test_the_page_offers_guest_sign_in(
    client: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setattr(settings, "GUEST_ON_SIGN_IN_PAGE", True)
    page = client.get("/login").text
    assert 'action="/login/guest"' in page
    assert "cf-turnstile" not in page


def test_an_app_whose_guests_start_elsewhere_keeps_the_page_to_members(
    client: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    """A chat panel can start the guest session itself; the page then
    offers no button."""
    monkeypatch.setattr(settings, "GUEST_ON_SIGN_IN_PAGE", False)
    assert 'action="/login/guest"' not in client.get("/login").text


def test_an_app_whose_guests_start_elsewhere_refuses_the_form(
    client: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    """Hiding the button closes its form too; the API stays the way in."""
    monkeypatch.setattr(settings, "GUEST_ON_SIGN_IN_PAGE", False)
    assert client.post("/login/guest", follow_redirects=False).status_code == 404


def test_the_human_checks_key_is_blank_while_it_is_off(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setattr(settings, "TURNSTILE_SITE_KEY", "site-key")
    monkeypatch.setattr(settings, "TURNSTILE_SECRET_KEY", "")
    assert turnstile.site_key() == ""
    monkeypatch.setattr(settings, "TURNSTILE_SECRET_KEY", "secret")
    assert turnstile.site_key() == "site-key"


def test_with_its_keys_the_page_carries_the_human_check(
    client: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setattr(settings, "GUEST_ON_SIGN_IN_PAGE", True)
    monkeypatch.setattr(settings, "TURNSTILE_SITE_KEY", "site-key")
    monkeypatch.setattr(settings, "TURNSTILE_SECRET_KEY", "secret")
    assert 'data-sitekey="site-key"' in client.get("/login").text


@pytest.mark.parametrize(
    ("status_code", "reason"),
    [(429, "guest_limited"), (403, "guest_human"), (403, "guest_closed")],
)
def test_a_refused_guest_goes_back_saying_why(
    client: TestClient, monkeypatch: pytest.MonkeyPatch, status_code: int, reason: str
) -> None:
    async def refuse(**_: Any) -> None:
        raise HTTPException(status_code=status_code, detail=reason)

    monkeypatch.setattr(settings, "GUEST_ON_SIGN_IN_PAGE", True)
    monkeypatch.setattr(api_guest, "guest_sign_in", refuse)
    response = client.post("/login/guest", follow_redirects=False)
    assert response.headers["location"] == f"/login?error={reason}"
