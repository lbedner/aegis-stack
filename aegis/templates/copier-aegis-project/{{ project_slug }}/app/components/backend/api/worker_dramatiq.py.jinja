{%- if include_worker %}
"""Worker task API endpoints for Dramatiq backend."""

import asyncio
from datetime import datetime

from fastapi import APIRouter, HTTPException

from app.components.backend.api.models import (
    TaskListResponse,
    TaskRequest,
    TaskResponse,
    TaskResultResponse,
    TaskStatusResponse,
)
from app.components.backend.api.worker_load_test import router as load_test_router
from app.components.worker.pools import enqueue_task, get_broker, get_task
from app.components.worker.tasks import get_task_by_name, list_available_tasks
from app.core.constants import QueueName
from app.core.log import logger

router = APIRouter(prefix="/tasks", tags=["worker"])


@router.get("/", response_model=TaskListResponse)
async def list_tasks() -> TaskListResponse:
    """Get list of all available background tasks."""
    available_tasks = list_available_tasks()

    from app.components.worker.tasks import get_queue_for_task
    from app.core.config import get_available_queues

    queues: dict[str, list[str]] = {
        queue_type: [] for queue_type in get_available_queues()
    }

    for task in available_tasks:
        queue_type = get_queue_for_task(task)
        queues[queue_type].append(task)

    return TaskListResponse(
        available_tasks=available_tasks,
        total_count=len(available_tasks),
        queues=queues,
    )


@router.post("/enqueue", response_model=TaskResponse)
async def enqueue_task_endpoint(task_request: TaskRequest) -> TaskResponse:
    """Enqueue a background task for processing."""
    logger.info(
        f"Enqueueing task: {task_request.task_name} (queue: {task_request.queue_type})"
    )

    task_func = get_task_by_name(task_request.task_name)
    if not task_func:
        available_tasks = list_available_tasks()
        raise HTTPException(
            status_code=400,
            detail={
                "error": "invalid_task_name",
                "message": f"Task '{task_request.task_name}' not found",
                "available_tasks": available_tasks,
            },
        )

    from app.core.config import get_available_queues, is_valid_queue

    if not is_valid_queue(task_request.queue_type):
        available_queues = get_available_queues()
        raise HTTPException(
            status_code=400,
            detail={
                "error": "invalid_queue_type",
                "message": f"Queue type must be one of: {available_queues}",
            },
        )

    try:
        # Use Dramatiq's send() via our async wrapper
        msg = await enqueue_task(
            task_request.task_name,
            task_request.queue_type,
            *task_request.args,
            delay_seconds=task_request.delay_seconds,
            **task_request.task_kwargs,
        )

        queued_at = datetime.now()

        logger.info(f"Task enqueued: {msg.message_id} ({task_request.task_name})")

        return TaskResponse(
            task_id=msg.message_id,
            task_name=task_request.task_name,
            queue_type=task_request.queue_type,
            queued_at=queued_at,
            estimated_start=None,
            message=(
                f"Task '{task_request.task_name}' enqueued to "
                f"{task_request.queue_type} queue"
            ),
        )

    except Exception as e:
        logger.error(f"Failed to enqueue task {task_request.task_name}: {e}")
        raise HTTPException(
            status_code=500,
            detail={
                "error": "enqueue_failed",
                "message": f"Failed to enqueue task: {str(e)}",
            },
        )


@router.get("/status/{task_id}", response_model=TaskStatusResponse)
async def get_task_status(
    task_id: str,
    actor_name: str = "",
    queue_name: str = QueueName.SYSTEM,
) -> TaskStatusResponse:
    """Get the status of a background task.

    Dramatiq result keys are hashed from queue_name + actor_name + message_id,
    so both must match the values used when the task was enqueued.
    """
    if not actor_name:
        raise HTTPException(
            status_code=400,
            detail={
                "error": "missing_actor_name",
                "message": "actor_name query parameter is required for Dramatiq result lookup",
            },
        )

    try:
        import dramatiq
        from dramatiq.results import ResultMissing

        backend = None
        for middleware in dramatiq.get_broker().middleware:
            if isinstance(middleware, dramatiq.results.Results):
                backend = middleware.backend
                break

        if backend is None:
            raise HTTPException(
                status_code=500,
                detail={
                    "error": "no_result_backend",
                    "message": "Result backend not configured",
                },
            )

        # Check if result exists
        try:
            # Only whether it raises matters here; the payload is fetched by
            # the result route below.
            await asyncio.to_thread(
                backend.get_result,
                dramatiq.Message(
                    queue_name=queue_name,
                    actor_name=actor_name,
                    args=(),
                    kwargs={},
                    options={},
                    message_id=task_id,
                ),
                block=False,
            )
            status = "complete"
            error = None
            result_available = True
        except ResultMissing:
            status = "queued"
            error = None
            result_available = False
        except Exception:
            status = "queued"
            error = None
            result_available = False

        return TaskStatusResponse(
            task_id=task_id,
            status=status,
            result_available=result_available,
            error=error,
            enqueue_time=None,
            start_time=None,
            finish_time=None,
        )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Failed to get task status for {task_id}: {e}")
        raise HTTPException(
            status_code=500, detail={"error": "status_check_failed", "message": str(e)}
        )


@router.get("/result/{task_id}", response_model=TaskResultResponse)
async def get_task_result(
    task_id: str,
    actor_name: str = "",
    queue_name: str = QueueName.SYSTEM,
) -> TaskResultResponse:
    """Get the result of a completed background task.

    Dramatiq result keys are hashed from queue_name + actor_name + message_id,
    so both must match the values used when the task was enqueued.
    """
    if not actor_name:
        raise HTTPException(
            status_code=400,
            detail={
                "error": "missing_actor_name",
                "message": "actor_name query parameter is required for Dramatiq result lookup",
            },
        )

    try:
        import dramatiq
        from dramatiq.results import ResultMissing

        backend = None
        for middleware in dramatiq.get_broker().middleware:
            if isinstance(middleware, dramatiq.results.Results):
                backend = middleware.backend
                break

        if backend is None:
            raise HTTPException(
                status_code=500,
                detail={
                    "error": "no_result_backend",
                    "message": "Result backend not configured",
                },
            )

        try:
            result = await asyncio.to_thread(
                backend.get_result,
                dramatiq.Message(
                    queue_name=queue_name,
                    actor_name=actor_name,
                    args=(),
                    kwargs={},
                    options={},
                    message_id=task_id,
                ),
                block=False,
            )
        except ResultMissing:
            raise HTTPException(
                status_code=404,
                detail={
                    "error": "task_not_found",
                    "message": f"Task {task_id} not found or result expired",
                },
            )
        except Exception as e:
            raise HTTPException(
                status_code=404,
                detail={
                    "error": "task_not_found",
                    "message": f"Task {task_id} not found or result expired: {e}",
                },
            )

        # Try to serialize result
        try:
            import json

            json.dumps(result)
            result_data = result
        except (TypeError, ValueError):
            result_data = {
                "result_type": type(result).__name__,
                "result_str": str(result),
                "note": "Result was not JSON-serializable, converted to string",
            }

        return TaskResultResponse(
            task_id=task_id,
            status="completed",
            result=result_data,
            enqueue_time=None,
            start_time=None,
            finish_time=None,
        )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Failed to get task result for {task_id}: {e}")
        raise HTTPException(
            status_code=500, detail={"error": "result_fetch_failed", "message": str(e)}
        )



# The load-test endpoints are the same on every backend.
router.include_router(load_test_router)
{%- endif %}
