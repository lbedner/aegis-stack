"""
The inference health check for {{ project_name }}: one check for the
component, each engine it tracks a sub-component named for its server (the
text engine by its ``inference[...]`` name, the speech and hearing servers
by their slugs).
"""
{% if ollama_mode != "none" %}
from __future__ import annotations

import asyncio
from typing import TYPE_CHECKING

from app.core.config import settings
from app.core.constants import ComponentName
from app.core.log import logger

from .health_hearing import check_hearing_health
from .health_speech import check_speech_health
from .models import ComponentStatus, ComponentStatusType

if TYPE_CHECKING:
    from app.components.inference.engine import InferenceServerStatus


async def check_inference_health() -> ComponentStatus:
    """Every engine the component tracks, read together so one failing
    leaves the others' readings: the app's text engine, and the speech and
    hearing servers where each is set."""
    engine, *servers = await asyncio.gather(
        _engine_health(), check_speech_health(), check_hearing_health()
    )
    return inference_status(engine, *(s for s in servers if s is not None))


def inference_status(
    engine: ComponentStatus, *others: ComponentStatus
) -> ComponentStatus:
    """The check from its engines' statuses: it reads as the text engine
    (the app's chat runs on it, and every reader of the check finds its
    version and models here), each engine a sub-component under it."""
    return ComponentStatus(
        name=ComponentName.INFERENCE,
        status=engine.status,
        message=engine.message,
        response_time_ms=None,
        metadata=engine.metadata,
        sub_components={e.name: e for e in (engine, *others)},
    )


async def _engine_health() -> ComponentStatus:
    try:
        from app.components.inference import get_inference_engine

        engine = get_inference_engine()
        return engine_status(await engine.get_server_status(), engine.base_url)
    except Exception as e:
        logger.error(f"Inference health check failed: {e}")
        return ComponentStatus(
            name=settings.INFERENCE_ENGINE,
            status=ComponentStatusType.UNHEALTHY,
            message=f"Inference health check failed: {str(e)}",
            response_time_ms=None,
            metadata={"error": str(e)},
        )


def engine_status(
    server_status: InferenceServerStatus, base_url: str
) -> ComponentStatus:
    """A server reading as a health status: the check's, and the Flet
    modal's from the inference sampler's last reading. Named for the app's
    engine, and saying whether it loads and frees models on request."""
    from app.components.inference import inference_engine_class

    engine = inference_engine_class()
    if not server_status.available:
        return ComponentStatus(
            name=engine.NAME,
            status=ComponentStatusType.UNHEALTHY,
            message=f"{engine.LABEL} server not reachable",
            response_time_ms=None,
            metadata={
                "available": False,
                "base_url": base_url,
                "error": "Connection failed",
            },
        )

    running_models_info = [
        m.model_dump(include={"name", "size_vram_gb", "is_warm", "context_length", "details"})
        for m in server_status.running_models
    ]
    installed_models_info = [
        m.model_dump(
            include={
                "name",
                "size_gb",
                "details",
                # What `ollama list` prints and the table could not show:
                # the digest tells two pulls of one tag apart, and the
                # timestamp is how you spot a model that has gone stale.
                "digest",
                "modified_at",
                "capabilities",
            },
            mode="json",
        )
        for m in server_status.installed_models
    ]

    if server_status.running_models:
        status = ComponentStatusType.HEALTHY
        primary_model = server_status.running_models[0]
        vram = primary_model.size_vram_gb
        message = (
            f"{primary_model.name} • {vram:.1f}GB VRAM • warm"
            if vram
            else f"{primary_model.name} • warm"
        )
    elif server_status.installed_models_count > 0:
        status = ComponentStatusType.INFO
        message = f"{engine.LABEL} ready • {server_status.installed_models_count} models installed • none loaded"
    else:
        status = ComponentStatusType.WARNING
        message = f"{engine.LABEL} running but no models installed"

    return ComponentStatus(
        name=engine.NAME,
        status=status,
        message=message,
        response_time_ms=None,
        metadata={
            "available": True,
            "base_url": base_url,
            "version": server_status.version,
            "running_models": running_models_info,
            "running_models_count": len(server_status.running_models),
            "installed_models": installed_models_info,
            "installed_models_count": server_status.installed_models_count,
            "total_vram_gb": round(server_status.total_vram_gb, 2),
            "can_load_unload": server_status.can_load_unload,
        },
    )
{% endif %}
