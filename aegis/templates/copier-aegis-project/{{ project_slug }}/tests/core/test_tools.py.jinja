def _import_every_registrant() -> None:
    """Import each app module that registers tools, so all are counted."""
    root = Path(app.__file__).parent
    for path in root.rglob("*.py"):
        if "register_tool(" in path.read_text():
            rel = path.relative_to(root.parent).with_suffix("")
            importlib.import_module(".".join(rel.parts))


def _app_tools() -> dict[str, str]:
    """Every tool the app's own modules register, by its effect."""
    _import_every_registrant()
    return {
        name: tool.effect
        for name in registered_tool_names()
        if (tool := get_tool(name)) is not None
        and tool.func.__module__.startswith("app.")
    }


def test_every_registered_app_tool_declares_its_expected_effect() -> None:
    # No ``clean_registry``: the sweep's imports register for good.
    declared = _app_tools()

    if not declared:
        pytest.skip("no service in this project registers tools")
    assert declared == {n: EXPECTED_EFFECTS.get(n) for n in declared}


# The tools whose results name approval cards (``register_tool(cards=)``),
# drawn by every chat UI. ``withdraw`` proposes too, and draws none.
EXPECTED_CARDS = frozenset(
    {
        "propose",
        "propose_many",
        "pending",
        "save_memory",
        "replace_memory",
        "update_memory",
        "forget_memory",
    }
)


def test_every_card_tool_says_so_at_registration() -> None:
    declared = _app_tools()

    if not declared:
        pytest.skip("no service in this project registers tools")
    assert card_tool_names() & set(declared) == EXPECTED_CARDS & set(declared)


def test_load_tools_registers_every_tool_the_app_defines() -> None:
    """``load_tools`` is how a process that never builds a chat agent (the
    MCP server) gets the whole registry: a module missing from it is a
    tool no outside assistant can be granted. Run fresh, since this
    process has imported the registrants already."""
    defined = set(_app_tools())
    script = (
        "import json; from app.core.tools import load_tools, "
        "registered_tool_names; load_tools(); "
        "print(json.dumps(registered_tool_names()))"
    )

    done = subprocess.run(
        [sys.executable, "-c", script], capture_output=True, text=True, check=True
    )

    loaded = set(json.loads(done.stdout.strip().splitlines()[-1]))
    assert defined <= loaded


@pytest.mark.usefixtures("clean_registry")
def test_a_services_tools_module_loads_without_editing_anything(
    fake_service: Callable[..., Path],
) -> None:
    """A service, or a plugin, keeps its tools in its own ``tools.py``;
    ``load_tools`` finds it on disk, so nothing else lists it (#1420)."""
    fake_service(
        "demo_tools",
        tools=(
            "from app.core.tools import register_tool\n"
            "async def demo_lookup() -> str:\n"
            "    '''Look one thing up.'''\n"
            "    return 'found'\n"
            "register_tool('demo_lookup', demo_lookup, effect='read')\n"
        ),
    )

    load_tools()

    assert "demo_lookup" in registered_tool_names()


class _Proposed(BaseModel):
    model_config = FIGURES

    pending_change_id: int
    change_type: str
    at: datetime


def test_a_tools_model_reads_back_as_its_json() -> None:
    """A tool hands back a model: every surface that keeps or shows its
    result as text (the trace, a LangChain turn) gets its JSON, never its
    repr."""
    proposed = _Proposed(
        pending_change_id=7, change_type="tag", at=datetime(2026, 10, 26)
    )
    shape = {"pending_change_id": 7, "change_type": "tag", "at": "2026-10-26T00:00:00"}

    assert json.loads(result_text(proposed)) == shape
    assert result_data([proposed]) == [shape]
    assert result_text("refused: no such tag") == "refused: no such tag"


@pytest.mark.usefixtures("clean_registry")
def test_a_card_tools_model_still_names_its_card() -> None:
    proposed = _Proposed(
        pending_change_id=7, change_type="tag", at=datetime(2026, 10, 26)
    )
    register_tool("proposer", _echo, effect="proposes", cards=True)

    marker = card_component("proposer", proposed)

    assert isinstance(marker, dict) and marker["pending_change_id"] == 7


class _Spend(BaseModel):
    net_cents: int
    label: str


class TestWithDollars:
    """Tools keep integer cents (scripts and cards compute with them); a
    model left to convert reads an unlabelled 297614 as dollars. So what
    it reads carries each ``*_cents`` figure's dollars beside it."""

    def test_every_cents_figure_gets_its_dollars_beside_it(self) -> None:
        result = with_dollars(
            {
                "spent_cents": 297_614,
                "months": [{"month": "2026-09", "net_cents": -149_203}],
                "count": 3,
                "label": "x_cents",
            }
        )
        assert result["spent_cents"] == 297_614  # kept for the next script
        assert result["spent_usd"] == "$2,976.14"
        assert result["months"][0]["net_usd"] == "-$1,492.03"
        assert "count_usd" not in result and result["label"] == "x_cents"

    def test_only_whole_numbers_of_cents_are_money(self) -> None:
        assert with_dollars({"flag_cents": True, "odd_cents": "12"}) == {
            "flag_cents": True,
            "odd_cents": "12",
        }

    def test_a_model_is_read_as_its_data(self) -> None:
        assert with_dollars(_Spend(net_cents=-149_203, label="net")) == {
            "net_cents": -149_203,
            "label": "net",
            "net_usd": "-$1,492.03",
        }

    def test_dollars_already_beside_their_cents_are_kept(self) -> None:
        """run_code's result is its reads', joined already: kept, not redone."""
        joined = {"months": [{"net_cents": -149_203, "net_usd": "-$1,492.03"}]}
        assert with_dollars(joined) is joined

    def test_a_result_without_money_is_handed_back_as_it_is(self) -> None:
        """A model with no cents stays the model its callers type."""
        proposed = _Proposed(
            pending_change_id=7, change_type="tag", at=datetime(2026, 10, 26)
        )
        assert with_dollars(proposed) is proposed
        assert with_dollars("net_cents: -149203") == "net_cents: -149203"
