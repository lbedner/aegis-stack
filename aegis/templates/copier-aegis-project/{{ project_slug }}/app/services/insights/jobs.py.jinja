"""
Scheduler jobs for insight data collection.

Each enabled source gets a scheduled job that runs its collector
at the configured interval.
{% if insights_per_user %}

Multi-tenant when ``auth`` is on: each job is a sweep
(``ServiceJob.each``) over every project that has the relevant source
configured (e.g. ``project.github_repo`` set for the GitHub jobs), and
each project is collected on its own, on the worker a task each, so one
project's failing API holds up none of the others. A project with no
source set is never swept - collectors are only useful when their config
is present.
{% endif %}
"""

import logging

from app.core.db import get_async_session

from app.services.insights.adapters.collectors.collection import CollectorService
from .constants import SourceKeys
{% if insights_per_user -%}
from typing import Any

from app.core.schedule import read_items
from app.services.insights.service import ProjectService
{%- endif %}

logger = logging.getLogger(__name__)


async def _run_one(
    session,
    source_key: str,
    {% if insights_per_user -%}
    project,
    {%- endif %}
) -> None:
    """Run a single source collection and log the outcome.

    Used by all per-source job entry points so logging and error handling
    stay consistent across sources.
    """
    {% if insights_per_user -%}
    service = CollectorService(session, project=project)
    suffix = f" (project={project.slug})"
    {% else -%}
    service = CollectorService(session)
    suffix = ""
    {%- endif %}
    result = await service.collect_source(source_key)
    if result.skipped:
        logger.info(
            "%s%s skipped: %s", source_key, suffix, result.error or "not configured"
        )
    elif result.success:
        logger.info(
            "%s%s: %d written, %d skipped",
            source_key,
            suffix,
            result.rows_written,
            result.rows_skipped,
        )
    else:
        logger.error("%s%s collection failed: %s", source_key, suffix, result.error)

{% if insights_per_user %}


async def _project_ids(needs: tuple[Any, ...]) -> list[int]:
    """The projects with a source's ``needs`` set, by id."""
    return await read_items(lambda session: ProjectService(session).ids_where(*needs))


async def _collect_for(source_key: str, needs: tuple[Any, ...], project_id: int) -> None:
    """One project's collection of ``source_key``, in a session of its own;
    none once the project is gone or no longer has ``needs`` set."""
    async with get_async_session() as session:
        project = await ProjectService(session).collector_project(project_id, *needs)
        if project is None:
            logger.info("%s: project %s gone or unset; skipped", source_key, project_id)
            return
        await _run_one(session, source_key, project=project)
{% endif %}


{% if insights_github %}


{% if insights_per_user -%}
async def collect_github_traffic_job() -> list[int]:
    """Scheduled job: the projects with GitHub configured, each
    collected on its own (``collect_github_traffic_for``)."""
    return await _project_ids(ProjectService.GITHUB)


async def collect_github_traffic_for(project_id: int) -> None:
    """One project's GitHub traffic."""
    await _collect_for(SourceKeys.GITHUB_TRAFFIC, ProjectService.GITHUB, project_id)
{%- else %}
async def collect_github_traffic_job() -> None:
    """Scheduled job: collect GitHub traffic data."""
    logger.info("Running scheduled GitHub traffic collection")
    async with get_async_session() as session:
        await _run_one(session, SourceKeys.GITHUB_TRAFFIC)
{%- endif %}


