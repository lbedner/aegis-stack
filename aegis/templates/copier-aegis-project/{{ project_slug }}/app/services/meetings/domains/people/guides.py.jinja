"""How to work with one person: one pass of the ``meeting-guide`` agent
(``domains.agents``) over the owner's meetings they spoke in (the latest
``MAX_MEETINGS``), with the owner's own note on them, for what they care
about, how they like their information, how they decide and what lands
with them, each point citing the lines it rests on. Metered like every other model call
(``meetings:guide`` in AI spend).

The bot writes the guide of everyone in a meeting but the owner once the
notes are written (``bot.run_meeting``); Overseer writes one again on
request. A guide that fails keeps the last one it had, with why.
"""

from app.core.db import get_async_session
from app.core.log import logger
from app.services.ai.domains.spend.recording import extract_usage, record_usage
from app.services.meetings.domains.agents import GUIDE_AGENT, GUIDE_PROMPT, writer
from app.services.meetings.domains.people import queries
from app.services.meetings.domains.people.kept import keep_guide, keep_guide_failure
from app.services.meetings.domains.people.service import GUIDING
from app.services.meetings.models import (
    UNKNOWN,
    Guide,
    MeetingPerson,
    TranscriptLine,
)

ACTION = "meetings:guide"
# Fewer lines than this across their meetings say too little to read.
MIN_LINES = 3
# ponytail: the latest meetings only, so the prompt stays bounded; a
# running summary would carry older ones if a guide needs them.
MAX_MEETINGS = 10

Said = list[tuple[int, MeetingPerson | None, TranscriptLine]]


async def write_guides(meeting_id: int) -> None:
    """The guide of everyone who spoke in the meeting but the owner."""
    async with get_async_session() as session:
        here = await queries.meeting_people(session, meeting_id)
    for person_id in dict.fromkeys(p.id for _, p in here if not p.is_me):
        await write_guide(person_id)  # type: ignore[arg-type]


async def write_guide(person_id: int) -> None:
    """Write the person's guide over the last, or why it could not be (the
    points it had stay); someone who barely spoke gets none."""
    GUIDING.add(person_id)
    try:
        await _write(person_id)
    finally:
        GUIDING.discard(person_id)


async def _write(person_id: int) -> None:
    async with get_async_session() as session:
        person = await session.get_one(MeetingPerson, person_id)
        meeting_ids = await queries.meetings_with(session, person_id, MAX_MEETINGS)
        lines = await queries.said_in(session, meeting_ids)
        kept = await queries.guide_row(session, person_id)
    if sum(who is not None and who.id == person_id for _, who, _ in lines) < MIN_LINES:
        return
    try:
        guide, model_name = await _ask(person, kept.note if kept else None, lines)
    except Exception as exc:
        logger.exception("Person guide failed", person_id=person_id)
        async with get_async_session() as session:
            await keep_guide_failure(session, person_id, str(exc))
        return
    async with get_async_session() as session:
        await keep_guide(session, person_id, guide, model_name, len(meeting_ids))


async def _ask(
    person: MeetingPerson, note: str | None, lines: Said
) -> tuple[Guide, str]:
    agent, model_name = await writer(GUIDE_AGENT, GUIDE_PROMPT, Guide)
    result = await agent.run(_prompt(person, note, lines))
    await record_usage(
        action=ACTION,
        model_name=model_name,
        usage=extract_usage(result),
        user_id=None if person.owner_user_id is None else str(person.owner_user_id),
    )
    return _cited(result.output, {line.id for _, _, line in lines}), model_name


def _prompt(person: MeetingPerson, note: str | None, lines: Said) -> str:
    """The person, the owner's note on them, then each meeting's lines,
    every speaker by the name they go by in every meeting."""
    said: list[str] = [f"The person: {person.name}"]
    if note:
        said.append(f"The owner's own note on them: {note}")
    meeting: int | None = None
    for meeting_id, who, line in lines:
        if meeting_id != meeting:
            meeting = meeting_id
            said.append(f"\nMeeting {meeting_id}")
        said.append(f"[{line.id}] {who.name if who else UNKNOWN}: {line.text}")
    return "\n".join(said)


def _cited(guide: Guide, said: set[int | None]) -> Guide:
    """``guide`` citing only lines the meetings have: a model can make one
    up."""
    for item in guide.points():
        item.lines = [line for line in item.lines if line in said]
    return guide
