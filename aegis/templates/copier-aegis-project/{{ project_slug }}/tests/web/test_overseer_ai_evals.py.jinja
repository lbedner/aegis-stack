def test_a_run_opens_on_its_cases_failed_first_and_open(
    client: TestClient, two_runs: tuple[int, int]
) -> None:
    before, after = two_runs
    html = page_html(client, f"{PAGE}?run={after}")

    found = table_rows(html, "#ai-evals-cases table")
    assert [text(r["Case"]).removesuffix("a letter is read, not guessed") for r in found] == [
        "reads the paper",
        "never deletes",
    ]
    assert text(found[0]["Result"]) == "Failed"
    assert text(found[0]["Cost"]) == "$0.0123" and text(found[0]["Took"]) == "1.5s"
    failed, passed = select(html, "#ai-evals-cases tbody")
    assert "open: true" in failed.get("x-data") and "open: false" in passed.get("x-data")
    shown = text(one(failed, "[data-detail]"))
    assert "what does the letter say?" in shown and "I could not find it." in shown
    assert "calls paper once" in shown and "paper was called 0 times" in shown
    assert "called no tools" in shown
    # The run before it of the same dataset, to compare with.
    compare = one(html, "a[data-evals-compare]").get("href")
    assert "tab=compare" in compare and f"a={before}" in compare and f"b={after}" in compare


def test_a_case_shows_its_tool_calls_summed_up_and_their_arguments(
    client: TestClient, two_runs: tuple[int, int]
) -> None:
    before, _ = two_runs
    html = page_html(client, f"{PAGE}?run={before}")

    shown = select(html, "#ai-evals-cases [data-detail]")[0]
    assert "called paper once" in text(shown)
    [call] = select(shown, "details [data-tool-call]")
    # Its arguments, not its output, which can run long.
    assert '"page": 1' in text(call) and "Dear Leo" not in text(call)
    # A run kept before rules were says so.
    assert "rule not recorded" in text(shown)


