# Create async engine for non-blocking operations
def _get_async_database_url(database_url: str) -> str:
    """Convert sync database URL to async version.

    SQLite is handled whatever engine this project runs on: the test suite
    points ``DATABASE_URL`` at a throwaway SQLite file before this module
    builds its engines, so a Postgres project's tests run on SQLite too.
    """
    if database_url.startswith("sqlite:///"):
        return database_url.replace("sqlite:///", "sqlite+aiosqlite:///")
    elif database_url.startswith("sqlite://"):
        return database_url.replace("sqlite://", "sqlite+aiosqlite://")
{% if database_engine != "sqlite" %}
    if database_url.startswith("postgresql://"):
        database_url = database_url.replace(
            "postgresql://", "postgresql+asyncpg://"
        )
{% if postgres_provider == "neon" %}
        # asyncpg configures TLS via connect_args["ssl"] and ignores
        # sslmode/channel_binding; strip those libpq-only params so a
        # console-pasted Neon URL does not reach the driver with them.
        database_url = _strip_libpq_ssl_params(database_url)
{% endif %}
        return database_url
{% endif %}
    # For other database types, return as-is and let SQLAlchemy handle it
    return database_url

{% if database_engine == "sqlite" %}
async_engine = create_async_engine(
    _get_async_database_url(settings.DATABASE_URL),
    echo=settings.DATABASE_ENGINE_ECHO,
    poolclass=NullPool,
    connect_args=settings.DATABASE_CONNECT_ARGS,
)


# SQLite has one writer at a time, so every connection waits its turn
# rather than failing at once: a chat run holds one connection while each
# tool call commits on its own, and without a timeout the second writer
# fails immediately with "database is locked".
SQLITE_BUSY_TIMEOUT_MS = 30000


def apply_sqlite_pragmas(dbapi_connection: Any) -> None:
    """The pragmas every SQLite connection opens with, sync and async.

    One function because the two hooks had drifted: the sync one turned
    foreign keys on, the async one set the timeout, and each was missing
    what the other had — so every async session ran the schema with its
    foreign keys unenforced.

    NOT journal_mode, even though WAL is exactly what this stack needs.
    That pragma ANSWERS - it returns the mode - and a row left unfetched
    inside the connect hook is how a session that has not run a query yet
    fails to commit. Closing the cursor is not enough either: under
    aiosqlite close() is a coroutine, so a synchronous call returns an
    un-awaited object and closes nothing.

    The mode lives in the FILE and survives every restart, so it is set
    once at startup by ensure_wal() below.
    """
    dbapi_connection.execute("PRAGMA foreign_keys=ON")
    dbapi_connection.execute(f"PRAGMA busy_timeout={SQLITE_BUSY_TIMEOUT_MS}")


def ensure_wal(dbapi_connection: Any) -> str | None:
    """Put the database file in WAL, once, and say loudly if it would not.

    WAL is what makes the BEGIN IMMEDIATE below affordable. Taking the
    write lock up front removes the lock UPGRADE that busy_timeout
    cannot cover - but under a rollback journal it also makes every
    transaction a writer, reads included, so every read queues behind
    every write. Under WAL a reader never queues behind the writer, and
    the pair is correct together.

    This was not safe while the database sat on the bind mount: WAL
    coordinates readers through shared memory mapped from a -shm file,
    coherent only between processes on one kernel, and a host CLI plus
    several containers are two. The file now lives on a named volume the
    container boundary never crosses, which is what makes this legal.

    Called once at startup, never per connection - see
    apply_sqlite_pragmas. An in-memory database reports "memory" and can
    never be in WAL; that is not drift to report, and warning about it
    would teach everyone to ignore the warning.

    Returns the mode when it is NOT what was asked for, so a caller can
    act. Silence is how a database runs for weeks in a configuration its
    own code says would risk it.
    """
    try:
        cursor = dbapi_connection.execute("PRAGMA journal_mode=WAL")
        mode = cursor.fetchone()[0]
        cursor.close()
    except Exception:  # noqa: BLE001 - a pragma must never break startup
        return None
    found = str(mode).lower()
    if found in ("wal", "memory"):
        return None
    logger.warning(
        "SQLite would not go into WAL mode, which this stack requires: the "
        "engine takes the write lock up front, and without WAL every read "
        "queues behind every write. Something else holds this file - stop "
        "the stack and run PRAGMA journal_mode=WAL.",
        journal_mode=mode,
    )
    return found


@event.listens_for(engine, "connect")
def set_sqlite_pragma(dbapi_connection: Any, connection_record: Any) -> None:
    apply_sqlite_pragmas(dbapi_connection)


# pysqlite's legacy transaction sniffing implicitly COMMITs the open
# transaction before emitting SAVEPOINT, silently breaking nested-transaction
# (begin_nested) semantics that the finance sync relies on for per-connection
# isolation. The documented recipe: disable the driver's implicit BEGIN/COMMIT
# and emit BEGIN ourselves.
@event.listens_for(async_engine.sync_engine, "connect")
def _async_sqlite_take_over_transactions(
    dbapi_connection: Any, connection_record: Any
) -> None:
    dbapi_connection.isolation_level = None
    apply_sqlite_pragmas(dbapi_connection)


@event.listens_for(async_engine.sync_engine, "begin")
def _async_sqlite_emit_begin(conn: Any) -> None:
    """BEGIN IMMEDIATE, not a bare BEGIN.

    A bare BEGIN is DEFERRED: SQLite takes no lock until the first write
    and then has to UPGRADE. If another writer holds the lock at that
    moment the upgrade fails with "database is locked" AT ONCE -
    ``busy_timeout`` deliberately does not apply to it, because a
    transaction that already holds a read lock and waits for a write
    lock is how two of them deadlock.

    So the busy timeout above was never reached by the case that needs
    it. Any turn that opens a second session while the first still
    holds one hits this; it cost a live turn in a downstream app, where
    a chat answer streamed, a proposal landed, and the memory write
    that followed died on "database is locked" with the fact already
    spoken aloud.

    IMMEDIATE takes the write lock up front, where waiting is safe and
    the timeout DOES apply, so a second writer queues instead of
    failing. The cost is that read-only transactions on this engine also
    queue behind a writer, which for a single-file SQLite database is
    the cheaper of the two.
    """
    conn.exec_driver_sql("BEGIN IMMEDIATE")
