[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ dist }}"
version = "0.0.1"
description = "{{ description }}"
authors = [{ name = "{{ author }}" }]
requires-python = ">=3.11"
keywords = ["aegis-stack", "aegis-stack-plugin"]
dependencies = [
    "aegis-stack>={{ aegis_version }}",
]

[project.urls]
"Aegis Plugin" = "https://aegis-stack.io/plugins/{{ dist }}"

[project.optional-dependencies]
dev = [
    "pytest>=9.0.0",
    "ruff>=0.1.0",
    "pre-commit>=3.7.0",
]

[project.entry-points."aegis.plugins"]
{{ name }} = "{{ pkg }}.plugin:get_spec"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ pkg }}"]

[tool.ruff]
line-length = 88
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP"]
