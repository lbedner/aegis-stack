{%- if include_worker and worker_backend == "taskiq" %}
"""The load test counts its tasks from the task history.

It used to ask the result backend, which keeps a result for 60 seconds: on
a run longer than that, every task that finished early had lost its result
before the monitor got to it, so a 400-task run reported 138 completed.
Every task has a history record for a day, whichever way it was enqueued.
"""

from typing import Any

import pytest

from app.components.worker.queues import load_test


@pytest.mark.asyncio
async def test_counts_each_task_by_its_recorded_status(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    readings = iter(
        [
            ["completed", "running", None],
            ["completed", "completed", "failed"],
        ]
    )
    seen: list[list[str]] = []

    async def statuses(redis: Any, job_ids: list[str]) -> list[str | None]:
        seen.append(job_ids)
        return next(readings)

    monkeypatch.setattr(load_test, "get_task_statuses", statuses)
    result = await load_test._monitor_task_completion(
        redis=object(), task_ids=["a", "b", "c"], expected_tasks=3, poll_interval=0
    )
    assert result["tasks_completed"] == 2
    assert result["tasks_failed"] == 1
    assert seen == [["a", "b", "c"], ["a", "b", "c"]]  # one read per poll, all ids
{%- endif %}
