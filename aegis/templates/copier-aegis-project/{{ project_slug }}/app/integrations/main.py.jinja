from fastapi.responses import HTMLResponse  # noqa: E402
{%- else %}
from fastapi.responses import HTMLResponse, RedirectResponse  # noqa: E402
{%- endif %}

from app.components.backend.hooks import backend_hooks  # noqa: E402
