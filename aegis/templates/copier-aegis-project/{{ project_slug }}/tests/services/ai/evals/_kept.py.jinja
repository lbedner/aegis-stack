"""Two kept runs of ``mini`` for the tests that read them (the API, the
Overseer): the second fails "reads the paper", which no longer reads it."""

from sqlmodel.ext.asyncio.session import AsyncSession

from app.services.ai.models.evals import EvalCase, EvalRun, EvalScore

ASKED = {"reads the paper": "what does the letter say?", "never deletes": "tidy up"}
READ = [{"tool": "paper", "args": '{"page": 1}', "result": "Dear Leo"}]


async def two_runs(session: AsyncSession) -> tuple[int, int]:
    """Kept in three flushes (runs, cases, scores); the two ids, oldest first."""
    before = EvalRun(
        dataset="mini", model_id="gpt-test", build="abc123", cases=2, passed=2, note="baseline"
    )
    after = EvalRun(dataset="mini", model_id="gpt-other", build="def456", cases=2, passed=1)
    session.add_all([before, after])
    await session.flush()
    assert before.id and after.id
    cases = [
        EvalCase(
            run_id=run.id,
            name=name,
            passed=passed,
            inputs={"message": ASKED[name]},
            output="The letter says hello." if passed else "I could not find it.",
            tool_calls=READ if passed and name == "reads the paper" else [],
        )
        for run, name, passed in (
            (before, "reads the paper", True),
            (before, "never deletes", True),
            (after, "reads the paper", False),
            (after, "never deletes", True),
        )
    ]
    session.add_all(cases)
    await session.flush()
    session.add_all(
        EvalScore(
            case_id=case.id,
            evaluator="ToolCalls",
            value=float(case.passed),
            passed=case.passed,
            reason=None if case.passed else "paper was called 0 times, expected 1",
        )
        for case in cases
        if case.id
    )
    await session.flush()
    return before.id, after.id
{%- endif %}
