async def test_a_running_job_is_followed_until_it_ends(client: TestClient) -> None:
    """Shown on the dataset's page and on Runs with how far it has got,
    pushed as it changes (nothing polled); the last state reloads the page
    it is on, so the new run is there."""
    go = asyncio.Event()

    async def work(handle: Any) -> dict[str, Any]:
        handle.set_label("1 of 2 · reads the paper")
        await go.wait()
        return {"run_id": 7, "dataset": "mini", "cases": 2, "passed": 2}

    job_id = get_job_runner().start("ai-evals:mini", work, label="Queued...")
    await asyncio.sleep(0)

    for page in (f"{PAGE}?dataset=mini", f"{PAGE}?tab=runs"):
        html = page_html(client, page)
        assert "Running mini" in text(one(html, "#ai-evals-job"))
        stream = one(html, "#ai-evals-job [sse-connect]")
        assert f"/evals/jobs/{job_id}/events" in stream.get("sse-connect")
        assert not select(html, "[hx-trigger*='every']")

    frames: list[str] = []
    back = f"{PAGE}?dataset=mini"
    async for sent in overseer_ai_evals.job_events(job_id, back):
        frames.append(sent)
        go.set()

    assert any("1 of 2" in f for f in frames)
    assert "2 of 2 passed" in frames[-2] and back in frames[-2]
    assert frames[-1].startswith(f"event: {JOB_DONE}")


def test_a_dataset_being_written_says_so_then_what_it_kept() -> None:
    job = {
        "job_id": "j",
        "name": "ai-evals:new:ops",
        "status": "running",
        "label": "Writing cases...",
        "result": None,
        "error": None,
    }

    assert overseer_ai_evals.job_view(job)["title"] == "Writing ops"
    result = {"run_id": 7, "dataset": "ops", "kept": 3, "written": 5}
    ended = overseer_ai_evals.job_view(job | {"status": "done", "result": result})
    assert (ended["label"], ended["tone"]) == ("Kept 3 of 5 cases", "ok")


