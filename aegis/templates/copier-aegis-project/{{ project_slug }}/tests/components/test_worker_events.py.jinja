def test_worker_boot_applies_what_the_overseer_saved(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """On the AsyncIO middleware's loop, the one async actors use."""
    from app.components.worker import middleware

    ran: list[Any] = []

    class Loop:
        def run_coroutine(self, coroutine: Any) -> None:
            ran.append(coroutine.__name__)
            coroutine.close()

    monkeypatch.setattr(middleware, "get_event_loop_thread", lambda: Loop())
    EventPublishMiddleware().after_worker_boot(MagicMock(), MagicMock())
    assert ran == ["apply_saved_overrides"]


