{%- if ai_backend != "memory" -%}
"""What the Evals section does to a dataset (``overseer_ai_evals`` shows
them): a new one written by the model as a job, one exported as YAML,
one deleted behind a confirmation (an import is the store's
``add_eval_dataset_file`` as is). Each goes through the dataset store the
CLI and the API use."""

from collections.abc import Awaitable, Mapping
from typing import TYPE_CHECKING, Any, TypeVar

from fastapi import HTTPException

from app.services.ai.service import (
    EVAL_ABOUT_MIN,
    EVAL_CASES,
    EVAL_MOST_CASES,
    EVAL_NAME,
    EVAL_NAME_HINT,
    UnknownDatasetError,
    eval_dataset_text,
    eval_datasets,
    remove_eval_dataset,
    start_generate_evals,
)

from .overseer_ai_common import PARTIALS
from .rendering import form_number

if TYPE_CHECKING:
    from sqlmodel.ext.asyncio.session import AsyncSession

T = TypeVar("T")
DATASETS_URL = f"{PARTIALS}/evals/datasets"


def options(names: list[str]) -> list[dict[str, str]]:
    """``names`` as a picker's options."""
    return [{"id": name, "name": name} for name in names]


async def or_404(read: Awaitable[T]) -> T:
    """``read``, a dataset's; 404 for no such dataset."""
    try:
        return await read
    except UnknownDatasetError:
        raise HTTPException(status_code=404, detail="No such dataset.") from None


async def new_dataset(
    db: "AsyncSession", form: Mapping[str, str], errors: list[str]
) -> dict[str, Any]:
    """The New dataset dialog: a name, what it checks, how many cases and
    a dataset to write like; ``form`` as typed when ``errors`` say why not."""
    return {
        "form": form,
        "errors": errors,
        "likes": options(await eval_datasets(db)),
        "post_url": DATASETS_URL,
        "name": {"pattern": EVAL_NAME.pattern, "hint": EVAL_NAME_HINT.capitalize()},
        "about_min": EVAL_ABOUT_MIN,
        "cases": {"usual": EVAL_CASES, "most": EVAL_MOST_CASES},
    }


async def write_dataset(form: Mapping[str, str]) -> str:
    """The form's dataset, written by the model in force as a job
    (``start_generate_evals``): its id. ValueError for whatever
    ``check_new`` refuses, or a count that is not a number."""
    return await start_generate_evals(
        form.get("name", "").strip(),
        about=form.get("about", "").strip(),
        cases=form_number(form.get("cases"), "Cases") or EVAL_CASES,
        like=form.get("like") or None,
    )


async def export(db: "AsyncSession", name: str) -> str:
    """The dataset's YAML as it was written; 404 for no such dataset."""
    return await or_404(eval_dataset_text(db, name))


async def delete_dataset(db: "AsyncSession", name: str) -> dict[str, Any]:
    """The confirmation before a dataset is deleted (404 for no such
    dataset); it is not read, so one that cannot be read can still go."""
    await or_404(eval_dataset_text(db, name))
    return {
        "title": f"Delete {name}?",
        "body": "The dataset goes for good. Its kept runs stay.",
        "url": f"{DATASETS_URL}/{name}",
        "label": "Delete",
        "method": "delete",
    }


async def deleted(db: "AsyncSession", name: str) -> None:
    """Delete the dataset; 404 for no such dataset."""
    await or_404(remove_eval_dataset(db, name))
{%- endif %}
