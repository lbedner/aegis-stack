class TestLocalSync:
    """The local sync reads the app's inference engine, whichever it is:
    its models go under the engine's name, each at the context it serves."""

    async def test_models_go_under_the_engine_at_their_served_context(
        self, sync_db_session: Session, monkeypatch: pytest.MonkeyPatch
    ) -> None:
        import httpx

        from app.components.inference.llamacpp import LlamaCppEngine
        from app.services.ai.domains.llm.etl import llm_sync_service
        from tests import _fake_llamacpp
        from tests._fake_ollama import serving

        engine = LlamaCppEngine(
            "http://llamacpp:8080",
            transport=httpx.MockTransport(serving(_fake_llamacpp.ROUTES)),
        )
        monkeypatch.setattr(llm_sync_service, "get_inference_engine", lambda: engine)

        async def no_labs(session: Session, model_ids: list[str]) -> None:
            """The maker lookup fetches from the registry (its own tests)."""

        monkeypatch.setattr(llm_sync_service, "attach_labs", no_labs)
        marked: list[Session] = []

        async def mark(session: Session) -> int:
            marked.append(session)
            return 0

        monkeypatch.setattr(llm_sync_service, "attach_provider_marks", mark)
        result = await LLMSyncService(sync_db_session).sync(source="local")

        assert result.models_added == 1 and not result.errors
        # A local-only install never runs the cloud sync: its engine's
        # logo is filled here too.
        assert marked
        model = sync_db_session.exec(
            select(LargeLanguageModel).where(LargeLanguageModel.model_id == "qwen2.5:7b")
        ).one()
        assert model.context_window == 32768
        assert sync_db_session.get(LLMOrg, model.served_by_org_id).name == "llamacpp"
        # Its chat template takes tools, so it can drive an agent (a call).
        assert model.supports_tools is True

    async def test_a_model_the_engine_stopped_serving_leaves_the_picker(
        self, sync_db_session: Session, monkeypatch: pytest.MonkeyPatch
    ) -> None:
        """The picker lists enabled models: one its engine no longer has
        (removed, or one it cannot load) is turned off, and on again when
        it comes back. Another engine's models are not its to turn off."""
        import httpx

        from app.components.inference.llamacpp import LlamaCppEngine
        from app.services.ai.domains.llm.etl import llm_sync_service
        from tests import _fake_llamacpp
        from tests._fake_ollama import serving

        engine = LlamaCppEngine(
            "http://llamacpp:8080",
            transport=httpx.MockTransport(serving(_fake_llamacpp.ROUTES)),
        )
        monkeypatch.setattr(llm_sync_service, "get_inference_engine", lambda: engine)

        async def nothing(*args: object) -> None:
            """Labs and marks fetch from outside (their own tests)."""

        monkeypatch.setattr(llm_sync_service, "attach_labs", nothing)
        monkeypatch.setattr(llm_sync_service, "attach_provider_marks", nothing)
        service = LLMSyncService(sync_db_session)
        TestCatalogStats._served_model(service, "llamacpp", "gpt-oss:20b")
        TestCatalogStats._served_model(service, "ollama", "qwen3:8b-mlx")
        TestCatalogStats._served_model(service, "llamacpp", _fake_llamacpp.MODEL)
        back = sync_db_session.exec(
            select(LargeLanguageModel).where(
                LargeLanguageModel.model_id == _fake_llamacpp.MODEL
            )
        ).one()
        back.enabled = False
        sync_db_session.add(back)
        sync_db_session.commit()

        await LLMSyncService(sync_db_session).sync(source="local")

        enabled = {
            m.model_id: m.enabled
            for m in sync_db_session.exec(select(LargeLanguageModel)).all()
        }
        assert enabled == {
            "gpt-oss:20b": False,
            _fake_llamacpp.MODEL: True,
            "qwen3:8b-mlx": True,
        }

    async def test_a_router_marks_what_a_loaded_model_can_do_and_keeps_the_rest(
        self, sync_db_session: Session, monkeypatch: pytest.MonkeyPatch
    ) -> None:
        """A loaded model's tools are read from its own props, so it can run
        a call. An unloaded one's are unknown: it keeps what an earlier
        sync, with it loaded, said."""
        import httpx

        from app.components.inference.llamacpp import LlamaCppEngine
        from app.services.ai.domains.llm.etl import llm_sync_service
        from tests import _fake_llamacpp
        from tests._fake_ollama import serving

