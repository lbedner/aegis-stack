class TestRefreshServiceHistory:
    """Every sign-in the table still keeps, for Overseer's Sessions page."""

    @pytest.mark.asyncio
    async def test_each_sign_in_says_its_renewals_and_how_it_ended(
        self, async_db_session: AsyncSession, user_factory
    ):
        """A live sign-in renewed twice, one signed out, one that ran out."""
        user = await user_factory()
        service = RefreshService(async_db_session)
        first = await service.mint(user.id, source="password")
        renewed = await service.rotate(first)
        assert renewed is not None
        await service.rotate(renewed.token)
        await service.revoke(await service.mint(user.id, source="oauth:github"))
        stale = await service.mint(user.id, source="oauth:google")
        row = await _row(async_db_session, stale)
        assert row is not None
        row.expires_at = _now() - timedelta(seconds=1)
        async_db_session.add(row)
        await async_db_session.commit()

        found = {h.source: h for h in await history(async_db_session, user.id)}
        live = found["password"]
        assert (live.ended, live.ended_at, len(live.renewals)) == (None, None, 2)
        assert live.signed_in <= live.renewals[0] <= live.renewals[1]
        assert found["oauth:github"].ended == SessionEnd.REVOKED
        assert found["oauth:google"].ended == SessionEnd.EXPIRED
        assert found["oauth:google"].ended_at == row.expires_at

    @pytest.mark.asyncio
    async def test_it_is_only_the_users_own(
        self, async_db_session: AsyncSession, user_factory
    ):
        mine, theirs = await user_factory(), await user_factory()
        service = RefreshService(async_db_session)
        await service.mint(theirs.id, source="password")
        assert await history(async_db_session, mine.id) == []

    @pytest.mark.asyncio
    async def test_everyone_is_every_users_sign_ins(
        self, async_db_session: AsyncSession, user_factory
    ):
        """For Overseer's administrators: each sign-in says whose it is."""
        first, second = await user_factory(), await user_factory()
        service = RefreshService(async_db_session)
        await service.mint(first.id, source="password")
        await service.mint(second.id, source="password")
        found = {h.user_id for h in await everyone(async_db_session)}
        assert {first.id, second.id} <= found


class TestRefreshServiceLazySweep:
    """Builds without the scheduler component clean up expired rows
    opportunistically from ``rotate``. The first eligible rotation
    primes the sweep; subsequent rotations within the interval are
    skipped (the table delete is bounded to ~1/hour)."""

    @pytest.mark.asyncio
    async def test_rotate_sweeps_expired_rows(
        self, async_db_session: AsyncSession, user_factory
    ):
        from app.services.auth.refresh_tokens import (
            REFRESH_TOKEN_RETENTION_DAYS,
            RefreshService,
        )

        # Force the sweep gate open for this test — the class-level
        # timestamp survives across tests in the same process.
        RefreshService._last_sweep_at = None

        user = await user_factory()
        service = RefreshService(async_db_session)

        # Plant an expired row beyond the retention window.
        old = RefreshToken(
            token="expired-stub-token",
            user_id=user.id,
            family_id="expired-family",
            expires_at=_now() - timedelta(days=REFRESH_TOKEN_RETENTION_DAYS + 1),
            created_at=_now() - timedelta(days=REFRESH_TOKEN_RETENTION_DAYS + 2),
        )
        async_db_session.add(old)
        await async_db_session.commit()

        # A live token whose rotation will trigger the sweep.
        live = await service.mint(user.id, source="password")
        rotated = await service.rotate(live)
        assert rotated is not None

        # Planted by its key as stored, so look it up the same way.
        gone = await async_db_session.get(RefreshToken, "expired-stub-token")
        assert gone is None
