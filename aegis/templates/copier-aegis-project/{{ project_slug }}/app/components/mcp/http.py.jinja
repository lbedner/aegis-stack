"""MCP over HTTP: the stdio server's tools, mounted in the webserver at
``/mcp`` for a client elsewhere. Every request carries an MCP token
(``Authorization: Bearer mcp_...``); no token, no tools. {% if include_auth %}Its owner is who
the calls act for{% else %}With no one to sign
in a token is the operator's: its calls act for ``MCP_OWNER_USER_ID``, as
stdio's do{% endif %}, and its scope is what they reach (``server._reach``).

No CORS: desktop and coding clients are not browsers. Not through the dev
tunnel, whose guard admits only the Plaid webhook.
"""

from fastmcp.server.auth import AccessToken, TokenVerifier
from fastmcp.server.http import StarletteWithLifespan

from app.core.config import settings
from app.core.db import get_async_session
from app.core.tools import load_tools
{%- if include_auth %}
from app.models.user import User
from app.services.shared.deps import owner_is_admin
{%- endif %}

from . import tokens
from .activity import record
from .server import build_server, operator

PATH = "/mcp"
# The app ``main.py`` mounted at PATH (``mount_app``), for the backend's
# lifespan hooks to run (``startup/mcp_lifespan.py``).
mounted: StarletteWithLifespan | None = None


class McpTokens(TokenVerifier):
    """A request's bearer token, resolved to who its calls act for and the
    effects its scope reaches. A revoked or unknown token is refused (401){% if include_auth %},
    and so is one with no owner: made before auth was added, it was the
    operator's, and now a token is a person's{% endif %}."""

    async def verify_token(self, token: str) -> AccessToken | None:
        async with get_async_session() as db:
            row = await tokens.resolve(db, token)
{%- if include_auth %}
            owner = await db.get(User, row.user_id) if row and row.user_id else None
            admin = owner is not None and await owner_is_admin(db, row.user_id)
        if row is None or owner is None:
            return None
        acts_for = row.user_id
{%- else %}
        if row is None:
            return None
        acts_for, admin = operator()
{%- endif %}
        return AccessToken(
            token=token,
            client_id=f"mcp-token-{row.id}",
            scopes=sorted(tokens.SCOPES[row.scope]),
            claims={"user_id": acts_for, "token": row.name, "admin": admin},
        )


def build_http_app() -> StarletteWithLifespan:
    """The app to mount at ``PATH``. Its lifespan must run inside the root
    app's (``app/integrations/main.py``): a mounted app's does not run on
    its own, and without it no session starts."""
    load_tools()
    server = build_server(settings.MCP_TOOLS, record=record, auth=McpTokens())
    return server.http_app(path="/", json_response=True)


def mount_app() -> StarletteWithLifespan:
    """A fresh app to mount at PATH, kept as ``mounted`` so the backend's
    startup hook runs its lifespan with the webserver's."""
    global mounted
    mounted = build_http_app()
    return mounted
