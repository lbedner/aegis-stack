"""A dataset written by the model in force, told this app's tools and,
where given, a dataset to write like; then run once on that model, each
case that held kept with the script its turn took, played back as CI
plays it, and the rest dropped with why. Nothing it writes fails."""

from collections.abc import AsyncIterator
from typing import Any

import pytest

from app.core.db import get_async_session
from app.core.tools import registered_tool_names
from app.services.ai.domains.chat.agent_loader import resolve_agent
from app.services.ai.domains.chat.builtin_fetchers import whole_app
from app.services.ai.domains.chat.prompts import meant
from app.services.ai.domains.evals import jobs, queries
from app.services.ai.domains.evals.datasets import parse
from app.services.ai.domains.evals.script import Step
{%- if include_worker %}
from app.services.system import job_store
{%- endif %}

from ._mini import (
    ABOUT,
    DATASET,
    WRITTEN,
    answering,
    keep,
    kept,
    kept_text,
    only_mini,
    writing,
)


@pytest.fixture
async def mini(monkeypatch: pytest.MonkeyPatch) -> AsyncIterator[None]:
    async with only_mini(monkeypatch):
        yield


@pytest.fixture
def written(mini: None, monkeypatch: pytest.MonkeyPatch) -> list[str]:
    """The model writes ``WRITTEN`` beside ``mini``, whose runs a fake chat
    answers; what the model was told."""
    return writing(monkeypatch)


@pytest.mark.queryspy(allow_n_plus_one=True)  # the test reads back what was kept
async def test_only_cases_that_held_are_kept_each_with_its_script(
    written: list[str], monkeypatch: pytest.MonkeyPatch
) -> None:
    answering(monkeypatch)

    made = await jobs.generate_evals("held", about="Reads what it is given.", cases=2)

    text = await kept_text("held")
    assert text.startswith("# Reads what it is given.\n")
    assert "null" not in text and "schema" not in text
    assert await kept() == ["held", "mini"]
    (case,) = parse("held", text).cases
    assert case.name == "reads the letter"
    assert case.inputs.script == [Step(tool="paper"), Step(text="The letter says hello.")]
    assert [type(check).__name__ for check in case.evaluators] == ["ToolCalls"]
    assert made.kept == 1
    spans, health = made.dropped
    assert spans.name == "counts calls" and "spans" in spans.why
    assert health.name == "checks health" and "health" in health.why
    async with get_async_session() as session:
        runs = await queries.runs(session, "held")
    assert [(r.trigger, r.passed, r.cases) for r in runs] == [("ci", 1, 1), ("generate", 1, 2)]
    assert made.run_id == runs[1].id


@pytest.mark.queryspy(allow_n_plus_one=True)  # the test reads back what was kept
async def test_with_no_case_held_nothing_is_written(
    written: list[str], monkeypatch: pytest.MonkeyPatch
) -> None:
    answering(monkeypatch, reads=False)

    with pytest.raises(ValueError, match="reads the letter"):
        await jobs.generate_evals("ops", about=ABOUT)

    assert await kept() == ["mini"]


@pytest.mark.queryspy(allow_n_plus_one=True)  # the test reads back what was kept
async def test_a_run_that_breaks_leaves_nothing_written(
    written: list[str], monkeypatch: pytest.MonkeyPatch
) -> None:
    async def broken(*args: object, **kwargs: object) -> None:
        raise RuntimeError("the provider is down")

    monkeypatch.setattr(jobs, "run_evals", broken)

    with pytest.raises(RuntimeError):
        await jobs.generate_evals("ops", about=ABOUT)

    assert await kept() == ["mini"]


@pytest.mark.queryspy(allow_n_plus_one=True)  # the test reads the agent too
async def test_the_model_is_told_the_tools_and_the_dataset_to_write_like(
    written: list[str], monkeypatch: pytest.MonkeyPatch
) -> None:
    """The tools are the default assistant's own: a check on one it cannot
    call would fail its turn. The dataset to write like comes without its
    scripts, which the model is told to leave empty."""
    answering(monkeypatch)
    scripted = "      script: [{tool: paper}, {text: The letter says hello.}]\n"
    await keep(
        "mini",
        DATASET.replace("      message: tidy up\n", f"      message: tidy up\n{scripted}"),
        replace=True,
    )

    await jobs.generate_evals("ops", about=ABOUT, cases=3, like="mini")

    said = "\n".join(written)
    assert "health(component: str | None = None)" in said
    granted = set((await resolve_agent()).tool_names)
    assert not [n for n in registered_tool_names() if n not in granted and f"\n{n}(" in said]
    assert "what does the letter say?" in said
    assert "3 example cases" in said
    assert "script" not in said.split("Write like this dataset:")[1]


async def test_what_the_model_wrote_that_is_no_dataset_is_said_plainly(
    mini: None, monkeypatch: pytest.MonkeyPatch
) -> None:
    writing(monkeypatch, {"cases": "none"})

    with pytest.raises(ValueError, match="could not be read"):
        await jobs.generate_evals("ops", about=ABOUT)


@pytest.mark.queryspy(allow_n_plus_one=True)  # the test reads the agent too
async def test_the_model_is_told_the_app_the_assistant_and_what_is_already_asked(
    written: list[str], monkeypatch: pytest.MonkeyPatch
) -> None:
    """What the assistant itself is told (its prompt, the app's map), so a
    case is about this app, and every message a dataset already
    asks, so a new dataset repeats none."""
    answering(monkeypatch)

    await jobs.generate_evals("ops", about=ABOUT)

    said = "\n".join(written)
    assert meant((await resolve_agent()).system_prompt) in said
    assert await whole_app() in said
    assert "- tidy up" in said


@pytest.mark.parametrize("about", ["", "s", "   checks   "])
async def test_a_dataset_that_does_not_say_what_it_checks_is_refused(
    written: list[str], about: str
) -> None:
    with pytest.raises(ValueError, match="what it checks"):
        await jobs.generate_evals("ops", about=about)

    assert written == []


@pytest.mark.queryspy(allow_n_plus_one=True)  # the test keeps one meanwhile, then reads it
async def test_a_dataset_kept_meanwhile_is_never_written_over(
    written: list[str], monkeypatch: pytest.MonkeyPatch
) -> None:
    """The name is free when asked and taken by the time the cases hold
    (another generate, a person): theirs stays, as it was."""
    answering(monkeypatch)
    run_evals = jobs.run_evals

    async def meanwhile(*args: Any, **kwargs: Any) -> Any:
        await keep("ops", "# Theirs.\n" + DATASET)
        return await run_evals(*args, **kwargs)

    monkeypatch.setattr(jobs, "run_evals", meanwhile)

    with pytest.raises(ValueError, match="already exists"):
        await jobs.generate_evals("ops", about=ABOUT)

    assert await kept_text("ops") == "# Theirs.\n" + DATASET


@pytest.mark.queryspy(allow_n_plus_one=True)  # the test reads back what was kept
async def test_a_case_the_model_left_unnamed_is_kept_by_its_place(
    mini: None, monkeypatch: pytest.MonkeyPatch
) -> None:
    unnamed = {k: v for k, v in WRITTEN["cases"][0].items() if k != "name"}
    writing(monkeypatch, {"cases": [unnamed]})
    answering(monkeypatch)

    made = await jobs.generate_evals("ops", about=ABOUT)

    assert made.kept == 1 and made.dropped == []
    assert [case.name for case in parse("ops", await kept_text("ops")).cases] == ["Case 1"]


@pytest.mark.parametrize("cases", [0, 21])
async def test_a_count_out_of_range_is_refused(written: list[str], cases: int) -> None:
    with pytest.raises(ValueError, match="1 to 20"):
        await jobs.generate_evals("ops", about=ABOUT, cases=cases)

    assert written == []


@pytest.mark.parametrize("name", ["mini", "../mini", "Bad Name", ""])
@pytest.mark.queryspy(allow_n_plus_one=True)  # the test reads back what was kept
async def test_a_dataset_is_never_written_over_or_under_a_name_that_is_none(
    written: list[str], name: str
) -> None:
    with pytest.raises(ValueError):
        await jobs.generate_evals(name, about=ABOUT)

    assert written == [] and await kept() == ["mini"]


async def test_an_unknown_dataset_to_write_like_is_refused(written: list[str]) -> None:
    with pytest.raises(ValueError, match="nope"):
        await jobs.generate_evals("ops", about=ABOUT, like="nope")

    assert written == []
{%- if include_worker %}


async def test_a_started_dataset_is_handed_to_the_worker(
    written: list[str], monkeypatch: pytest.MonkeyPatch
) -> None:
    queued: list[tuple[Any, ...]] = []

    async def queue_job(*args: Any) -> str:
        queued.append(args)
        return "job-1"

    monkeypatch.setattr(job_store, "queue_job", queue_job)

    job = await jobs.start_generate_evals("ops", about=ABOUT, cases=3, like=None)

    assert job == "job-1"
    assert queued == [("ai-evals:new:ops", "generate_evals_task", "ops", ABOUT, 3, None)]
