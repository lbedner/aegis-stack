"""Scheduled service jobs, run as worker tasks on the system queue.
{%- if include_scheduler %}

The scheduler enqueues each job by its function's name; this is where the
worker learns those names. Both read ``app.core.schedule.service_jobs``,
so the two cannot drift apart.
{%- else %}

This stack has no scheduler, so there are none.
{%- endif %}
"""
{%- if worker_backend == "arq" %}

import functools
from typing import Any

from arq.worker import Function, func
{%- elif worker_backend == "taskiq" %}
{% if include_scheduler %}
import functools
{%- endif %}
from typing import Any
{%- else %}
{% if include_scheduler %}
import functools
{%- endif %}
from typing import Any

import dramatiq
{%- endif %}
{%- if include_scheduler %}

{%- if worker_backend == "dramatiq" %}
from app.core.constants import QueueName
{%- endif %}
from app.core.schedule import ServiceJob, service_jobs
{%- endif %}
{%- if worker_backend == "dramatiq" %}

# The project's broker must exist before an actor is declared, or the actor
# lands on dramatiq's default broker, which has no results middleware.
import app.components.worker.broker  # noqa: F401
{%- endif %}
{%- if worker_backend == "arq" %}
{%- if include_scheduler %}


def as_task(job: ServiceJob) -> Function:
    """The job's task (``ServiceJob.handed_to``) as an arq task under its
    timeout: the job itself, or, for a sweep, one of its items."""
    code, call = job.work

    @functools.wraps(code)
    async def run(ctx: dict[str, Any], *args: Any) -> Any:
        return await call(*args)

    return func(run, name=job.handed_to, timeout=job.timeout)
{%- endif %}


def service_job_tasks() -> list[Function]:
    """Every scheduled job's task, for ``WorkerSettings.functions``."""
{%- if include_scheduler %}
    return [as_task(job) for job in service_jobs()]
{%- else %}
    return []
{%- endif %}
{%- elif worker_backend == "taskiq" %}
{%- if include_scheduler %}


def as_task(job: ServiceJob, broker: Any) -> Any:
    """The job's task (``ServiceJob.handed_to``) as a TaskIQ task under its
    timeout: the job itself, or, for a sweep, one of its items.

    TaskIQ renames the function it decorates (``__name__`` gains
    ``__taskiq_original``), so it decorates a wrapper of our own: the job's
    function is shared with the scheduler, which enqueues by its name.
    """
    code, call = job.work

    @functools.wraps(code)  # the job's own code: what it goes into
    async def run(*args: Any) -> Any:
        return await call(*args)

    run.__name__ = run.__qualname__ = job.handed_to
    run.__doc__ = code.__doc__
    labels = {"timeout": job.timeout} if job.timeout else {}
    return broker.task(task_name=job.handed_to, **labels)(run)
{%- endif %}


def service_job_tasks(broker: Any) -> dict[str, Any]:
    """Every scheduled job's task, keyed by name, registered on ``broker``.

    The registry reads a queue's tasks off its module, so the queue binds
    these as module attributes.
    """
{%- if include_scheduler %}
    return {job.handed_to: as_task(job, broker) for job in service_jobs()}
{%- else %}
    return {}
{%- endif %}
{%- else %}
{%- if include_scheduler %}


def as_task(job: ServiceJob) -> Any:
    """The job's task (``ServiceJob.handed_to``) as a Dramatiq actor on the
    system queue under its time limit: the job itself, or, for a sweep, one
    of its items."""
    code, call = job.work

    @functools.wraps(code)  # the job's own code: what it goes into
    async def run(*args: Any) -> Any:
        return await call(*args)

    run.__name__ = job.handed_to
    limits = {"time_limit": job.timeout * 1000} if job.timeout else {}
    return dramatiq.actor(
        run,
        actor_name=job.handed_to,
        queue_name=QueueName.SYSTEM,
        store_results=True,
        **limits,
    )
{%- endif %}


def service_job_tasks() -> dict[str, Any]:
    """Every scheduled job's task, keyed by name, as a registered actor.

    The registry reads a queue's actors off its module, so the queue binds
    these as module attributes.
    """
{%- if include_scheduler %}
    return {job.handed_to: as_task(job) for job in service_jobs()}
{%- else %}
    return {}
{%- endif %}
{%- endif %}
