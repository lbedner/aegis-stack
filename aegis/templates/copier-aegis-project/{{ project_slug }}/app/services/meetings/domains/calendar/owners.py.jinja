"""The users a meeting can be owned by: those on a calendar invite, for
who owns the meeting an agent joins from it (``service.send_due``), whose
invites a user's calendar shows (``email_of``), and everyone a meeting or
an agent's calendar meetings can be given to (``owners``)."""

from collections.abc import Iterable

from pydantic import BaseModel
from sqlmodel.ext.asyncio.session import AsyncSession
{%- if include_auth %}

from app.services.auth.service import UserService
{%- endif %}


class NoSuchOwnerError(ValueError):
    """Nobody with an account here has that id."""


class Owner(BaseModel):
    """Someone a meeting can be given to."""

    id: int
    email: str


async def owners(db: AsyncSession) -> list[Owner]:
    """Everyone with an account here, by email; nobody without auth, where
    every meeting is the install's."""
{%- if include_auth %}
    users = await UserService(db).list_users()
    every = (Owner(id=u.id, email=u.email) for u in users)  # type: ignore[arg-type]
    return sorted(every, key=lambda owner: owner.email)
{%- else %}
    return []
{%- endif %}


async def check_owner(db: AsyncSession, user_id: int) -> None:
    """``NoSuchOwnerError`` unless ``user_id`` has an account here."""
{%- if include_auth %}
    if user_id in await UserService(db).get_users_by_ids([user_id]):
        return
{%- endif %}
    raise NoSuchOwnerError(f"Nobody here has the id {user_id}")


async def users_by_email(db: AsyncSession, emails: Iterable[str]) -> dict[str, int]:
    """The user each of ``emails`` belongs to, by email; an email nobody
    here has is missing."""
{%- if include_auth %}
    return await UserService(db).get_user_ids_by_emails(emails)
{%- else %}
    # No users without auth: every meeting is the install's.
    return {}
{%- endif %}


async def email_of(db: AsyncSession, user_id: int | None) -> str | None:
    """The user's email, for the invites they are on; None for the install
    without auth, whose calendar is every meeting."""
{%- if include_auth %}
    if user_id is None:
        return None
    user = await UserService(db).get_user_by_id(user_id)
    return user.email if user is not None else None
{%- else %}
    return None
{%- endif %}
