"""Organization and membership models."""
{% if include_auth_org %}

from datetime import UTC, datetime, timedelta

import sqlalchemy as sa
from sqlmodel import Field, SQLModel

from app.core.time import utcnow


# Org membership role constants
ORG_ROLE_OWNER = "owner"
ORG_ROLE_ADMIN = "admin"
ORG_ROLE_MEMBER = "member"
VALID_ORG_ROLES = {ORG_ROLE_OWNER, ORG_ROLE_ADMIN, ORG_ROLE_MEMBER}

# Default invite expiry. Pre-fix invites were valid forever, which
# turned a leaked invite link into a permanent acceptance bearer.
INVITE_EXPIRY_DAYS = 14


def _default_invite_expiry() -> datetime:
    return (datetime.now(UTC) + timedelta(days=INVITE_EXPIRY_DAYS)).replace(tzinfo=None)


class OrganizationBase(SQLModel):
    """Base organization model with shared fields."""

    name: str = Field(index=True)
    # No ``index=True`` here — the partial unique index declared in
    # ``Organization.__table_args__`` already covers ``slug`` lookups.
    slug: str
    description: str | None = None
    is_active: bool = Field(default=True)


class Organization(OrganizationBase, table=True):
    """Organization database model."""

    # Partial unique index on slug — uniqueness only enforced for live
    # rows, so an org can be recreated with the same slug after a soft
    # delete.
    __table_args__ = (
        sa.Index(
            "ix_organization_slug",
            "slug",
            unique=True,
            sqlite_where=sa.text("deleted_at IS NULL"),
            postgresql_where=sa.text("deleted_at IS NULL"),
        ),
    )

    id: int | None = Field(default=None, primary_key=True)
    created_at: datetime = Field(
        default_factory=lambda: utcnow()
    )
    updated_at: datetime | None = None
    deleted_at: datetime | None = Field(default=None, index=True)


class OrganizationMember(SQLModel, table=True):
    """Organization membership database model."""

    __tablename__ = "organization_member"
    __table_args__ = (
        sa.UniqueConstraint("organization_id", "user_id", name="uq_org_member_org_user"),
    )

    id: int | None = Field(default=None, primary_key=True)
    organization_id: int = Field(foreign_key="organization.id", index=True)
    user_id: int = Field(foreign_key="user.id", index=True)
    role: str = Field(default=ORG_ROLE_MEMBER)
    joined_at: datetime = Field(
        default_factory=lambda: utcnow()
    )


class OrgCreate(OrganizationBase):
    """Organization creation model."""

    pass


class OrgResponse(OrganizationBase):
    """Organization response model."""

    id: int
    created_at: datetime
    updated_at: datetime | None = None


class MemberResponse(SQLModel):
    """Organization member response model."""

    id: int
    organization_id: int
    user_id: int
    role: str
    joined_at: datetime


class BulkAddMembersRequest(SQLModel):
    """Request body for bulk adding members to an organization."""

    user_ids: list[int]
    role: str = "member"


class OrgInvite(SQLModel, table=True):
    """Organization invite model."""

    __tablename__ = "org_invite"

    id: int | None = Field(default=None, primary_key=True)
    organization_id: int = Field(foreign_key="organization.id", index=True)
    email: str = Field(index=True)
    role: str = Field(default=ORG_ROLE_MEMBER)
    invited_by: int = Field(foreign_key="user.id")
    status: str = Field(default="pending")  # pending, accepted
    token: str = Field(unique=True, index=True)
    created_at: datetime = Field(
        default_factory=lambda: utcnow()
    )
    # Nullable so legacy rows backfilled by the expiry migration don't
    # break. New invites always get a value via ``_default_invite_expiry``;
    # the accept paths treat NULL as "no expiry recorded" (pre-migration
    # behavior) so historical pending invites keep working in the grace
    # window after upgrade.
    expires_at: datetime | None = Field(default_factory=_default_invite_expiry)


class InviteCreate(SQLModel):
    """Invite creation request."""

    email: str
    role: str = "member"


class AcceptInviteRequest(SQLModel):
    """Request to accept an invite by token."""

    token: str


class TransferOwnershipRequest(SQLModel):
    """Request to transfer org ownership."""

    user_id: int


class InviteResponse(SQLModel):
    """Invite response model.

    ``token`` is intentionally omitted: it's a bearer credential
    delivered by email at invite-creation time, not something an
    admin's listing endpoint should hand back on demand. Re-exposing
    it via this response would let anyone who briefly had admin (or
    who leaked the listing payload) accept every still-pending invite.
    """

    id: int
    organization_id: int
    email: str
    role: str
    status: str
    created_at: datetime
    expires_at: datetime | None = None


class MemberDetailResponse(SQLModel):
    """Detailed member info including user data."""

    user_id: int
    email: str
    full_name: str | None
    role: str
    joined_at: datetime


class UserMembershipResponse(SQLModel):
    """Membership info for dashboard user display."""

    user_id: int
    org_name: str
    org_slug: str
    role: str
