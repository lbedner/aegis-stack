@app.command(help=lazy_t("payment.help_webhook"))
def webhook(
    port: int = typer.Option(8000, "--port", "-p", help=lazy_t("payment.opt_port")),
) -> None:
    """Run `stripe listen` and forward events to the local webhook endpoint.

    Shells out to the Stripe CLI (https://stripe.com/docs/stripe-cli). If
    stripe-cli is not installed, prints platform-specific install instructions
    and exits.
    """
    import os
    import platform
    import shutil

    if not shutil.which("stripe"):
        console.print(f"[{theme.ERROR}]{t('payment.stripe_cli_not_found')}[/]\n")
        system = platform.system()
        if system == "Darwin":
            console.print(t("payment.install_homebrew"))
            console.print(f"  [{theme.ACCENT}]brew install stripe/stripe-cli/stripe[/]")
        elif system == "Windows":
            console.print(t("payment.install_scoop"))
            console.print(f"  [{theme.ACCENT}]scoop install stripe[/]")
        else:
            console.print(t("payment.install_other"))
        console.print(f"\n{t('payment.then_authenticate')}")
        raise typer.Exit(1)

    target = f"localhost:{port}/api/v1/payment/webhook"
    console.print(t("payment.forwarding", target=target))
    console.print(f"[dim]{t('payment.press_ctrl_c')}[/dim]\n")

    os.execvp("stripe", ["stripe", "listen", "--forward-to", target])


# Marker that ``stripe trigger`` stamps on every Product it auto-creates.
# Source of truth: stripe-cli fixture JSON files under
# ``pkg/fixtures/triggers/`` in the stripe-cli repo. Our app never writes
# Products, so equality on this string is a safe identifier for fixture
# debris.
_CLI_FIXTURE_DESCRIPTION = "(created by Stripe CLI)"


@app.command(help=lazy_t("payment.help_trigger"))
def trigger(
    event: str = typer.Argument(..., help=lazy_t("payment.arg_event")),
    no_cleanup: bool = typer.Option(
        False,
        "--no-cleanup",
        help=lazy_t("payment.opt_no_cleanup"),
    ),
) -> None:
    """pytest-style test trigger: setup → event → teardown.

    Stripe CLI's ``stripe trigger`` creates a throwaway Product + Price
    in your test account as part of its fixture scaffolding, then fires
    a webhook event referencing them. Stripe CLI never cleans the
    fixtures up — they pile up in the dashboard and pollute dropdowns
    that list active catalog entries.

    This wrapper treats each invocation like a pytest test case: run
    the setup (stripe trigger), let the event fire, then archive the
    fixture Products/Prices before returning. Pre-existing fixture
    debris from prior unwrapped runs is swept too, so the account
    converges on clean.

    Examples::

        my-app payment trigger checkout.session.completed
        my-app payment trigger payment_intent.succeeded
        my-app payment trigger customer.subscription.created --no-cleanup
    """
    import shutil
    import subprocess

    from app.core.config import settings

    if not shutil.which("stripe"):
        console.print(f"[{theme.ERROR}]{t('payment.stripe_cli_not_found')}[/]")
        console.print(t("payment.stripe_install_brief"))
        raise typer.Exit(1)

    api_key = settings.STRIPE_SECRET_KEY or ""
    if not api_key:
        console.print(f"[{theme.ERROR}]{t('payment.stripe_secret_missing')}[/]")
        raise typer.Exit(1)

    if not api_key.startswith("sk_test_"):
        console.print(f"[{theme.ERROR}]{t('payment.refuse_live_key')}[/]")
        raise typer.Exit(1)

    console.print(t("payment.triggering", event=event))
    result = subprocess.run(
        ["stripe", "trigger", "--api-key", api_key, event],
        capture_output=False,
    )
    if result.returncode != 0:
        console.print(
            f"[{theme.ERROR}]{t('payment.trigger_exited', code=result.returncode)}[/]"
        )
        # Still attempt cleanup — partial failures can leave partial
        # fixtures in place.

    if no_cleanup:
        console.print(f"[dim]{t('payment.skipping_cleanup')}[/dim]")
        raise typer.Exit(result.returncode)

    archived = _archive_fixtures(api_key)
    if archived["products"] or archived["prices"]:
        console.print(
            t(
                "payment.cleaned_up",
                products=archived["products"],
                prices=archived["prices"],
            )
        )
    else:
        console.print(f"[dim]{t('payment.no_fixture_debris')}[/dim]")

    raise typer.Exit(result.returncode)


def _archive_fixtures(api_key: str) -> dict[str, int]:
    """Archive all fixture-descriptioned Products and their Prices.

    Returns a count dict. Idempotent: a second call with nothing left
    to archive is a no-op. Failures on individual rows are logged and
    swallowed so one API hiccup doesn't skip the rest.
    """
    import stripe

    stripe.api_key = api_key
    archived_products = 0
    archived_prices = 0

    try:
        for product in stripe.Product.list(active=True, limit=100).auto_paging_iter():
            if product.description != _CLI_FIXTURE_DESCRIPTION:
                continue

            # Archive every active Price under this fixture product
            # first; Prices can stay active after their Product is
            # archived, and leaving them would keep them visible in
            # endpoints that list prices directly.
            for price in stripe.Price.list(
                product=product.id, active=True, limit=100
            ).auto_paging_iter():
                try:
                    stripe.Price.modify(price.id, active=False)
                    archived_prices += 1
                except Exception as e:
                    console.print(
                        f"[{theme.WARNING}]{t('payment.could_not_archive_price', id=price.id, error=e)}[/]"
                    )

            try:
                stripe.Product.modify(product.id, active=False)
                archived_products += 1
            except Exception as e:
                console.print(
                    f"[{theme.WARNING}]{t('payment.could_not_archive_product', id=product.id, error=e)}[/]"
                )
    except Exception as e:
        console.print(
            f"[{theme.WARNING}]{t('payment.fixture_cleanup_aborted', error=e)}[/]"
        )

    return {"products": archived_products, "prices": archived_prices}


# ---------------------------------------------------------------------------
# End-to-end live-Stripe smoke
# ---------------------------------------------------------------------------
#
# The block below is intentionally plain English (no i18n) - it's a
# developer-facing tool, not user-facing. Drives a real
# subscribe -> plan-change -> refund -> cancel chain against test-mode
# Stripe and verifies that each leg's webhook + email-tag landed.
# Requires --primary-price and --secondary-price; configure them with
# two distinct active prices from your Stripe Dashboard.


@app.command(name="e2e")
def e2e(
    user_email: str = typer.Option(
        ...,
        "--user",
        "-u",
        help=(
            "Email of an existing user to drive the test against. "
            "The user must already have a PaymentCustomer row (any prior "
            "checkout will have created one)."
        ),
    ),
    primary_price: str = typer.Option(
        ...,
        "--primary-price",
        help=(
            "REQUIRED. Stripe price id for the initial subscription "
            "(e.g. ``price_xxx``)."
        ),
    ),
    secondary_price: str = typer.Option(
        ...,
        "--secondary-price",
        help=(
            "REQUIRED. Stripe price id to switch INTO during the "
            "plan-change leg. Must differ from primary."
        ),
    ),
    cleanup: bool = typer.Option(
        True,
        "--cleanup/--no-cleanup",
        help=(
            "Cancel the subscription at the end. ``--no-cleanup`` leaves "
            "it active so you can inspect the resulting Stripe / DB state "
            "by hand."
        ),
    ),
    skip_existing: bool = typer.Option(
        False,
        "--skip-existing",
        help=(
            "If the user already has an active subscription, normally we "
            "cancel it first to start clean. Pass this to bail instead "
            "(safer in shared dev environments)."
        ),
    ),
) -> None:
    """Drive a live end-to-end test of the money flow against real Stripe.

    Walks the full lifecycle: subscribe -> plan-change -> refund -> cancel,
    asserting after each step that the DB row + email-delivery tag landed
    correctly. Uses the real PaymentService + StripeProvider so the
    coverage matches what production would do; webhooks fire normally
    through ``stripe listen``. Test cards (``tok_visa``) are attached
    via the Stripe SDK to bypass the browser checkout redirect - this
    means we don't exercise the ``/checkout`` page route itself, just
    the server-side handlers and the email pipeline.

    Recommended invocation::

        {{ project_slug }} payment e2e \\
            --user you@example.com \\
            --primary-price price_xxx \\
            --secondary-price price_yyy

    Exit codes:
      0 - every leg passed
      1 - at least one leg failed (check the console output for the
          ``[red]FAIL[/red]`` markers + the per-step error detail)
    """
    asyncio.run(
        _e2e(
            user_email=user_email,
            primary_price=primary_price,
            secondary_price=secondary_price,
            cleanup=cleanup,
            skip_existing=skip_existing,
        )
    )
