def test_compare_picks_two_runs(client: TestClient, two_runs: tuple[int, int]) -> None:
    before, after = two_runs
    html = page_html(client, f"{PAGE}?tab=compare")

    assert chosen(html, "#ai-evals-pick select[name=a]") == str(before)
    assert chosen(html, "#ai-evals-pick select[name=b]") == str(after)
    none(html, "#ai-evals-compare")


def test_compare_shows_only_what_changed_flips_first_answers_side_by_side(
    client: TestClient, two_runs: tuple[int, int]
) -> None:
    before, after = two_runs
    html = page_html(client, f"{PAGE}?tab=compare&a={before}&b={after}")

    (flip,) = table_rows(html, "#ai-evals-compare table")
    assert text(flip["Case"]) == "reads the paper" and text(flip["Change"]) == "flipped"
    assert (text(flip["Before"]), text(flip["After"])) == ("Passed", "Failed")
    side = one(html, "#ai-evals-compare [data-detail]")
    assert "The letter says hello." in text(side) and "I could not find it." in text(side)
    assert "dataset changed" in text(one(html, "[data-evals-notice]"))


