{%- if ai_framework == "langchain" -%}
"""The LangChain turn, end to end, on both entrypoints.

LangChain streams text deltas, and token counts only where its provider
reports them: no tool events, no staged readings. ``chat()`` runs
``stream_chat()`` to its end, so both finish a turn on exactly that. This is the path the pydantic-ai
harness cannot reach, and the one that broke when the post-stream
bookkeeping assumed the pydantic-ai event stream had run.
"""

from collections.abc import AsyncIterator
import json
from typing import Any
from unittest.mock import AsyncMock, MagicMock

from langchain_core.messages import AIMessageChunk, ToolMessage
import pytest

import app.services.ai.service.chat as chat_module
{%- if ai_backend != "memory" %}
import app.services.ai.service.turn as turn_module
{%- endif %}
from app.services.ai.domains.chat.agent_loader import DEFAULT_AGENT_SLUG, AgentConfig
from app.services.ai.service import AIService, langchain_turn

PIECES = ("Hel", "lo ", "there")



def _prepared(llm: Any, tools: dict[str, Any] | None = None) -> Any:
    """An async ``_prepare_llm_and_messages`` stand-in handing back ``llm``
    and its bound ``tools``."""

    async def prepare(*args: Any, **kwargs: Any) -> tuple[Any, list[Any], dict]:
        return llm, [], tools or {}

    return prepare

class _Chunk:
    def __init__(self, content: str, **metadata: str) -> None:
        self.content = content
        self.response_metadata = metadata
        self.usage_metadata: dict[str, int] | None = None


class _FakeLLM:
    """What ``_prepare_llm_and_messages`` hands back under LangChain."""

    async def astream(self, messages: Any) -> AsyncIterator[_Chunk]:
        for piece in PIECES:
            yield _Chunk(piece)


def _default_config() -> AgentConfig:
    return AgentConfig(
        slug=DEFAULT_AGENT_SLUG,
        name="Assistant",
        system_prompt="You help.",
        model_id=None,
        temperature=0.2,
        max_tokens=512,
    )


@pytest.fixture
def harness(
    mock_ai_settings: MagicMock, monkeypatch: pytest.MonkeyPatch
) -> tuple[AIService, MagicMock]:
    """AIService with contexts, the agent row and the runtime faked out, so
    the turn runs on the fake LLM alone."""
    service = AIService(mock_ai_settings)


    async def resolve(slug: str = DEFAULT_AGENT_SLUG, **kwargs: object) -> AgentConfig:
        return _default_config()

    monkeypatch.setattr(chat_module, "resolve_agent", resolve)

    recorder = AsyncMock(return_value=0.0)  # the cost it priced
{%- if ai_backend != "memory" %}

    async def no_memory(user_id: str, **kwargs: object) -> None:
        return None

    monkeypatch.setattr(turn_module, "build_user_memory_context", no_memory)
    monkeypatch.setattr(service, "_record_usage", recorder)
{%- endif %}

    monkeypatch.setattr(AIService, "_prepare_llm_and_messages", _prepared(_FakeLLM()))
    return service, recorder


class _ToolCallingLLM:
    """Calls ``lookup`` (after a line of commentary), then answers from
    what it returned."""

    def bind_tools(self, tools: Any) -> "_ToolCallingLLM":
        return self

    async def astream(self, history: Any) -> AsyncIterator[AIMessageChunk]:
        answered = [m for m in history if isinstance(m, ToolMessage)]
        if answered:
            yield AIMessageChunk(content=f"Found {json.loads(answered[0].content)['found']}")
            return
        yield AIMessageChunk(
            content="Let me look. ",
            tool_call_chunks=[
                {"name": "lookup", "args": '{"q": "x"}', "id": "c1", "index": 0}
            ],
        )


class TestGrantedToolsRun:
    """Granted tools run on LangChain's runtime as on Pydantic AI's: bound
    to the model, she could call none of them before (2026-10-16)."""

    async def test_a_tool_the_model_calls_runs_and_it_answers_from_it(
        self, harness: tuple[AIService, MagicMock], monkeypatch: pytest.MonkeyPatch
    ) -> None:
        service, _ = harness
        asked: list[str] = []

        async def lookup(q: str) -> dict[str, str]:
            """Look ``q`` up."""
            asked.append(q)
            return {"found": q.upper()}

        llm, tools = langchain_turn.bound(_ToolCallingLLM(), [lookup])
        monkeypatch.setattr(
            AIService, "_prepare_llm_and_messages", _prepared(llm, tools)
        )

        message = await service.chat("look x up")

        assert asked == ["x"]
        # What it said before calling the tool is commentary, not the answer.
        assert message.content == "Found X"


class TestLangChainChat:
    async def test_chat_returns_the_model_reply(
        self, harness: tuple[AIService, MagicMock]
    ) -> None:
        service, recorder = harness

        message = await service.chat("hello")

        assert message.content == "Hello there"
        assert message.metadata["conversation_id"]
{%- if ai_backend != "memory" %}
        recorder.assert_called_once()
        assert recorder.call_args.args[0] == f"chat:{DEFAULT_AGENT_SLUG}"
{%- endif %}


class TestLangChainStreaming:
    async def test_stream_yields_deltas_then_one_final_chunk(
        self, harness: tuple[AIService, MagicMock]
    ) -> None:
        service, recorder = harness

        chunks = [
            chunk
            async for chunk in service.stream_chat("hello", stream_delta=True)
        ]

        deltas = [c for c in chunks if not c.is_final]
        assert [c.content for c in deltas] == list(PIECES)
        final = chunks[-1]
        assert final.is_final
        assert final.content == "Hello there"
        assert final.metadata["stream_complete"] is True
        # No tools ran, so no trail is attached.
        assert "tool_trace" not in final.metadata
{%- if ai_backend != "memory" %}
        # This model reports no token counts: the turn is ledgered at zero
        # rather than not at all. It IS timed, though - no tokens does not
        # mean no wall clock.
        recorder.assert_called_once()
        assert recorder.call_args.args == (
            f"chat:{DEFAULT_AGENT_SLUG}",
            {"input_tokens": 0, "output_tokens": 0},
            "default",
        )
        assert recorder.call_args.kwargs["duration_ms"] > 0
        assert final.metadata["input_tokens"] == 0
        assert final.metadata["output_tokens"] == 0

    async def test_token_counts_ride_the_chunks_that_carry_them(
        self, harness: tuple[AIService, MagicMock], monkeypatch: pytest.MonkeyPatch
    ) -> None:
        """Where a provider counts while streaming, the counts add up across
        the chunks carrying them (Anthropic splits input and output)."""
        service, recorder = harness

        class _Counted(_FakeLLM):
            async def astream(self, messages: Any) -> AsyncIterator[_Chunk]:
                first, last = _Chunk("Hi"), _Chunk("")
                first.usage_metadata = {"input_tokens": 12, "output_tokens": 0}
                last.usage_metadata = {"input_tokens": 0, "output_tokens": 3}
                yield first
                yield last

        monkeypatch.setattr(
            AIService, "_prepare_llm_and_messages", _prepared(_Counted())
        )
        await service.chat("hello")

        assert recorder.call_args.args[1] == {"input_tokens": 12, "output_tokens": 3}
{%- endif %}

    @pytest.mark.parametrize(
        "metadata",
        [
            {"finish_reason": "length"},  # OpenAI
            {"stop_reason": "max_tokens"},  # Anthropic
            {"done_reason": "length"},  # Ollama
        ],
    )
    async def test_a_reply_cut_off_at_the_limit_says_so(
        self,
        harness: tuple[AIService, MagicMock],
        monkeypatch: pytest.MonkeyPatch,
        metadata: dict[str, str],
    ) -> None:
        """The stop reason rides the last chunk, under each provider's key."""
        service, _recorder = harness

        class _CutOff(_FakeLLM):
            async def astream(self, messages: Any) -> AsyncIterator[_Chunk]:
                yield _Chunk("Half a sen")
                yield _Chunk("", **metadata)

        monkeypatch.setattr(
            AIService, "_prepare_llm_and_messages", _prepared(_CutOff())
        )
        final = [chunk async for chunk in service.stream_chat("hello")][-1]
        assert final.metadata["finish_reason"] == "length"

    async def test_stream_persists_the_assembled_reply(
        self, harness: tuple[AIService, MagicMock]
    ) -> None:
        service, _recorder = harness

        final = [chunk async for chunk in service.stream_chat("hello")][-1]

        saved = await service.conversation_manager.get_conversation(
            final.conversation_id
        )
        assert saved is not None
        assert saved.messages[-1].content == "Hello there"
{%- endif %}
