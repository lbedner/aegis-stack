# A dataset: cases from real conversations, each scored on what its turn
# did (the tools it called) before what it said. ``script`` is the turn
# the case expects, played without a model in the project's tests
# (``run_dataset(name, scripted=True)``); unscripted, each case asks the
# active model.
#
# Add a case when a regression is found by reading logs: copy the message,
# write the assertion you wish you had had.
cases:
  - name: a greeting needs no tools
    inputs:
      message: hi there
      script:
        - text: Hello! What can I help you with?
    evaluators:
      - ToolCalls:
          tool: {{ "run_code" if ai_backend != "memory" else "plugins" }}
          times: 0

  - name: what is installed is read, not guessed
    inputs:
      message: which plugins does this app have?
      script:
{%- if ai_backend != "memory" %}
        - tool: run_code
          args:
            code: "found = await plugins()\nfound"
{%- else %}
        - tool: plugins
{%- endif %}
        - text: Here are the plugins this app has installed.
    evaluators:
      - ToolCalls:
          tool: plugins
          times: 1

  - name: a number it was never given is not invented
    inputs:
      message: what is my account balance?
      script:
        - text: I can't see any account balance from here.
    evaluators:
      - AnswerAvoids:
          terms: ["$"]
