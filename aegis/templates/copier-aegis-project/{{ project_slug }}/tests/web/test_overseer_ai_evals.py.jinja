@pytest.mark.queryspy(allow_n_plus_one=True)  # each request reads the dataset
def test_a_dataset_is_deleted_once_confirmed(client: TestClient, hx: TestClient) -> None:
    """Asked first, in a dialog that says its runs stay; then the dataset
    goes and the section is back on its datasets."""
    opener = one(page_html(client, f"{PAGE}?dataset=mini"), "[data-evals-delete]")
    asked = client.get(opener.get("hx-get"))

    assert "runs stay" in asked.text
    assert client.get(PAGE, params={"dataset": "mini"}).status_code == 200
    response = hx.delete(one(Markup(asked.text), "[hx-delete]").get("hx-delete"))

    assert response.status_code == 200, response.text
    assert client.get(PAGE, params={"dataset": "mini"}).status_code == 404
    assert "dataset=" not in location(response)
    assert "dialog:close" in triggers(response)


@pytest.mark.queryspy(allow_n_plus_one=True)  # each request reads the dataset
def test_a_file_is_imported_opened_and_downloaded_as_it_was_written(
    client: TestClient, hx: TestClient
) -> None:
    """Import names the dataset by its file, over one of that name only
    where Replace is ticked; Download hands back the same text."""
    form = one(page_html(client, PAGE), "#ai-evals-import")
    url = form.get("hx-post")
    assert one(form, "input[name=replace]").get("value") == "true"
    written = "# Imported.\n" + DATASET

    imported = hx.post(url, files={"file": ("ops.yaml", written)})
    taken = hx.post(url, files={"file": ("mini.yaml", written)})
    replaced = hx.post(url, data={"replace": "true"}, files={"file": ("mini.yaml", written)})

    assert location(imported).endswith("?dataset=ops")
    toast = triggers(taken)["toast"]
    assert toast["tone"] == "error" and "already exists" in toast["text"]
    assert location(replaced).endswith("?dataset=mini")
    download = one(page_html(client, f"{PAGE}?dataset=mini"), "#ai-evals-dataset a[href$='/yaml']")
    downloaded = client.get(download.get("href"))
    assert downloaded.text == written
    assert 'filename="mini.yaml"' in downloaded.headers["content-disposition"]


