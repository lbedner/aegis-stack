"""The Overseer AI page's Evals section, in three tabs. Datasets: each in a
row, one opened on its cases (what each asks and passes on, its last
result) with a Run that starts it as a job (``start_evals``, on the worker
where there is one) followed here as it goes. Runs: every kept run,
filtered by dataset and model, one opened on its cases, failed first, each
with its answer, its checks in words and the calls its turn made. Compare:
what changed between two runs, flips first, each side's answer. Reads are
the eval queries (``eval_runs``) and the dataset store the CLI and the API
read; what is done to a dataset is ``overseer_ai_evals_datasets``.
"""

from collections.abc import AsyncIterator, Mapping
from typing import TYPE_CHECKING, Any
from urllib.parse import urlencode

from fastapi import HTTPException
from markupsafe import Markup

from app.core.formatting import (
    counted,
    format_cost,
    format_duration_ms,
    format_relative_time,
)
from app.services.ai.service import (
    EVALS_JOB,
    EVALS_WRITING_JOB,
    EvalCase,
    EvalRun,
    EvalScore,
    eval_called,
    eval_dataset,
    eval_dataset_summaries,
    eval_dataset_summed,
    eval_dataset_text,
    eval_runs,
    start_evals,
)
from app.services.system.jobs import get_job_runner

from .chat_models import model_choices, running_model
from .chat_surface import run as tool_run
from .overseer_ai_common import PARTIALS, dollars, section_url, tab_links
from .overseer_ai_evals_datasets import DATASETS_URL, options, or_404
from .overseer_live import job_frames, job_state
from .rendering import hx_replace, status_cell

if TYPE_CHECKING:
    from sqlmodel.ext.asyncio.session import AsyncSession

SECTION = section_url("evals")
RUNS_URL = f"{PARTIALS}/evals/runs"
TABS = {"datasets": "Datasets", "runs": "Runs", "compare": "Compare"}


async def evals_context(db: "AsyncSession", query: Mapping[str, str]) -> dict[str, Any]:
    """The tab asked for under the tab row: Datasets (or one, ``dataset``),
    Runs (filtered by ``dataset`` and ``model``, or one, ``run``) or
    Compare (``a`` and ``b``); a running job (a run, or a dataset being
    written) over Datasets and Runs."""
    tab = query.get("tab", "")
    tab = "runs" if query.get("run", "").isdigit() else tab if tab in TABS else "datasets"
    frame = {"section": SECTION, "tabs": tab_links("evals", TABS, tab, "datasets")}
    if tab == "compare":
        return frame | await _compare(db, query)
    if tab == "runs":
        view = await _run(db, int(query["run"])) if "run" in query else await _runs(db, query)
    elif query.get("dataset"):
        view = await _dataset(db, query["dataset"])
    else:
        view = await _datasets(db)
    here = section_url("evals", **{k: v for k, v in query.items() if k != "job"})
    return frame | view | {"job": await _banner(query.get("job"), here)}


def _passed(run: EvalRun) -> str:
    return f"{run.passed} / {run.cases}"


def _passed_cell(run: EvalRun) -> dict[str, str]:
    """A run's passed count, as a status cell: ok only when every case passed."""
    return status_cell(_passed(run), _tone(run.passed, run.cases))


def _verdict(passed: bool) -> dict[str, str]:
    """A case's pass or fail, as a status cell."""
    return status_cell("Passed" if passed else "Failed", "ok" if passed else "error")


def _tone(passed: int, cases: int) -> str:
    """A run's tone: ok only when every case passed."""
    return "ok" if passed == cases else "error"


def _run_url(run_id: int | None) -> str:
    return section_url("evals", run=str(run_id))


async def _datasets(db: "AsyncSession") -> dict[str, Any]:
    """Each dataset in a row: what it checks, how many cases, its last run."""
    # ponytail: the last run is read from the latest runs; a dataset not
    # run among them shows none.
    runs = await eval_runs.runs(db)
    summaries = []
    for found in await eval_dataset_summaries(db):
        name = found.name
        last = next((r for r in runs if r.dataset == name), None)
        summaries.append(
            {
                "dataset": {"label": name, "url": section_url("evals", dataset=name)},
                "about": found.about,
                "cases": len(found.cases),
                "last": last and _passed_cell(last),
            }
        )
    return {
        "view": "datasets",
        "summaries": summaries,
        "new_url": f"{DATASETS_URL}/new",
        "import_url": f"{DATASETS_URL}/import",
    }


async def _results(db: "AsyncSession", run: EvalRun) -> dict[str, dict[str, Any]]:
    """Each case of ``run`` as it went (``_result``), by name: the run's
    cases and their scores in two reads."""
    assert run.id is not None
    by_case: dict[int | None, list[EvalScore]] = {}
    for score in await eval_runs.run_scores(db, run.id):
        by_case.setdefault(score.case_id, []).append(score)
    return {
        case.name: _result(run, case, by_case.get(case.id, []))
        for case in await eval_runs.cases(db, run.id)
    }


def _result(run: EvalRun, case: EvalCase, scores: list[EvalScore]) -> dict[str, Any]:
    """A case as it went: what it asked and answered, how long and what it
    took, each check by its rule with its mark and why, and its calls,
    summed up and each one's arguments."""
    asked = case.inputs.get("message")
    return {
        "passed": case.passed,
        "asked": asked if isinstance(asked, str) else None,
        "answer": case.output,
        "error": case.error,
        "took": format_duration_ms(case.duration_ms),
        "cost": _cost(case.cost),
        "run": {"id": run.id, "url": _run_url(run.id)},
        "checks": [
            {
                "rule": s.rule,
                "passed": s.passed if s.passed is not None else bool(s.value),
                "reason": s.reason,
            }
            for s in scores
        ],
        "called": eval_called(case.tool_calls),
        "calls": [tool_run(call) for call in case.tool_calls],
    }


async def _whys(db: "AsyncSession", name: str) -> dict[str, str | None]:
    """Why each case of ``name`` is there, as the dataset says now."""
    try:
        return {c.name: c.why for c in (await eval_dataset(db, name)).cases}
    except ValueError:  # no such dataset now, or one that cannot be read
        return {}


async def _dataset(db: "AsyncSession", name: str) -> dict[str, Any]:
    """A dataset opened: each case, what it asks and passes on and how it
    went in the dataset's last run; the Run, on the model picked. One that
    cannot be read says why (``eval_dataset_summed``), to be deleted."""
    found = eval_dataset_summed(name, await or_404(eval_dataset_text(db, name)))
    last = next(iter(await eval_runs.runs(db, name, limit=1)), None)
    results = await _results(db, last) if last else {}
    return {
        "view": "dataset",
        "dataset": found,
        "cases": [
            {
                "case": {"label": c.name, "sub": c.why},
                "asks": c.message,
                "checks": "; ".join(c.checks),
                "last": _verdict(results[c.name]["passed"]) if c.name in results else None,
                "result": results.get(c.name),
            }
            for c in found.cases
        ],
        "run_label": f"Run {counted(len(found.cases), 'case')}",
        "delete_url": f"{DATASETS_URL}/{found.name}/delete",
        "export_url": f"{DATASETS_URL}/{found.name}/yaml",
        "models": await model_choices(db, None),
        "active": f"{await running_model()} (active)",
        "start_url": RUNS_URL,
    }


def _run_row(run: EvalRun) -> dict[str, Any]:
    return {
        "run": {"label": str(run.id), "url": _run_url(run.id)},
        "dataset": run.dataset,
        "passed": _passed_cell(run),
        "model": run.model_id,
        "build": run.build,
        "cost": dollars(run.total_cost),
        "when": format_relative_time(run.started_at),
        "note": run.note,
    }


async def _runs(db: "AsyncSession", query: Mapping[str, str]) -> dict[str, Any]:
    """Every kept run, newest first, of a ``dataset`` and on a ``model``
    where picked."""
    dataset, model = query.get("dataset") or None, query.get("model") or None
    runs = await eval_runs.runs(db, dataset, model=model)
    return {
        "view": "runs",
        "rows": [_run_row(r) for r in runs],
        "datasets": options(await eval_runs.datasets(db)),
        "models": options(await eval_runs.models(db)),
        "picked": {"dataset": dataset, "model": model},
    }


async def _run(db: "AsyncSession", run_id: int) -> dict[str, Any]:
    """One run: its facts, its cases (failed first, those opened), and the
    run before it of the same dataset, to compare with."""
    run = await eval_runs.run(db, run_id)
    if run is None or run.id is None:
        raise HTTPException(status_code=404, detail="No such run.")
    results = await _results(db, run)
    whys = await _whys(db, run.dataset)
    earlier = await eval_runs.previous(db, run)
    cases = [
        {
            "case": {"label": name, "sub": whys.get(name)},
            "result_cell": _verdict(result["passed"]),
            "took": result["took"],
            "cost": result["cost"],
            "result": result,
            "open": not result["passed"],
        }
        for name, result in results.items()
    ]
    return {
        "view": "run",
        "run": run,
        "facts": [
            ("Dataset", run.dataset),
            ("Passed", _passed(run)),
            ("Model", run.model_id),
            ("Build", run.build),
            ("Cost", dollars(run.total_cost)),
            ("Started", format_relative_time(run.started_at)),
            ("Started by", run.trigger),
            ("Note", run.note),
        ],
        "cases": sorted(cases, key=lambda c: not c["open"]),
        "compare": earlier
        and section_url("evals", tab="compare", a=str(earlier), b=str(run.id)),
    }


def _pair(before: str | None, after: str | None) -> str:
    """A figure in each of two runs, ``-`` where one has none."""
    return f"{before or '-'} → {after or '-'}"


def _score(value: float | None) -> str | None:
    return None if value is None else f"{value:g}"


def _cost(cost: float | None) -> str | None:
    return None if cost is None else format_cost(cost)


def _took(run: EvalRun) -> str:
    return format_duration_ms((run.finished_at - run.started_at).total_seconds() * 1000)


def _notice(before: EvalRun, after: EvalRun, changed: bool | None) -> str | None:
    """What to know before reading a comparison: other datasets, or the
    same one changed, or no telling."""
    if before.dataset != after.dataset:
        return f"These runs are of different datasets, {before.dataset} and {after.dataset}."
    if changed:
        return "The dataset changed between these runs: a case may be checked differently."
    if changed is None:
        return "A run kept no fingerprint of its dataset, so a change to it cannot be told."
    return None


def _side(label: str, side: eval_runs.CaseSide | None) -> dict[str, Any] | None:
    """One run's side of a changed case."""
    if side is None:
        return None
    return {
        "label": label,
        "verdict": _verdict(side.passed),
        "answer": side.output,
    }


def _change_row(delta: eval_runs.CaseDelta) -> dict[str, Any]:
    """A case that changed, as Compare reads it."""
    was, now = delta.before, delta.after
    tone = {"flipped": "ok" if now and now.passed else "error", "rule changed": "warn"}
    return {
        "case": delta.name,
        "change": status_cell(str(delta.change), tone.get(delta.change, "muted")),
        "before": _verdict(was.passed) if was else None,
        "after": _verdict(now.passed) if now else None,
        "cost": _pair(_cost(was.cost) if was else None, _cost(now.cost) if now else None),
        "took": _pair(
            format_duration_ms(was.duration_ms) if was else None,
            format_duration_ms(now.duration_ms) if now else None,
        ),
        "sides": [s for s in (_side("Before", was), _side("After", now)) if s],
        "scores": [{"rule": s.rule, "values": _pair(_score(s.before), _score(s.after))} for s in delta.scores],
        "open": delta.change == "flipped",
    }


async def _compare(db: "AsyncSession", query: Mapping[str, str]) -> dict[str, Any]:
    """Two runs to pick (the latest two unless picked) and, picked (``a``
    and ``b``), what changed between them, flips first."""
    runs = await eval_runs.runs(db)
    picked = query.get("a", "").isdigit() and query.get("b", "").isdigit()
    view: dict[str, Any] = {
        "view": "compare",
        "options": [
            {"id": r.id, "name": f"{r.id} · {r.dataset} · {_passed(r)}"} for r in runs
        ],
        "a": int(query["a"]) if picked else runs[1].id if len(runs) > 1 else None,
        "b": int(query["b"]) if picked else runs[0].id if runs else None,
        "compared": None,
    }
    if not picked:
        return view
    before, after = await eval_runs.run(db, view["a"]), await eval_runs.run(db, view["b"])
    if before is None or after is None or before.id is None or after.id is None:
        raise HTTPException(status_code=404, detail="No such run.")
    compared = await eval_runs.compare(db, before.id, after.id)
    return view | {
        "compared": {
            "runs": [
                {
                    "label": f"Run {r.id}",
                    "url": _run_url(r.id),
                    "facts": f"{_passed(r)}, {dollars(r.total_cost)}, {_took(r)}",
                }
                for r in (before, after)
            ],
            "notice": _notice(before, after, compared.dataset_changed),
            "rows": [_change_row(d) for d in compared.cases],
        }
    }


async def _banner(job_id: str | None, here: str) -> dict[str, Any] | None:
    """The run's job the page was sent to (``job``), else any run running;
    when it ends, it reloads ``here``."""
    runner = get_job_runner()
    if job_id:
        job = await runner.lookup(job_id)
    else:
        running = await runner.list_all()
        job = next(
            (j for j in running if j.status == "running" and j.name.startswith(EVALS_JOB)),
            None,
        )
    return job_view(job.as_dict(), here) if job else None


def _ended(done: dict[str, Any]) -> dict[str, Any]:
    """How a run went: how many passed, and the run to open; of a dataset
    written, how many of its cases were kept, and the run that decided."""
    run = done.get("run_id")
    link = run and _run_url(run)
    if "kept" in done:
        label = f"Kept {done['kept']} of {counted(done['written'], 'case')}"
        return {"label": label, "tone": "ok", "link": link}
    passed, cases = done.get("passed", 0), done.get("cases", 0)
    return {"label": f"{passed} of {cases} passed", "tone": _tone(passed, cases), "link": link}


def job_view(job: dict[str, Any], here: str = SECTION) -> dict[str, Any]:
    """A run's job as the section shows it (``job_state``), naming its
    dataset; its stream reloads ``here`` when it ends."""
    events = f"{PARTIALS}/evals/jobs/{job['job_id']}/events?" + urlencode({"then": here})
    name: str = job["name"]
    if name.startswith(EVALS_WRITING_JOB):
        title = f"Writing {name.removeprefix(EVALS_WRITING_JOB)}"
    else:
        title = f"Running {name.removeprefix(EVALS_JOB)}"
    return job_state(job, events, title, _ended)


def reload_of(then: str) -> Markup:
    """What a job's last state reloads: ``then``, a page of this section,
    else the section itself."""
    return hx_replace(then if then.startswith(SECTION) else SECTION, "#overseer-main")


def job_events(job_id: str, then: str = SECTION) -> AsyncIterator[str]:
    """A run's job over SSE (``job_frames``), the last state reloading the
    page it was on (``then``), so the new run is there."""
    return job_frames(job_id, job_view, reload_of(then))


async def start(form: Mapping[str, str]) -> str:
    """A run of the form's dataset started as a job: its id. ValueError
    (``start_evals``) for no such dataset, or a model that cannot answer."""
    return await start_evals(
        form.get("dataset", ""), model=form.get("model") or None, note=None
    )
