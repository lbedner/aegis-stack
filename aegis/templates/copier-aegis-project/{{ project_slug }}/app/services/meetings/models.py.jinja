"""Meetings tables: a meeting the bot was asked to join, the Google account
it joined as (an agent), who was in it, and what each of them said.

A person is one human across an owner's meetings; a participant is that
person as one call named them. Transcript times are seconds from the
moment the bot joined. The notes are one model pass over the finished
transcript (where the stack has a model), each item a row citing the lines
it came from; so is each person's guide, how to work with them, read
across the owner's meetings, and what each series of meetings (one link,
met again and again) keeps coming back to. Every link between them is a foreign key:
deleting a meeting deletes what was kept of it, and a deleted line takes
its citations with it.

``Notes`` and ``Guide`` are what the model writes and what the pages read;
the rows are how they are kept (``domains.notes``, ``domains.people``).
"""

from __future__ import annotations

from dataclasses import dataclass
from datetime import datetime
from enum import StrEnum
from typing import Literal

from pydantic import BaseModel
from pydantic import Field as Described
from pydantic.json_schema import SkipJsonSchema
from sqlalchemy import JSON, Column, Index, Text, UniqueConstraint
from sqlmodel import Field, SQLModel

from app.core.time import utcnow

# Search's SQLite tables, made beside these by every ``create_all``.
from app.services.meetings.domains.search import fts  # noqa: F401

# Who said a line nobody's caption named.
UNKNOWN = "Unknown"

# An owner column references ``user.id`` only when the stack has auth (a
# deleted user takes their meetings and people with them); without it the
# owner is a plain nullable integer, NULL on every row.
_OWNER_FK: str | None = {% if include_auth %}"user.id"{% else %}None{% endif %}


class Platform(StrEnum):
    MEET = "meet"
    TEAMS = "teams"
    ZOOM = "zoom"


class MeetingStatus(StrEnum):
    REQUESTED = "requested"
    JOINING = "joining"
    WAITING = "waiting"  # in the lobby, waiting to be admitted
    IN_CALL = "in_call"
    LEAVING = "leaving"  # asked to leave; the bot goes on its next look
    LEFT = "left"
    FAILED = "failed"


class BotAccount(SQLModel, table=True):
    """A Google account the bot joins calls as: an agent, to the people who
    use it. Each has its own name in the call and its own sign-in, kept as
    a secret (``login_secret``); the first is the default."""

    __tablename__ = "meeting_bot_account"

    id: int | None = Field(default=None, primary_key=True)
    name: str = Field(
        max_length=40,
        unique=True,
        description="What it is picked by: meetings login --agent work",
    )
    display_name: str = Field(
        max_length=100, description="The name it joins as: its Google account's own"
    )
    email: str | None = Field(default=None, max_length=320)
    login_secret: str = Field(
        max_length=128, description="The secret its saved sign-in is kept under"
    )
    created_at: datetime = Field(default_factory=utcnow)


class Meeting(SQLModel, table=True):
    """One call the bot was asked to join, and how far it got."""

    __tablename__ = "meeting"
    # An owner's meetings, newest first, straight off the index.
    __table_args__ = (
        Index("ix_meeting_owner_created", "owner_user_id", "created_at", "id"),
    )

    id: int | None = Field(default=None, primary_key=True)
    owner_user_id: int | None = Field(
        default=None,
        foreign_key=_OWNER_FK,
        ondelete="CASCADE",
        description="Who asked for the bot; NULL on a project without auth",
    )
    url: str = Field(max_length=2048)
    platform: str = Field(max_length=16)
    status: str = Field(default=MeetingStatus.REQUESTED, max_length=16)
    failure_reason: str | None = Field(
        default=None,
        max_length=500,
        description="Why it ended as failed: refused, timed out, the page changed",
    )
    bot_name: str = Field(max_length=100)
    account_id: int | None = Field(
        default=None,
        foreign_key="meeting_bot_account.id",
        description="The agent it was sent as",
    )
    created_at: datetime = Field(default_factory=utcnow)
    joined_at: datetime | None = None
    left_at: datetime | None = None
    seen_at: datetime | None = Field(
        default=None,
        description="The run's heartbeat: how a live run is told from a stopped one",
    )
    unattributed_seconds: float | None = Field(
        default=None,
        description="Seconds of audio the bot heard that no caption named",
    )


class CalendarEvent(SQLModel, table=True):
    """One time a meeting on an agent's calendar happens, as the calendar
    last said (``domains.calendar``): kept so the agent is sent on time and
    the calendar is drawn without reading every feed. ``key`` is the event's
    UID and the time it was first set for; ``meeting_id`` is the call the
    agent was sent into, while that meeting is kept."""

    __tablename__ = "meeting_calendar_event"
    __table_args__ = (
        UniqueConstraint("account_id", "key"),
        # What is on, in a window of time, straight off the index.
        Index("ix_meeting_calendar_event_starts", "starts_at"),
    )

    id: int | None = Field(default=None, primary_key=True)
    account_id: int = Field(
        foreign_key="meeting_bot_account.id",
        ondelete="CASCADE",
        description="The agent whose calendar it is on",
    )
    key: str = Field(max_length=1024)
    title: str = Field(default="", sa_type=Text)
    starts_at: datetime
    ends_at: datetime
    url: str | None = Field(default=None, max_length=2048)
    organizer: str | None = Field(default=None, max_length=320)
    emails: list[str] = Field(
        default_factory=list,
        sa_column=Column(JSON, nullable=False),
        description="Every email on the invite, the organizer's first",
    )
    cancelled: bool = False
    meeting_id: int | None = Field(
        default=None, foreign_key="meeting.id", ondelete="SET NULL"
    )
    sent_at: datetime | None = Field(
        default=None,
        description="When the agent was sent in: once, even if that meeting is deleted",
    )


class MeetingPerson(SQLModel, table=True):
    """One human across an owner's meetings: every participant a call named
    as them points here, so their guide, their threads and whether they are
    the owner ("me") follow them from call to call. A new name in a call is
    a new person until it is said to be someone already known."""

    __tablename__ = "meeting_person"
    __table_args__ = (Index("ix_meeting_person_owner_name", "owner_user_id", "name"),)

    id: int | None = Field(default=None, primary_key=True)
    owner_user_id: int | None = Field(
        default=None,
        foreign_key=_OWNER_FK,
        ondelete="CASCADE",
        description="Whose meetings they are in; NULL on a project without auth",
    )
    name: str = Field(max_length=255, description="The name the calls first gave them")
    is_me: bool = Field(
        default=False,
        description="The owner themself: whose action items are theirs",
    )
    created_at: datetime = Field(default_factory=utcnow)


class MeetingParticipant(SQLModel, table=True):
    """A person as one call named them while the bot was in it."""

    __tablename__ = "meeting_participant"
    __table_args__ = (
        Index("ix_meeting_participant_meeting", "meeting_id"),
        Index("ix_meeting_participant_person", "person_id"),
    )

    id: int | None = Field(default=None, primary_key=True)
    meeting_id: int = Field(foreign_key="meeting.id", ondelete="CASCADE")
    person_id: int = Field(foreign_key="meeting_person.id")
    display_name: str = Field(max_length=255)
    heard_seconds: float | None = Field(
        default=None, description="Seconds of their audio the bot heard"
    )


class TranscriptLine(SQLModel, table=True):
    """One thing one participant said."""

    __tablename__ = "meeting_transcript_line"
    __table_args__ = (
        Index("ix_meeting_transcript_line_meeting", "meeting_id", "start_seconds"),
    )

    id: int | None = Field(default=None, primary_key=True)
    meeting_id: int = Field(foreign_key="meeting.id", ondelete="CASCADE")
    participant_id: int | None = Field(
        default=None, foreign_key="meeting_participant.id", ondelete="CASCADE"
    )
    start_seconds: float
    end_seconds: float
    text: str


@dataclass(frozen=True)
class Caption:
    """One caption block as the call shows it now. ``line`` stays the same
    while the speaker's block grows, so it names the transcript line."""

    line: str
    speaker: str
    text: str


class NoteItem(BaseModel):
    # The row it is kept as; never asked of the model.
    id: SkipJsonSchema[int | None] = Described(default=None, exclude=True)
    text: str
    lines: list[int] = Described(
        default_factory=list, description="Ids of the transcript lines it came from"
    )


class ActionItem(NoteItem):
    owner: str | None = Described(
        default=None,
        description="The speaker who has to do it, named as in the transcript",
    )
    due: str | None = Described(default=None, description="When, if it was said")


class Commitment(ActionItem):
    """Someone said they would do something: ``owner`` will do ``text``,
    for ``to``, by ``due``."""

    to: str | None = Described(
        default=None,
        description="Who they said they would do it for, named as in the transcript",
    )


class FollowUp(NoteItem):
    """An earlier meeting's commitment raised again in this one. As the
    model writes it, ``commitment`` is the number it was shown; as kept and
    read, the commitment's own id (None once that commitment is gone)."""

    commitment: int | None = Described(
        description="The number in [C...] of the earlier commitment raised"
    )
    status: Literal["mentioned", "done", "dropped"] = Described(
        default="mentioned",
        description="Done, dropped, or only mentioned again and still open",
    )


class Contradiction(NoteItem):
    """Something said one way (``lines``) and the opposite way
    (``against``), by one person or two. As read, ``speakers`` are the
    people who said the lines on both sides."""

    speakers: list[str] = Described(
        default_factory=list,
        description="Who said the two things, named as in the transcript",
    )
    against: list[int] = Described(
        default_factory=list,
        description=(
            "Ids of the lines that say the opposite, in this meeting or an earlier one"
        ),
    )


class Position(NoteItem):
    """Where ``speaker`` stands (``text``) on ``topic``."""

    speaker: str = Described(description="Whose stance, named as in the transcript")
    topic: str
    shifted: str | None = Described(
        default=None, description="Where they stood before, when this is a change"
    )


class Notes(BaseModel):
    """What a meeting came to, as the model writes it and the pages read
    it. Notes kept before the threads (commitments onwards) read with
    none."""

    summary: str
    decisions: list[NoteItem] = []
    action_items: list[ActionItem] = []
    open_questions: list[NoteItem] = []
    # Described here as well as in the seeded prompt: a row seeded before
    # the threads keeps its old prompt, and this is what still reaches it.
    commitments: list[Commitment] = Described(
        default=[],
        description=(
            "Who said they would do what, for whom and by when, in their own words"
        ),
    )
    follow_ups: list[FollowUp] = Described(
        default=[],
        description=(
            "Each earlier commitment listed as [C...] that is raised again here:"
            " done, dropped, or only mentioned and still open"
        ),
    )
    contradictions: list[Contradiction] = Described(
        default=[],
        description=(
            "Something said one way and the opposite way, by one person or two,"
            " in this meeting or against an earlier line"
        ),
    )
    positions: list[Position] = Described(
        default=[],
        description=(
            "Where each person stands on the topics they spoke to, and where they"
            " stood before when it is a change"
        ),
    )

    def mine(self, me: set[str]) -> list[ActionItem]:
        """The action items one of ``me`` (the owner's names) has to do."""
        return [a for a in self.action_items if a.owner in me]


class MeetingNotes(SQLModel, table=True):
    """A meeting's notes as one model pass wrote them, or why it could not:
    the items themselves are ``MeetingNoteItem`` rows. Written again in
    place (a better model, a fixed transcript); a pass that fails keeps the
    items it had, with why."""

    __tablename__ = "meeting_notes"

    meeting_id: int = Field(
        foreign_key="meeting.id", primary_key=True, ondelete="CASCADE"
    )
    error: str | None = Field(default=None, max_length=500)
    model_name: str | None = Field(default=None, max_length=255)
    written_at: datetime = Field(default_factory=utcnow)


class MeetingNoteItem(SQLModel, table=True):
    """One item of a meeting's notes: its summary, a decision, an action
    item, an open question, or a thread (a commitment, a follow-up, a
    contradiction, a position). ``kind`` is the part of ``Notes`` it is in;
    the columns past ``text`` are the ones its kind has. A name the model
    gave is kept as written (``person_text``, ``to_text``) beside the
    person it was found to be, if anyone."""

    __tablename__ = "meeting_note_item"
    __table_args__ = (
        Index("ix_meeting_note_item_meeting", "meeting_id", "kind", "ord"),
        Index("ix_meeting_note_item_commitment", "commitment_id"),
    )

    id: int | None = Field(default=None, primary_key=True)
    meeting_id: int = Field(foreign_key="meeting.id", ondelete="CASCADE")
    kind: str = Field(max_length=32, description="The part of the notes it is in")
    ord: int = Field(description="Its place in its part")
    text: str = Field(sa_type=Text)
    person_id: int | None = Field(
        default=None,
        foreign_key="meeting_person.id",
        ondelete="SET NULL",
        description="Whose it is: an action's or commitment's owner, a position's speaker",
    )
    person_text: str | None = Field(
        default=None, max_length=255, description="That name as the model wrote it"
    )
    to_person_id: int | None = Field(
        default=None,
        foreign_key="meeting_person.id",
        ondelete="SET NULL",
        description="Who a commitment was made to",
    )
    to_text: str | None = Field(
        default=None, max_length=255, description="That name as the model wrote it"
    )
    due: str | None = Field(default=None, max_length=255)
    topic: str | None = Field(default=None, max_length=255)
    shifted: str | None = Field(default=None, sa_type=Text)
    status: str | None = Field(
        default=None,
        max_length=16,
        description="A follow-up's: mentioned, done, dropped",
    )
    commitment_id: int | None = Field(
        default=None,
        foreign_key="meeting_note_item.id",
        ondelete="SET NULL",
        description="The earlier commitment a follow-up raises",
    )


class MeetingNoteLine(SQLModel, table=True):
    """A transcript line a note item cites, in order; ``against``: the
    other side of a contradiction, which may be an earlier meeting's."""

    __tablename__ = "meeting_note_line"
    __table_args__ = (Index("ix_meeting_note_line_line", "line_id"),)

    item_id: int = Field(
        foreign_key="meeting_note_item.id", primary_key=True, ondelete="CASCADE"
    )
    line_id: int = Field(
        foreign_key="meeting_transcript_line.id", primary_key=True, ondelete="CASCADE"
    )
    against: bool = Field(default=False, primary_key=True)
    ord: int


class Guide(BaseModel):
    """How to work with one person, as the model reads it from what they
    said across the owner's meetings: only how they work, each point citing
    the lines it rests on."""

    cares_about: list[NoteItem] = Described(
        default_factory=list, description="What they keep coming back to"
    )
    information: list[NoteItem] = Described(
        default_factory=list,
        description=(
            "How they like their information: big picture or detail, a demo "
            "or numbers, short or thorough"
        ),
    )
    decides: list[NoteItem] = Described(
        default_factory=list,
        description=(
            "How they decide and commit: a quick yes, needs to see it first, "
            "defers to someone, says they will and does or does not"
        ),
    )
    lands: list[NoteItem] = Described(
        default_factory=list,
        description="What lands with them and what gets pushback",
    )

    def points(self) -> list[NoteItem]:
        """Every point, part by part."""
        return [item for key in GUIDE_SECTIONS for item in getattr(self, key)]


# Each part of a guide, in the order the pages show them, with its heading.
GUIDE_SECTIONS = {
    "cares_about": "What they care about",
    "information": "How they like their information",
    "decides": "How they decide and commit",
    "lands": "What lands with them",
}


class PersonGuide(SQLModel, table=True):
    """How to work with one person, or why the model could not write it:
    its points are ``MeetingGuidePoint`` rows. Written again as meetings
    accrue; the owner's own note on them is kept across every rewrite, and
    a rewrite that fails keeps the points it had."""

    __tablename__ = "meeting_person_guide"

    id: int | None = Field(default=None, primary_key=True)
    person_id: int = Field(
        foreign_key="meeting_person.id", unique=True, ondelete="CASCADE"
    )
    error: str | None = Field(default=None, max_length=500)
    model_name: str | None = Field(default=None, max_length=255)
    meetings: int = Field(default=0, description="How many meetings it was read from")
    note: str | None = Field(
        default=None, max_length=2000, description="The owner's own note on them"
    )
    written_at: datetime = Field(default_factory=utcnow)


class MeetingGuidePoint(SQLModel, table=True):
    """One point of a guide, in its part (``section``, a ``Guide`` field)."""

    __tablename__ = "meeting_guide_point"
    __table_args__ = (
        Index("ix_meeting_guide_point_guide", "guide_id", "section", "ord"),
    )

    id: int | None = Field(default=None, primary_key=True)
    guide_id: int = Field(foreign_key="meeting_person_guide.id", ondelete="CASCADE")
    section: str = Field(max_length=32)
    ord: int
    text: str = Field(sa_type=Text)


class MeetingGuidePointLine(SQLModel, table=True):
    """A transcript line a guide's point rests on, in order."""

    __tablename__ = "meeting_guide_point_line"
    __table_args__ = (Index("ix_meeting_guide_point_line_line", "line_id"),)

    point_id: int = Field(
        foreign_key="meeting_guide_point.id", primary_key=True, ondelete="CASCADE"
    )
    line_id: int = Field(
        foreign_key="meeting_transcript_line.id", primary_key=True, ondelete="CASCADE"
    )
    ord: int


class Theme(NoteItem):
    """Something a series of meetings keeps coming back to: an ask made
    again, a blocker that keeps returning, a worry nobody resolves, with
    every line it was said in (across the meetings)."""

    status: Literal["open", "answered", "done"] = Described(
        default="open",
        description="Answered or done by the latest meeting, else still open",
    )


class SeriesNotes(BaseModel):
    """What a series of meetings said over time, as the model writes it:
    a headline, what it keeps coming back to, and the run told a short
    point at a time, each citing the lines it rests on."""

    summary: str = Described(
        description="One sentence, at most 25 words: where the series stands now"
    )
    themes: list[Theme] = Described(
        default_factory=list,
        description=(
            "Each thing raised in more than one meeting, citing every line it"
            " was said in"
        ),
    )
    settled: list[NoteItem] = Described(
        default_factory=list,
        description="At most 5 things decided or done, a few words each",
    )
    shifted: list[NoteItem] = Described(
        default_factory=list,
        description=(
            "At most 5 positions or priorities that changed, a few words each"
            " as 'from → to'"
        ),
    )
    still_open: list[NoteItem] = Described(
        default_factory=list,
        description="At most 5 things still unresolved, a few words each",
    )
    mood: list[NoteItem] = Described(
        default_factory=list,
        description="How the room feels about the work, a few words each",
    )


# What the run is told in (``SeriesNotes``' parts past the themes), with
# its heading: one card each.
OVER_TIME = {
    "settled": "Settled",
    "shifted": "Shifted",
    "still_open": "Still open",
    "mood": "Mood",
}


class MeetingSeries(SQLModel, table=True):
    """An owner's meetings on one link: a recurring meeting keeps its link
    every time (``domains.series``). What they said over time and what
    they keep coming back to (``MeetingTheme``), one model pass over their
    notes, written again as each meeting joins it; or why the last pass
    could not be."""

    __tablename__ = "meeting_series"
    __table_args__ = (Index("ix_meeting_series_link", "link"),)

    id: int | None = Field(default=None, primary_key=True)
    owner_user_id: int | None = Field(
        default=None,
        foreign_key=_OWNER_FK,
        ondelete="CASCADE",
        description="Whose meetings they are; NULL on a project without auth",
    )
    link: str = Field(
        max_length=2048, description="The meeting link without what follows it"
    )
    name: str = Field(
        default="", max_length=255, description="Its calendar event's title, if any"
