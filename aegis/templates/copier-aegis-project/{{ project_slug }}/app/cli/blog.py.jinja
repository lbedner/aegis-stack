"""
Blog service CLI commands.

Read commands inspect posts and tags. State-transition commands publish,
archive, or delete a post by slug. Tag CRUD lets operators seed and curate
taxonomy from scripts. Authoring (post body editing) stays in the dashboard.
"""

import asyncio

import typer

from app.cli import theme
from app.cli.blog_posts import (
    _archive,
    _delete,
    _post_show,
    _posts,
    _publish,
    _status,
)
from app.cli.blog_shared import (
    _ex,
)
from app.cli.blog_tags import _tag_create, _tag_delete, _tag_update, _tags
from app.cli.blog_transfer import _export, _import
from app.i18n import lazy_t, t
from app.services.blog.constants import ImportConflictPolicy

BLOG_EPILOG = _ex(
    "{{ project_slug }} blog status",
    "{{ project_slug }} blog posts --status draft --limit 10",
    "{{ project_slug }} blog post my-first-post",
    "{{ project_slug }} blog publish my-first-post",
    '{{ project_slug }} blog tag-create "Release Notes"',
)

app = typer.Typer(help=lazy_t("blog.help"), epilog=BLOG_EPILOG)
console = theme.console()


# Read commands


@app.command(
    help=lazy_t("blog.help_status"),
    epilog=_ex("{{ project_slug }} blog status"),
)
def status() -> None:
    """Show blog post counts and latest activity.

    Examples:

        {{ project_slug }} blog status
    """
    asyncio.run(_status())


@app.command(
    help=lazy_t("blog.help_posts"),
    epilog=_ex(
        "{{ project_slug }} blog posts",
        "{{ project_slug }} blog posts --status draft",
        "{{ project_slug }} blog posts --tag release-notes --limit 50",
    ),
)
def posts(
    status_filter: str | None = typer.Option(
        None, "--status", "-s", help=lazy_t("blog.opt_status")
    ),
    tag: str | None = typer.Option(None, "--tag", "-t", help=lazy_t("blog.opt_tag")),
    limit: int = typer.Option(20, "--limit", "-n", help=lazy_t("blog.opt_limit")),
) -> None:
    """List blog posts with optional status and tag filters.

    Examples:

        {{ project_slug }} blog posts
        {{ project_slug }} blog posts --status draft
        {{ project_slug }} blog posts --tag release-notes --limit 50
    """
    asyncio.run(_posts(status_filter, tag, limit))


@app.command(
    name="post",
    help=lazy_t("blog.help_post"),
    epilog=_ex("{{ project_slug }} blog post my-first-post"),
)
def post_show(
    slug: str = typer.Argument(..., help=lazy_t("blog.arg_slug")),
) -> None:
    """Show a single post's metadata (not the full body, use the editor).

    Examples:

        {{ project_slug }} blog post my-first-post
    """
    asyncio.run(_post_show(slug))


@app.command(
    help=lazy_t("blog.help_tags"),
    epilog=_ex("{{ project_slug }} blog tags"),
)
def tags() -> None:
    """List all blog tags.

    Examples:

        {{ project_slug }} blog tags
    """
    asyncio.run(_tags())


# State transitions


@app.command(
    help=lazy_t("blog.help_publish"),
    epilog=_ex("{{ project_slug }} blog publish my-first-post"),
)
def publish(
    slug: str = typer.Argument(..., help=lazy_t("blog.arg_slug")),
) -> None:
    """Publish a draft or archived post.

    Examples:

        {{ project_slug }} blog publish my-first-post
    """
    asyncio.run(_publish(slug))


@app.command(
    help=lazy_t("blog.help_archive"),
    epilog=_ex("{{ project_slug }} blog archive my-old-post"),
)
def archive(
    slug: str = typer.Argument(..., help=lazy_t("blog.arg_slug")),
) -> None:
    """Archive a post (hides it from the public site).

    Examples:

        {{ project_slug }} blog archive my-old-post
    """
    asyncio.run(_archive(slug))


@app.command(
    help=lazy_t("blog.help_delete"),
    epilog=_ex(
        "{{ project_slug }} blog delete obsolete-post",
        "{{ project_slug }} blog delete obsolete-post --yes",
    ),
)
def delete(
    slug: str = typer.Argument(..., help=lazy_t("blog.arg_slug")),
    yes: bool = typer.Option(False, "--yes", "-y", help=lazy_t("blog.opt_yes")),
) -> None:
    """Permanently delete a post and its tag links.

    Examples:

        {{ project_slug }} blog delete obsolete-post --yes
    """
    asyncio.run(_delete(slug, yes))


# Tag CRUD


@app.command(
    name="tag-create",
    help=lazy_t("blog.help_tag_create"),
    epilog=_ex(
        '{{ project_slug }} blog tag-create "Release Notes"',
        '{{ project_slug }} blog tag-create "Release Notes" --slug releases',
    ),
)
def tag_create(
    name: str = typer.Argument(..., help=lazy_t("blog.arg_tag_name")),
    slug: str | None = typer.Option(None, "--slug", help=lazy_t("blog.opt_tag_slug")),
) -> None:
    """Create a new tag.

    Examples:

        {{ project_slug }} blog tag-create "Release Notes"
        {{ project_slug }} blog tag-create "Release Notes" --slug releases
    """
    asyncio.run(_tag_create(name, slug))


@app.command(
    name="tag-update",
    help=lazy_t("blog.help_tag_update"),
    epilog=_ex(
        '{{ project_slug }} blog tag-update releases --name "Product Releases"',
        "{{ project_slug }} blog tag-update releases --new-slug release-notes",
    ),
)
def tag_update(
    slug: str = typer.Argument(..., help=lazy_t("blog.arg_tag_slug")),
    name: str | None = typer.Option(
        None, "--name", help=lazy_t("blog.opt_tag_new_name")
    ),
    new_slug: str | None = typer.Option(
        None, "--new-slug", help=lazy_t("blog.opt_tag_new_slug")
    ),
) -> None:
    """Rename a tag or change its slug.

    Examples:

        {{ project_slug }} blog tag-update releases --name "Product Releases"
        {{ project_slug }} blog tag-update releases --new-slug release-notes
    """
    if name is None and new_slug is None:
        console.print(
            f"[{theme.ERROR}]{t('blog.tag_update_no_changes')}[/{theme.ERROR}]"
        )
        raise typer.Exit(2)
    asyncio.run(_tag_update(slug, name, new_slug))


@app.command(
    name="tag-delete",
    help=lazy_t("blog.help_tag_delete"),
    epilog=_ex(
        "{{ project_slug }} blog tag-delete obsolete",
        "{{ project_slug }} blog tag-delete obsolete --yes",
    ),
)
def tag_delete(
    slug: str = typer.Argument(..., help=lazy_t("blog.arg_tag_slug")),
    yes: bool = typer.Option(False, "--yes", "-y", help=lazy_t("blog.opt_yes")),
) -> None:
    """Delete a tag and remove it from all posts.

    Examples:

        {{ project_slug }} blog tag-delete obsolete --yes
    """
    asyncio.run(_tag_delete(slug, yes))


# Export / Import


@app.command(
    help=lazy_t("blog.help_export"),
    epilog=_ex(
        "{{ project_slug }} blog export ./out",
        "{{ project_slug }} blog export ./out --status published",
        "{{ project_slug }} blog export blog.json --format json",
    ),
)
def export(
    path: str = typer.Argument(..., help=lazy_t("blog.arg_export_path")),
    fmt: str = typer.Option(
        "markdown", "--format", "-f", help=lazy_t("blog.opt_format")
    ),
    status_filter: str | None = typer.Option(
        None, "--status", "-s", help=lazy_t("blog.opt_status")
    ),
) -> None:
    """Export posts to markdown files or a JSON document."""
    asyncio.run(_export(path, fmt, status_filter))


@app.command(
    name="import",
    help=lazy_t("blog.help_import"),
    epilog=_ex(
        "{{ project_slug }} blog import ./posts",
        "{{ project_slug }} blog import backup.zip",
        "{{ project_slug }} blog import blog.json --on-conflict overwrite",
    ),
)
def import_(
    path: str = typer.Argument(..., help=lazy_t("blog.arg_import_path")),
    on_conflict: ImportConflictPolicy = typer.Option(
        ImportConflictPolicy.SKIP,
        "--on-conflict",
        help=lazy_t("blog.opt_on_conflict"),
    ),
) -> None:
    """Import posts from a markdown file/dir, a zip archive, or a JSON document."""
    asyncio.run(_import(path, on_conflict))
