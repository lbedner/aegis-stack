"""``/api/v1/ai/evals``: start a run as a job, read kept runs and their
cases, compare two runs; read the datasets, have the model write one,
import one from YAML and export it back, delete one. Admins only, since
each turn reads as one."""

from collections.abc import AsyncIterator
from typing import Any

from fastapi import HTTPException
from fastapi.testclient import TestClient
import pytest
from sqlmodel.ext.asyncio.session import AsyncSession

from app.components.backend.api.ai import evals as evals_api
from app.services.ai.domains.evals import datasets
from app.services.shared.deps import get_admin_actor, get_admin_reader
from tests._audit import as_admin
from tests.services.ai.evals import _kept as kept
from tests.services.ai.evals._mini import DATASET, only_mini

BASE = "/api/v1/ai/evals"


@pytest.fixture(autouse=True)
def admin(async_client_with_db: TestClient) -> TestClient:
    return as_admin(async_client_with_db)


def test_anyone_else_is_refused(
    async_client_with_db: TestClient, two_runs: tuple[int, int]
) -> None:
    def refused() -> None:
        raise HTTPException(status_code=403)

    overrides = async_client_with_db.app.dependency_overrides
    overrides[get_admin_actor] = overrides[get_admin_reader] = refused
    before, after = two_runs
    started = async_client_with_db.post(f"{BASE}/runs", json={"dataset": "mini"})
    written = async_client_with_db.post(
        f"{BASE}/datasets", json={"name": "ops", "about": "Reads what it is given."}
    )
    imported = async_client_with_db.post(
        f"{BASE}/datasets/import", json={"name": "ops", "text": DATASET}
    )
    reads = [
        f"{BASE}/datasets",
        f"{BASE}/datasets/starter",
        f"{BASE}/datasets/starter/yaml",
        f"{BASE}/runs",
        f"{BASE}/runs/{before}",
        f"{BASE}/runs/{after}/cases/reads the paper",
        f"{BASE}/compare?a={before}&b={after}",
    ]
    assert started.status_code == written.status_code == imported.status_code == 403
    assert [async_client_with_db.get(url).status_code for url in reads] == [403] * 7


@pytest.fixture
async def mini(async_db_session: AsyncSession) -> None:
    """``mini`` is the one dataset the routes read."""
    await datasets.add(async_db_session, "mini", DATASET)


@pytest.fixture
async def mini_kept(monkeypatch: pytest.MonkeyPatch) -> AsyncIterator[None]:
    """``mini`` in the app's own database, where a new dataset is checked
    before its job starts."""
    async with only_mini(monkeypatch):
        yield


@pytest.fixture
async def two_runs(async_db_session: AsyncSession) -> tuple[int, int]:
    return await kept.two_runs(async_db_session)


def test_a_run_is_started_as_a_job(
    async_client_with_db: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    started: list[tuple[Any, ...]] = []

    async def start_evals(name: str, *, model: str | None, note: str | None) -> str:
        started.append((name, model, note))
        return "job-1"

    monkeypatch.setattr(evals_api, "start_evals", start_evals)

    response = async_client_with_db.post(
        f"{BASE}/runs", json={"dataset": "starter", "note": "nightly"}
    )

    assert response.status_code == 202, response.text
    assert response.json() == {"job_id": "job-1"}
    assert started == [("starter", None, "nightly")]


def test_a_model_that_cannot_answer_is_refused(
    async_client_with_db: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    async def start_evals(name: str, *, model: str | None, note: str | None) -> str:
        raise ValueError(f"'{model}' is a tts model, not a chat model.")

    monkeypatch.setattr(evals_api, "start_evals", start_evals)

    response = async_client_with_db.post(
        f"{BASE}/runs", json={"dataset": "starter", "model": "tts-1"}
    )

    assert response.status_code == 422
    assert "not a chat model" in response.json()["detail"]


def test_a_dataset_is_written_as_a_job(
    async_client_with_db: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    asked: list[dict[str, Any]] = []

    async def start(name: str, **kwargs: Any) -> str:
        asked.append({"name": name, **kwargs})
        return "job-1"

    monkeypatch.setattr(evals_api, "start_generate_evals", start)

    response = async_client_with_db.post(
        f"{BASE}/datasets", json={"name": "ops", "about": "Reads.", "like": "starter"}
    )

    assert response.status_code == 202, response.text
    assert response.json() == {"job_id": "job-1"}
    assert asked == [{"name": "ops", "about": "Reads.", "cases": 5, "like": "starter"}]


@pytest.mark.parametrize(
    ("body", "status"),
    [
        ({"name": "mini", "about": "Reads what it is given."}, 422),
        ({"name": "Bad Name", "about": "Reads what it is given."}, 422),
        ({"name": "ops", "about": "Reads what it is given.", "cases": 500}, 422),
        ({"name": "ops", "about": "Reads what it is given.", "like": "nope"}, 404),
        ({"name": "ops", "about": "s"}, 422),
    ],
)
def test_a_dataset_that_cannot_be_written_is_not_started(
    async_client_with_db: TestClient, mini_kept: None, body: dict[str, Any], status: int
) -> None:
    response = async_client_with_db.post(f"{BASE}/datasets", json=body)

    assert response.status_code == status, response.text


@pytest.mark.queryspy(allow_n_plus_one=True)  # each request reads the dataset
def test_a_dataset_is_deleted_and_then_is_not_there(
    async_client_with_db: TestClient, mini: None
) -> None:
    assert async_client_with_db.delete(f"{BASE}/datasets/mini").status_code == 204
    assert async_client_with_db.get(f"{BASE}/datasets/mini").status_code == 404
    assert async_client_with_db.delete(f"{BASE}/datasets/mini").status_code == 404


@pytest.mark.queryspy(allow_n_plus_one=True)  # each request reads the dataset
def test_a_dataset_is_imported_and_exported_as_it_was_written(
    async_client_with_db: TestClient, mini: None
) -> None:
    written = "# Imported.\n" + DATASET
    url = f"{BASE}/datasets/import"

    imported = async_client_with_db.post(url, json={"name": "ops", "text": written})
    taken = async_client_with_db.post(url, json={"name": "mini", "text": written})
    replaced = async_client_with_db.post(
        url, json={"name": "mini", "text": written, "replace": True}
    )

    assert imported.status_code == replaced.status_code == 201, imported.text
    assert imported.json()["about"] == "Imported." and len(imported.json()["cases"]) == 2
    assert taken.status_code == 422 and "already exists" in taken.json()["detail"]
    exported = async_client_with_db.get(f"{BASE}/datasets/mini/yaml")
    assert exported.text == written
    assert exported.headers["content-type"].startswith("application/yaml")
    assert async_client_with_db.get(f"{BASE}/datasets/nope/yaml").status_code == 404


@pytest.mark.queryspy(allow_n_plus_one=True)  # each request reads the datasets
def test_datasets_are_listed_and_read_with_their_cases(
    async_client_with_db: TestClient, mini: None
) -> None:
    listed = async_client_with_db.get(f"{BASE}/datasets")
    assert listed.status_code == 200, listed.text
    assert [d["name"] for d in listed.json()] == ["mini"]

    read = async_client_with_db.get(f"{BASE}/datasets/mini")
    assert read.status_code == 200, read.text
    assert read.json()["cases"][0]["checks"]
    assert async_client_with_db.get(f"{BASE}/datasets/nope").status_code == 404


def test_an_unknown_dataset_is_not_started(async_client_with_db: TestClient) -> None:
    response = async_client_with_db.post(f"{BASE}/runs", json={"dataset": "nope"})

    assert response.status_code == 404
    assert "nope" in response.json()["detail"]


def test_kept_runs_are_listed_and_read_with_their_cases(
    async_client_with_db: TestClient, two_runs: tuple[int, int]
) -> None:
    before, after = two_runs

    listed = async_client_with_db.get(f"{BASE}/runs", params={"dataset": "mini"})
    run = async_client_with_db.get(f"{BASE}/runs/{before}")
    case = async_client_with_db.get(f"{BASE}/runs/{after}/cases/reads the paper")

    assert [r["id"] for r in listed.json()] == [after, before]
    by_model = async_client_with_db.get(f"{BASE}/runs", params={"model": "gpt-test"})
    assert [r["id"] for r in by_model.json()] == [before]
    assert run.json()["run"]["note"] == "baseline"
    assert {c["name"] for c in run.json()["cases"]} == {"reads the paper", "never deletes"}
    assert case.json()["case"]["passed"] is False
    assert [s["evaluator"] for s in case.json()["scores"]] == ["ToolCalls"]


def test_a_missing_run_or_case_is_a_404(
    async_client_with_db: TestClient, two_runs: tuple[int, int]
) -> None:
    before, _ = two_runs

    assert async_client_with_db.get(f"{BASE}/runs/999").status_code == 404
    assert async_client_with_db.get(f"{BASE}/runs/{before}/cases/nope").status_code == 404


def test_compare_names_the_flipped_case(
    async_client_with_db: TestClient, two_runs: tuple[int, int]
) -> None:
    before, after = two_runs

    response = async_client_with_db.get(f"{BASE}/compare", params={"a": before, "b": after})

    assert response.status_code == 200, response.text
    [flipped] = response.json()["flipped"]
    assert (flipped["name"], flipped["change"]) == ("reads the paper", "flipped")
    assert (flipped["before"]["passed"], flipped["after"]["passed"]) == (True, False)
    assert flipped["after"]["output"] == "I could not find it."
