def test_every_run_is_listed_newest_first(
    client: TestClient, two_runs: tuple[int, int]
) -> None:
    before, after = two_runs
    found = table_rows(page_html(client, f"{PAGE}?tab=runs"), "#ai-evals-runs table")

    assert [text(r["Run"]) for r in found] == [str(after), str(before)]
    newest = found[0]
    assert text(newest["Passed"]) == "1 / 2"
    assert text(newest["Model"]) == "gpt-other" and text(newest["Build"]) == "def456"
    assert one(newest["Run"], "a").get("href").endswith(f"?run={after}")


def test_runs_are_filtered_by_dataset_and_model(
    client: TestClient, two_runs: tuple[int, int]
) -> None:
    before, _ = two_runs
