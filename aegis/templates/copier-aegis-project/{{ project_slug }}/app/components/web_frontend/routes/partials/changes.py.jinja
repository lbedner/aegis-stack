{% if include_finance or (include_ai and ai_backend != "memory") %}"""Approval cards (#1368): the change queue as htmx fragments.

A card renders the stored queue row through ``change_queue.card`` (the same
builder the JSON routes in ``api/changes.py`` use), so what the user
approves is what runs. Approving or rejecting swaps the card for its new
state. Everything is scoped to the signed-in user by ``get_owner_user_id``:
another user's card is a 404, never a card.
"""

from collections.abc import Awaitable, Callable
from typing import Any

from fastapi import APIRouter, Depends, HTTPException, Request
from fastapi.responses import HTMLResponse, Response
from sqlmodel.ext.asyncio.session import AsyncSession

from app.components.web_frontend.rendering import templates
from app.core.chat_transcript import CARD_STATUS
from app.core.db import get_async_db
from app.core.log import logger
from app.services import change_queue
from app.services.change_queue import PendingChange
from app.services.shared.deps import get_owner_user_id

PATH = "/partials/changes"
router = APIRouter(prefix=PATH)


def change_url(change_id: int | str) -> str:
    return f"{PATH}/{change_id}"


def batch_url(batch_id: str) -> str:
    return f"{PATH}/batch/{batch_id}"


def card_url(marker: dict[str, Any]) -> str | None:
    """Where the card a trace marker names is served, or None."""
    if marker.get("kind") == "pending_change" and marker.get("pending_change_id"):
        return change_url(marker["pending_change_id"])
    if marker.get("kind") == "pending_change_batch" and marker.get("batch_id"):
        return batch_url(marker["batch_id"])
    return None


async def _view(db: AsyncSession, row: PendingChange) -> dict[str, Any]:
    """One row as its card shows it."""
    card = await change_queue.card(db, row)
    label, tone = CARD_STATUS[change_queue.outcome_of(row)]
    return card.model_dump() | {
        "display": [(line.label, line.value) for line in card.display],
        "label": label,
        "tone": tone,
        "url": change_url(card.id),
    }


async def _batch_view(
    db: AsyncSession, batch_id: str, rows: list[PendingChange]
) -> dict[str, Any]:
    """One batch as its card shows it: every row, one decision."""
    views = [await _view(db, row) for row in rows]
    return {
        "batch_id": batch_id,
        "url": batch_url(batch_id),
        "title": views[0]["title"],
        "rows": views,
        "pending": any(v["status"] == "pending" for v in views),
    }


async def _row(db: AsyncSession, change_id: int, owner: int | None) -> PendingChange:
    row = await change_queue.get_change(db, change_id, owner_user_id=owner)
    if row is None:
        raise HTTPException(status_code=404)
    return row


async def _batch(db: AsyncSession, batch_id: str, owner: int | None) -> dict[str, Any]:
    rows = await change_queue.batch_rows(db, batch_id, owner_user_id=owner)
    if not rows:
        raise HTTPException(status_code=404)
    return await _batch_view(db, batch_id, rows)


def _render(card: str, view: dict[str, Any]) -> HTMLResponse:
    """One card macro (``change_card``, ``batch_card``) as the response."""
    macros = templates.env.get_template("components/macros/changes.html").module
    return HTMLResponse(str(getattr(macros, card)(view)))


async def _resolve(
    db: AsyncSession,
    change_id: int,
    owner: int | None,
    action: Callable[..., Awaitable[Any]],
) -> Response:
    """Approve or reject, then show the card as it now stands. Another
    user's card is still a 404; one already resolved shows as it is; a
    failed run stays on the card as its error, recorded like the JSON
    route records it."""
    try:
        await action(db, change_id, owner_user_id=owner)
    except ValueError:
        pass  # not this user's, already resolved, or the run's own error
    except Exception:
        logger.exception(f"Resolving pending change {change_id} failed")
    await db.commit()
    return _render("change_card", await _view(db, await _row(db, change_id, owner)))


@router.get("", response_class=HTMLResponse)
async def review(
    request: Request,
    db: AsyncSession = Depends(get_async_db),
    owner: int | None = Depends(get_owner_user_id),
) -> Response:
    """Every card still waiting for this user, a batch as one card (every
    batch read in one query)."""
    rows = await change_queue.list_changes(db, owner_user_id=owner, status="pending")
    ids = [*{row.batch_id for row in rows if row.batch_id}]
    batches: dict[str, list[PendingChange]] = {}
    if ids:
        batched = await change_queue.list_changes(
            db, owner_user_id=owner, status=None, batch_ids=ids
        )
        for row in reversed(batched):  # a batch reads in proposal order
            batches.setdefault(str(row.batch_id), []).append(row)
    cards: list[dict[str, Any]] = []
    for row in rows:
        if row.batch_id is None:
            cards.append(await _view(db, row))
        elif row.batch_id in batches:
            cards.append(await _batch_view(db, row.batch_id, batches.pop(row.batch_id)))
    return templates.TemplateResponse(
        request, "partials/changes/review.html", {"cards": cards}
    )


@router.get("/{change_id}", response_class=HTMLResponse)
async def show(
    change_id: int,
    db: AsyncSession = Depends(get_async_db),
    owner: int | None = Depends(get_owner_user_id),
) -> Response:
    return _render("change_card", await _view(db, await _row(db, change_id, owner)))


@router.post("/{change_id}/approve", response_class=HTMLResponse)
async def approve(
    change_id: int,
    db: AsyncSession = Depends(get_async_db),
    owner: int | None = Depends(get_owner_user_id),
) -> Response:
    return await _resolve(db, change_id, owner, change_queue.approve)


@router.post("/{change_id}/reject", response_class=HTMLResponse)
async def reject(
    change_id: int,
    db: AsyncSession = Depends(get_async_db),
    owner: int | None = Depends(get_owner_user_id),
) -> Response:
    return await _resolve(db, change_id, owner, change_queue.reject)


@router.get("/batch/{batch_id}", response_class=HTMLResponse)
async def show_batch(
    batch_id: str,
    db: AsyncSession = Depends(get_async_db),
    owner: int | None = Depends(get_owner_user_id),
) -> Response:
    return _render("batch_card", await _batch(db, batch_id, owner))


@router.post("/batch/{batch_id}/approve", response_class=HTMLResponse)
async def approve_batch(
    request: Request,
    batch_id: str,
    db: AsyncSession = Depends(get_async_db),
    owner: int | None = Depends(get_owner_user_id),
) -> Response:
    """Approve the batch's waiting rows, rejecting the ones ticked to skip.
    Another user's batch resolves nothing and is a 404."""
    form = await request.form()
    skipped = [int(v) for v in form.getlist("exclude_ids") if str(v).isdigit()]
    await change_queue.approve_batch(
        db, batch_id, owner_user_id=owner, exclude_ids=skipped
    )
    await db.commit()
    return _render("batch_card", await _batch(db, batch_id, owner))


@router.post("/batch/{batch_id}/reject", response_class=HTMLResponse)
async def reject_batch(
    batch_id: str,
    db: AsyncSession = Depends(get_async_db),
    owner: int | None = Depends(get_owner_user_id),
) -> Response:
    await change_queue.reject_batch(db, batch_id, owner_user_id=owner)
    await db.commit()
    return _render("batch_card", await _batch(db, batch_id, owner))
{% endif %}
