from typing import Any
{%- if ai_framework == "pydantic-ai" %}
from typing import NamedTuple

from pydantic_ai.messages import (
    FunctionToolCallEvent,
    FunctionToolResultEvent,
    PartStartEvent,
    ThinkingPart,
    ToolCallPart,
    ToolReturnPart,
)
{%- endif %}

from app.core import steps
{%- if ai_framework == "pydantic-ai" %}
