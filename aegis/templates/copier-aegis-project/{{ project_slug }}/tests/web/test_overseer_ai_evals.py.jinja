def test_the_section_is_three_tabs_datasets_first(client: TestClient) -> None:
    tabs = select(page_html(client, PAGE), "#ai-evals-tabs a")

    assert [text(t) for t in tabs] == ["Datasets", "Runs", "Compare"]
    assert tabs[0].get("aria-current") == "page"
    assert tabs[1].get("href").endswith("?tab=runs")


def test_each_dataset_is_one_row_with_its_last_run(
    client: TestClient, two_runs: tuple[int, int]
) -> None:
    (row,) = table_rows(page_html(client, PAGE), "#ai-evals-datasets table")

    assert text(row["Dataset"]) == "mini"
    assert one(row["Dataset"], "a").get("href").endswith("?dataset=mini")
    assert text(row["Checks"]) == "Reads what it is given."
    assert text(row["Cases"]) == "1" and text(row["Last run"]) == "1 / 2"


