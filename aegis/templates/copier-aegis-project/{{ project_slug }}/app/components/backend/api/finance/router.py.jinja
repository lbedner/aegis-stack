    if session is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND, detail="Connection not found"
        )
    hosted_link_url, link_token = session
    return HostedLinkResponse(hosted_link_url=hosted_link_url, link_token=link_token)
