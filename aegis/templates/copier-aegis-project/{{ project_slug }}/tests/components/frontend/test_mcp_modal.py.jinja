{% if include_mcp %}"""The MCP card and modal in Flet: the same served tools, connect commands
and client activity as the htmx page (``ui_mcp``)."""

from typing import Any
from unittest.mock import MagicMock

import pytest

from app.components.frontend.dashboard.cards.mcp_card import McpCard
from app.components.frontend.dashboard.modals.mcp_modal import (
    McpDetailDialog,
    McpSection,
)
from app.core.config import settings
from app.core.tools import load_tools, register_tool
from app.services.system.models import ComponentStatus, ComponentStatusType
from tests.components.frontend._tree import rendered, walk

MCP = ComponentStatus(
    name="mcp",
    status=ComponentStatusType.HEALTHY,
    message="1 tool served",
    metadata={"served": 1, "dropped": 1},
)


async def lookup(order_id: str) -> dict[str, Any]:
    """Look up an order by id."""
    return {"order_id": order_id}


async def save(note: str) -> str:
    """Save a note."""
    return note


@pytest.fixture
def loaded() -> None:
    load_tools()


@pytest.fixture(autouse=True)
def granted(
    loaded: None, clean_registry: None, monkeypatch: pytest.MonkeyPatch
) -> None:
    register_tool("lookup", lookup, effect="read")
    register_tool("save", save, effect="writes")
    monkeypatch.setattr(settings, "MCP_TOOLS", ["lookup", "save"])


def test_the_card_counts_what_is_served() -> None:
    shown = rendered(McpCard(MCP).build())

    assert "MCP" in shown
    assert "Served" in shown and "1" in shown


async def test_the_modal_shows_the_grant_and_how_to_connect() -> None:
    section = McpSection()
    await section.load()
    shown = rendered(section)

    assert "lookup" in shown
    assert "Writes are never served" in shown
    assert f"{settings.PROJECT_NAME} mcp" in shown


def test_the_dialog_holds_the_section() -> None:
    dialog = McpDetailDialog(MCP, MagicMock())

    assert any(isinstance(node, McpSection) for node in walk(dialog))
{%- if include_auth %}


TOKEN = {
    "id": 7,
    "name": "laptop",
    "scope": "read",
    "hint": "mcp_abcd",
    "created_at": "2026-10-05T09:30:00Z",
    "last_used_at": None,
}


class FakeAPI:
    def __init__(self) -> None:
        self.calls: list[tuple[str, str, Any]] = []

    async def request_with_status(
        self, method: str, endpoint: str, json: dict[str, Any] | None = None
    ) -> tuple[int, Any]:
        self.calls.append((method, endpoint, json))
        if method == "GET":
            return 200, [TOKEN]
        if method == "POST":
            return 201, {**TOKEN, **(json or {}), "token": "mcp_the-value-shown-once"}
        return 204, None


@pytest.fixture
def api(monkeypatch: pytest.MonkeyPatch) -> FakeAPI:
    from types import SimpleNamespace

    from app.components.frontend.dashboard.modals import mcp_tokens

    fake = FakeAPI()
    monkeypatch.setattr(
        mcp_tokens, "get_session_state", lambda page: SimpleNamespace(api_client=fake)
    )
    return fake


async def _tokens() -> Any:
    from app.components.frontend.dashboard.modals.mcp_tokens import McpTokensSection
    from tests.components.frontend._fakes import FakePage

    page = FakePage()
    page.open = lambda control: None  # type: ignore[attr-defined]  # snack bars
    section = McpTokensSection(page)  # type: ignore[arg-type]
    await section.load()
    return section


async def test_tokens_list_without_their_values(api: FakeAPI) -> None:
    shown = rendered(await _tokens())

    assert "laptop" in shown and "mcp_abcd..." in shown


async def test_a_new_token_is_shown_once(api: FakeAPI) -> None:
    section = await _tokens()

    await section.make("ci", "propose")

    assert ("POST", "/api/v1/mcp/tokens", {"name": "ci", "scope": "propose"}) in api.calls
    assert "mcp_the-value-shown-once" in rendered(section)
    await section.load()
    assert "mcp_the-value-shown-once" not in rendered(section)


async def test_revoking_calls_the_api(api: FakeAPI) -> None:
    section = await _tokens()

    await section.revoke(7)

    assert ("DELETE", "/api/v1/mcp/tokens/7", None) in api.calls


async def test_the_modal_holds_the_tokens(api: FakeAPI) -> None:
    from app.components.frontend.dashboard.modals.mcp_tokens import McpTokensSection

    dialog = McpDetailDialog(MCP, MagicMock())

    assert any(isinstance(node, McpTokensSection) for node in walk(dialog))
