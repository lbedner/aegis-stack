# keyed vendors differ only here; ``_create_keyed_llm`` builds all of them.
_KEYED_CHAT_MODELS: dict[AIProvider, tuple[str, str, str, str]] = {
    AIProvider.OPENAI: ("langchain_openai", "ChatOpenAI", "gpt-4o-mini", "api_key"),
    AIProvider.ANTHROPIC: (
        "langchain_anthropic",
        "ChatAnthropic",
        "claude-3-5-sonnet-20241022",
        "api_key",
    ),
    AIProvider.GOOGLE: (
        "langchain_google_genai",
        "ChatGoogleGenerativeAI",
        "gemini-1.5-flash",
        "google_api_key",
    ),
    AIProvider.GROQ: ("langchain_groq", "ChatGroq", "llama-3.1-70b-versatile", "api_key"),
    AIProvider.MISTRAL: (
        "langchain_mistralai",
        "ChatMistralAI",
        "mistral-large-latest",
        "api_key",
    ),
    AIProvider.COHERE: ("langchain_cohere", "ChatCohere", "command-r-plus", "cohere_api_key"),
}


def get_llm(config: AIServiceConfig, settings: Any):
    """
    Create a LangChain chat model for the configured provider.

    Args:
        config: AI service configuration
        settings: Application settings for API keys

    Returns:
        BaseChatModel: Configured LangChain chat model

    Raises:
        ProviderError: If model creation fails
    """
    try:
        provider = config.provider

        if provider in _KEYED_CHAT_MODELS:
            return _create_keyed_llm(config, settings)
        if provider == AIProvider.OLLAMA:
            return _create_ollama_llm(config, settings)
        if provider == AIProvider.PUBLIC:
            return _create_public_llm(config)
        if provider == AIProvider.POLLINATIONS:
            return _create_pollinations_llm(config)
        raise ProviderError(f"Unsupported provider: {provider}")

    except ImportError as e:
        error_msg = f"Missing LangChain package for {config.provider}: {e}"
        logger.error(error_msg)
        raise ProviderError(error_msg) from e
    except Exception as e:
        error_msg = f"Failed to create LLM for {config.provider}: {e}"
        logger.error(error_msg)
        raise ProviderError(error_msg) from e


def _create_keyed_llm(config: AIServiceConfig, settings: Any):
    """A vendor's LangChain chat model, from the table above and the
    configured key."""
    import importlib

    module_name, class_name, default_model, key_kwarg = _KEYED_CHAT_MODELS[
        config.provider
    ]
    chat_model = getattr(importlib.import_module(module_name), class_name)
    return chat_model(
        model=config.model or default_model,
        temperature=config.temperature,
        max_tokens=config.max_tokens,
        timeout=config.timeout_seconds,
        **{key_kwarg: require_api_key(config, settings)},
    )


def _create_ollama_llm(config: AIServiceConfig, settings: Any):
    """Create Ollama chat model using OpenAI-compatible endpoint."""
    from langchain_openai import ChatOpenAI

    # Get Ollama base URL from settings (effective URL for
    # Docker/local auto-detection)
    base_url = settings.ollama_base_url_effective

    return ChatOpenAI(
        model=config.model or "llama3.2",
        temperature=config.temperature,
        max_tokens=config.max_tokens,
        api_key="ollama",  # Ollama doesn't require auth but client needs something
        base_url=f"{base_url}/v1",
        timeout=config.timeout_seconds,
    )


def _create_public_llm(config: AIServiceConfig):
    """Create LLM using the LLM7.io public endpoint (free account key)."""
    from langchain_openai import ChatOpenAI

    from .public_provider import (
        LLM7_BASE_URL,
        public_api_key,
        resolve_public_model,
    )

    model_name = resolve_public_model(config.model)

    return ChatOpenAI(
        model=model_name,
        temperature=config.temperature,
        max_tokens=config.max_tokens,
        api_key=public_api_key(),
        base_url=LLM7_BASE_URL,
        timeout=config.timeout_seconds,
    )


def _create_pollinations_llm(config: AIServiceConfig):
    """Create LLM using the Pollinations endpoint (keyless anonymous tier)."""
    from langchain_openai import ChatOpenAI

    from .pollinations_provider import (
        POLLINATIONS_BASE_URL,
        anonymous_async_http_client,
        anonymous_sync_http_client,
        pollinations_api_key,
        resolve_pollinations_model,
    )

    model_name = resolve_pollinations_model(config.model)
    api_key = pollinations_api_key()

    if api_key:
        return ChatOpenAI(
            model=model_name,
            temperature=config.temperature,
            max_tokens=config.max_tokens,
            api_key=api_key,
            base_url=POLLINATIONS_BASE_URL,
            timeout=config.timeout_seconds,
        )

    # Anonymous tier: Pollinations rejects ANY Authorization header, so
    # both transports strip the SDK's required placeholder.
    return ChatOpenAI(
        model=model_name,
        temperature=config.temperature,
        max_tokens=config.max_tokens,
        api_key="unused",
        base_url=POLLINATIONS_BASE_URL,
        timeout=config.timeout_seconds,
        http_client=anonymous_sync_http_client(),
        http_async_client=anonymous_async_http_client(),
    )


def validate_provider_support(provider: AIProvider) -> bool:
    """Check if a provider is supported."""
    return provider in SUPPORTED_PROVIDERS


def model_for(config: AIServiceConfig, settings: Any) -> tuple[Any, str]:
    """The LangChain chat model for ``config``, plus the model name it
    resolved to - the same shape the pydantic-ai branch returns, so
    headless callers (``active_model.model_for_active``) need no
    framework branch of their own."""
    return get_llm(config, settings), config.model
