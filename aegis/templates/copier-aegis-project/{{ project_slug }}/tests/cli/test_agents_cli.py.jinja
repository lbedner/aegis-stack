class TestATestTurnIsAChatTurn:
    """A bare model call on the prompt alone tested another agent: none of
    its tools, memory or code mode. The test turn is a chat turn, in a
    conversation of its own, deleted after."""

    async def test_it_runs_the_agent_the_way_chat_does(
        self, monkeypatch: pytest.MonkeyPatch
    ) -> None:
        from types import SimpleNamespace
        from typing import Any

        from app.cli import agents as agents_cli
        from app.services.ai.domains.chat import agent_loader
        import app.services.ai.service as ai_service_module

        config = agent_loader.default_agent_config()
        asked: dict[str, Any] = {}
        deleted: list[str] = []

        async def delete(conversation_id: str) -> bool:
            deleted.append(conversation_id)
            return True

        class _Service:
            def __init__(self, settings: Any) -> None:
                self.conversation_manager = SimpleNamespace(delete_conversation=delete)

            async def chat(self, message: str, **kwargs: Any) -> Any:
                asked.update(kwargs, message=message)
                return SimpleNamespace(
                    content="PONG", metadata={"conversation_id": "c1"}
                )

        async def resolve(*_: Any) -> Any:
            return config

        monkeypatch.setattr(agent_loader, "resolve_agent", resolve)
        monkeypatch.setattr(ai_service_module, "AIService", _Service)

        found, reply = await agents_cli._run_test_turn("assistant", "ping")

        assert (found, reply) == (config, "PONG")
        assert (asked["message"], asked["agent_slug"]) == ("ping", "assistant")
        assert deleted == ["c1"]


class TestAgentsPrompt:
    """One way to change a prompt, and it says why."""

    @patch("app.cli.agents._set_prompt")
    def test_set_from_a_file_records_the_note(self, mock_set, tmp_path) -> None:
        prompt = tmp_path / "prompt.md"
        prompt.write_text("Be terse.")

        result = invoke(
            [
                "agents",
                "prompt",
                "set",
                "helper",
                "--file",
                str(prompt),
                "--note",
                "too chatty",
            ],
        )

        assert result.exit_code == 0, result.output
        mock_set.assert_called_once_with("helper", "Be terse.", "too chatty")

    @patch("app.cli.agents._set_prompt")
    @patch("app.cli.agents._load_history")
    def test_set_to_an_earlier_version_reverts(self, mock_history, mock_set) -> None:
        mock_history.return_value = [
            AgentPromptChange(id=2, agent_id=1, system_prompt="Be kind.", source="cli"),
            AgentPromptChange(
                id=1, agent_id=1, system_prompt="Be terse.", source="seed"
            ),
        ]

        result = invoke(
            ["agents", "prompt", "set", "helper", "--version", "1", "--note", "back"],
        )

        assert result.exit_code == 0, result.output
        mock_set.assert_called_once_with("helper", "Be terse.", "back")

    @patch("app.cli.agents._set_prompt")
    def test_set_needs_a_file_or_a_version(self, mock_set) -> None:
        result = invoke(["agents", "prompt", "set", "helper", "--note", "x"])

        assert result.exit_code == 1
        mock_set.assert_not_called()

    @patch("app.cli.agents._load_history")
    def test_history_lists_each_change(self, mock_history) -> None:
        mock_history.return_value = [
            AgentPromptChange(
                id=2, agent_id=1, system_prompt="Be kind.", source="cli", note="warmer"
            ),
            AgentPromptChange(
                id=1, agent_id=1, system_prompt="Be terse.", source="seed"
            ),
        ]

        result = invoke(["agents", "prompt", "history", "helper"])

        assert result.exit_code == 0, result.output
        assert "warmer" in result.output
        assert "seed" in result.output


