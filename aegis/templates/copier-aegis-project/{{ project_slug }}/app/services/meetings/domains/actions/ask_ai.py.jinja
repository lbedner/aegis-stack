"""Ask Illiana: she answers a moment herself (Overseer's own agent: her
prompt, model and tools, the system's ontology among them), from the
meeting so far, in a conversation of the meetings' own (``SURFACE``, kept
out of her chat's list). Runs in the app; metered as her turns are. A
question put to her by name (``addressed``) is answered unasked. In a
call with her live voice (``actions.live``), the answer to a line put to
her by name is made through it, heard in the call as she makes it. Asked
of any line (``about``), she says what its speaker is talking about
(``actions.about``)."""

from typing import Any
from weakref import WeakKeyDictionary

from app.core.log import logger
from app.services.meetings.domains.actions.live import IN_A_MEETING, LIVE
from app.services.meetings.domains.actions.prompt import (
    Excerpt,
    Said,
    said_before,
    the_question,
    turns,
)
from app.services.meetings.domains.actions.registry import (
    ANSWERS,
    QUESTIONS,
    SURFACE,
    Action,
    register_action,
)
from app.services.meetings.models import LineAbout

# What closes each question put to her: how she answers it is the meeting's
# (``IN_A_MEETING``: her live call's manners, else what leads a chat turn).
SAY_IT = "Answer it out loud, as one of the people in the meeting."


def for_the_model(heard: Excerpt) -> str:
    """The excerpt as she reads it: the meeting so far, the moment, and how
    to answer it."""
    return (
        f"The meeting so far:\n{said_before(heard)}\n\n"
        f"{the_question(heard)}\n\n{SAY_IT}"
    )


# What each live call has been told of the meeting so far (its lines).
TOLD: WeakKeyDictionary[Any, set[str]] = WeakKeyDictionary()


def _since(prompt: str, told: set[str]) -> str:
    """``prompt`` (``for_the_model``) for her live call, which holds every
    question put to it and what led to each: after the first, only the
    meeting's lines it has not heard (``told``, kept up)."""
    said, _, asked = prompt.partition("\n\n")
    lines = said.splitlines()[1:]  # under "The meeting so far:"
    new = [line for line in lines if line not in told]
    first = not told
    told.update(lines)
    if first:
        return prompt
    return (
        f"Since then in the meeting:\n{chr(10).join(new) or '(nothing new)'}\n\n{asked}"
    )


def her() -> Any:
    """The AI service she answers through."""
    # Here, not at the top: the AI service loads every tool, the meetings'
    # among them, which reach back into the meetings service this registers
    # from; and she loads only when an answer is asked for.
    from app.core.config import settings
    from app.services.ai.service import AIService

    return AIService(settings)


async def answer(prompt: str, owner_user_id: int | None) -> str:
    """Her answer: through her live voice in the call, where there is one
    (told it is a meeting as it opened), else a turn of her own agent, as
    the meeting's owner, the meeting's manners over her prompt
    (``IN_A_MEETING``)."""
    live = LIVE.get()
    if live is not None and live.open:
        try:
            return await live.ask(_since(prompt, TOLD.setdefault(live, set())))
        except (RuntimeError, TimeoutError) as exc:
            logger.warning(f"Her live answer failed ({exc}); she answers in chat")
    return (await _her_turn(prompt, owner_user_id, IN_A_MEETING)).content


# What she is asked of a line: what its speaker is talking about.
ABOUT_IT = (
    "Say what the speaker of the line marked >>> is talking about, for "
    "someone in the meeting who asked: briefly, in a sentence or three. When "
    "it is a part of this system (a service, component, job, table, page), "
    "look it up with your tools, say what it is and does here, and draw its "
    "wiring (draw_card, kind path, with that part's node). When it is not, "
    "say what it means in the meeting. Never invent a part."
)
# Asked of a part the line names (the chip beside it): which one, by node.
ABOUT_PART = (
    "They asked what {part} is (that node, in your tools): say what it is "
    "and does here, as it bears on the line, and draw its wiring "
    "(draw_card, kind path, node {part})."
)


async def about(
    before: Said,
    line: tuple[str, int, str],
    after: Said,
    *,
    owner_user_id: int | None,
    admin: bool | None = None,
    part: str | None = None,
) -> LineAbout:
    """What ``line`` is about (``ABOUT_IT``), or the ``part`` it names (a
    node id: ``ABOUT_PART``), from what was said ``before`` and ``after``
    it: her words, and the card she drew of the part it names."""
    from app.services.ai.service import cards  # with her, loaded when asked

    asked = ABOUT_PART.format(part=part) if part else ABOUT_IT
    prompt = (
        f"The meeting around it:\n{turns(before)}\n>>> {turns([line])}\n"
        f"{turns(after)}\n\n{asked}"
    )
    said = await _her_turn(prompt, owner_user_id, admin=admin)
    trace = (said.metadata or {}).get("tool_trace", [])
    return LineAbout(summary=said.content, card_id=cards.last_drawn(trace))


async def _her_turn(
    prompt: str,
    owner_user_id: int | None,
    instructions: str | None = None,
    admin: bool | None = None,
) -> Any:
    """A turn of her own agent, as the meeting's owner (its chat ``user_id``
    theirs, else the default), in the meetings' conversations, its manners
    (``instructions``) over her prompt."""
    owner = {} if owner_user_id is None else {"user_id": str(owner_user_id)}
    return await her().chat(
        prompt,
        owner_user_id=owner_user_id,
        admin=admin,
        agent_slug=None,
        surface=SURFACE,
        instructions=instructions,
        **owner,
    )


register_action(
    Action(
        ANSWERS,
        "Ask Illiana",
        QUESTIONS,
        "app",
        run=answer,
        frame=for_the_model,
    )
)
{% endif %}
