{% if insights_per_user -%}
async def override_insights_for_active_project(
    components: dict[str, ComponentStatus],
    api_client: Any,
    page: ft.Page,
) -> None:
    """Replace the aggregate insights metadata with the active project's slice.

    Mirrors the staleness logic in ``app/services/insights/health.py``
    (3x ``collection_interval_hours``), but scoped to the rows
    returned by ``/api/v1/insights/projects/{slug}/all``. Bails out
    cleanly if no project is active, the card isn't present, or the
    request fails — the aggregate values stay as fallback.
    """
    slug = get_active_project(page)
    if not slug:
        return
    insights_key = f"{SERVICE_PREFIX}{INSIGHT_COMPONENT_NAME}"
    insights_comp = components.get(insights_key)
    if insights_comp is None:
        return

    bulk = await api_client.get(f"/api/v1/insights/projects/{slug}/all")
    if not isinstance(bulk, dict):
        return

    daily = bulk.get("daily") or {}
    events = bulk.get("events") or {}
    sources = bulk.get("sources") or []

    total_metrics = 0
    if isinstance(daily, dict):
        for rows in daily.values():
            if isinstance(rows, list):
                total_metrics += len(rows)
    if isinstance(events, dict):
        for rows in events.values():
            if isinstance(rows, list):
                total_metrics += len(rows)

    from datetime import datetime as _dt, timedelta as _td

    now = _dt.now()
    enabled_sources = 0
    stale_sources: list[str] = []
    for src in sources:
        if not isinstance(src, dict):
            continue
        if not src.get("enabled", False):
            continue
        enabled_sources += 1
        interval_hours = src.get("collection_interval_hours")
        last_raw = src.get("last_collected_at")
        key = str(src.get("key") or "")
        if interval_hours is None or not key:
            continue
        if last_raw is None:
            stale_sources.append(key)
            continue
        try:
            last = _dt.fromisoformat(str(last_raw))
        except (TypeError, ValueError):
            continue
        if now - last > _td(hours=int(interval_hours) * 3):
            stale_sources.append(key)

    if total_metrics == 0:
        status = ComponentStatusType.WARNING
        message = "No data collected yet"
    elif stale_sources:
        status = ComponentStatusType.WARNING
        message = f"Stale sources: {', '.join(stale_sources)}"
    else:
        status = ComponentStatusType.HEALTHY
        message = f"{total_metrics} metrics across {enabled_sources} sources"

    components[insights_key] = ComponentStatus(
        name=insights_comp.name,
        status=status,
        message=message,
        response_time_ms=insights_comp.response_time_ms,
        metadata={
            "total_metrics": total_metrics,
            "enabled_sources": enabled_sources,
            "stale_sources": stale_sources,
            "active_project_slug": slug,
        },
        sub_components=insights_comp.sub_components,
    )
